@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider

<style>
    /* حاوية رئيسية تأخذ كامل الشاشة وتمنع السكرول الخارجي */
    .app-wrapper {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* القائمة الجانبية */
    .sidebar {
        width: 260px;
        background: #0F172A;
        background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%);
        display: flex;
        flex-direction: column;
        height: 100vh;
        flex-shrink: 0;
        box-shadow: -4px 0 15px rgba(0,0,0,0.1);
        z-index: 1000;
        border-left: 1px solid rgba(255,255,255,0.05);
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 24px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        margin-bottom: 10px;
    }

    .sidebar-logo-icon {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 20px;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    }

    .sidebar-nav {
        flex: 1;
        padding: 10px 15px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow-y: auto;
    }

        /* تخصيص شكل السكرول بار للقائمة */
        .sidebar-nav::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-nav::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 10px;
        }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: #94A3B8;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14.5px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .nav-item i {
            font-size: 18px;
            transition: all 0.3s ease;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #E2E8F0;
            transform: translateX(-4px);
        }

            .nav-item:hover i {
                color: #8B5CF6;
            }

        .nav-item.active {
            background: linear-gradient(90deg, rgba(99, 102, 241, 0.15), transparent);
            color: white;
            border-right: 4px solid #6366F1;
            border-radius: 10px 0 0 10px;
        }

            .nav-item.active i {
                color: #818CF8;
            }

    .sidebar-footer {
        padding: 20px;
        border-top: 1px solid rgba(255,255,255,0.05);
        background: rgba(0,0,0,0.2);
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
        padding: 10px;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366F1, #A855F7);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
    }

    .btn-logout {
        width: 100%;
        background: #EF4444;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
    }

        .btn-logout:hover {
            background: #DC2626;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(239, 68, 68, 0.4);
        }

    /* المحتوى الرئيسي */
    .main-content {
        flex: 1;
        height: 100vh;
        overflow-y: auto; /* هنا نخلي السكرول خاص بالمحتوى فقط */
        background-color: #F8FAFC;
        color: #1E293B;
        position: relative;
    }

        /* تخصيص شكل السكرول بار للمحتوى */
        .main-content::-webkit-scrollbar {
            width: 8px;
        }

        .main-content::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 10px;
        }

            .main-content::-webkit-scrollbar-thumb:hover {
                background: #94A3B8;
            }

    /* للشاشات الصغيرة */
    @@media (max-width: 768px) {
        .sidebar {
            position: absolute;
            transform: translateX(100%);
            transition: transform 0.3s ease;
        }

            .sidebar.show {
                transform: translateX(0);
            }

        .main-content {
            margin-right: 0;
        }
    }
</style>

<!-- الحاوية الرئيسية اللي تمنع تداخل السكرول -->
<div class="app-wrapper">
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo-icon">🎓</div>
            <div>
                <div style="font-weight: 800; font-size: 16px; color: white; letter-spacing: 0.5px;">AI Journal</div>
                <div style="font-size: 12px; color: #94A3B8; font-weight: 600;">Matcher System</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i> لوحة التحكم
            </NavLink>
            <NavLink class="nav-item" href="/matcher">
                <i class="bi bi-cpu-fill"></i> المطابقة الذكية
            </NavLink>
            <NavLink class="nav-item" href="/manage-journals">
                <i class="bi bi-journals"></i> إدارة المجلات
            </NavLink>
            <NavLink class="nav-item" href="/manage-researchers">
                <i class="bi bi-people-fill"></i> إدارة الباحثين
            </NavLink>
            <NavLink class="nav-item" href="/settings">
                <i class="bi bi-gear-fill"></i> الإعدادات
            </NavLink>
            <NavLink class="nav-item" href="/about">
                <i class="bi bi-info-circle-fill"></i> حول النظام
            </NavLink>
        </div>

        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">Q</div>
                <div>
                    <div style="font-weight: 700; font-size: 14px; color: white;">قاسم موسى</div>
                    <div style="font-size: 12px; color: #94A3B8;">Researcher</div>
                </div>
            </div>
            <button class="btn-logout" @onclick="Logout">
                <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
            </button>
        </div>
    </div>

    <!-- المحتوى الرئيسي هنا: تم إزالة الـ padding ليأخذ المحتوى كامل المساحة -->
    <div class="main-content">
        @Body
    </div>
</div>

@code {
    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");

        if (AuthProvider is AIJOURNALMATCHERWEB.Services.CustomAuthenticationStateProvider customProvider)
        {
            customProvider.MarkUserAsLoggedOut();
        }

        Nav.NavigateTo("/login");
    }
}