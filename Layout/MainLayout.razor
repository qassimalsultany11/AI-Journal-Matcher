@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider

<div class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo-icon">🎓</div>
        <div>
            <div style="font-weight: bold; font-size: 15px; color: white;">AI Journal</div>
            <div style="font-size: 11px; color: #94A3B8;">Matcher</div>
        </div>
    </div>

    <div class="sidebar-nav">
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-grid-1x2-fill"></i> لوحة التحكم
        </NavLink>
        <NavLink class="nav-item" href="/matcher">
            <i class="bi bi-cpu-fill"></i> المطابقة الذكية
        </NavLink>
        <NavLink class="nav-item" href="/add-journal">
            <i class="bi bi-plus-circle-fill"></i> إضافة مجلة
        </NavLink>
        <NavLink class="nav-item" href="/manage-journals">
            <i class="bi bi-journals"></i> إدارة المجلات
        </NavLink>
        <NavLink class="nav-item" href="/researchers">
            <i class="bi bi-people-fill"></i> الباحثون
        </NavLink>
        <NavLink class="nav-item" href="/settings">
            <i class="bi bi-gear-fill"></i> الإعدادات
        </NavLink>
        <NavLink class="nav-item" href="/about">
            <i class="bi bi-info-circle-fill"></i> حول التطبيق
        </NavLink>
    </div>

    <div class="sidebar-footer">
        <div class="user-profile">
            <div class="user-avatar">Q</div>
            <div>
                <div style="font-weight: 600; font-size: 13px; color: white;">قاسم موسى</div>
                <div style="font-size: 11px; color: #94A3B8;">Researcher</div>
            </div>
        </div>
        <!-- الزر هنا في المكان الصحيح داخل القائمة الجانبية -->
        <button class="btn-logout" @onclick="Logout">
            <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
        </button>
    </div>
</div>

<div class="main-content" style="flex: 1; padding: 20px; background-color: #f8fafc; color: #1e293b; min-height: 100vh; overflow-y: auto;">
    @Body
</div>

@code {
    private async Task Logout()
    {
        // مسح التوكن من المتصفح
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");

        // إبلاغ النظام
        if (AuthProvider is AIJOURNALMATCHERWEB.Services.CustomAuthenticationStateProvider customProvider)
        {
            customProvider.MarkUserAsLoggedOut();
        }

        // تحويل المستخدم لصفحة الدخول
        Nav.NavigateTo("/login");
    }
}