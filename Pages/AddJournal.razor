@page "/add-journal"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsEditMode ? "تعديل مجلة" : "إضافة مجلة جديدة") | AI Journal Matcher</PageTitle>

<style>
    .add-journal-container {
        padding: 25px;
        background: #F8FAFC;
        min-height: 100vh;
        direction: rtl;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* الهيدر */
    .header-card {
        background: linear-gradient(135deg, #0EA5E9 0%, #6366F1 100%);
        border-radius: 16px;
        padding: 25px 30px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(14, 165, 233, 0.3);
    }

    .header-info h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
    }

    .header-info p {
        margin: 5px 0 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .header-user {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* الكارت الرئيسي */
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 30px;
        border: 1px solid #E2E8F0;
    }

    .section-title {
        font-size: 16px;
        font-weight: 800;
        color: #6366F1;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #EEF2FF;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-size: 13px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
    }

        .form-label .required {
            color: #EF4444;
            margin-right: 3px;
        }

    .form-control {
        padding: 12px 16px;
        border: 2px solid #E2E8F0;
        border-radius: 10px;
        font-size: 14px;
        transition: all 0.2s;
        font-family: inherit;
        background: #F8FAFC;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366F1;
            background: white;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
    }

    /* أزرار */
    .form-actions {
        margin-top: 30px;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        padding-top: 20px;
        border-top: 1px solid #E2E8F0;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-cancel {
        background: #F1F5F9;
        color: #475569;
    }

        .btn-cancel:hover {
            background: #E2E8F0;
        }

    .btn-save {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
        }

        .btn-save:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

    /* التنبيهات */
    .alert {
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 600;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-error {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
    }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        border: 1px solid #BBF7D0;
    }
</style>

<div class="add-journal-container">
    <!-- الهيدر -->
    <div class="header-card">
        <div class="header-info">
            <h1>@(IsEditMode ? "✏️ تعديل بيانات المجلة" : "➕ إضافة مجلة جديدة")</h1>
            <p>@(IsEditMode ? "قم بتحديث البيانات المطلوبة" : "أدخل بيانات المجلة الأكاديمية لإضافتها")</p>
        </div>
        <div class="header-user">
            <i class="bi bi-person-circle"></i> مرحباً، @currentUserName
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error"><i class="bi bi-exclamation-triangle-fill"></i> @errorMessage</div>
    }
    @if (showSuccess)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> تم الحفظ بنجاح! جاري التحويل...</div>
    }

    <div class="form-card">
        <!-- القسم الأول: المعلومات الأساسية -->
        <div class="section-title"><i class="bi bi-info-circle"></i> المعلومات الأساسية</div>
        <div class="form-grid">
            <div class="form-group full-width">
                <label class="form-label"><span class="required">*</span> اسم المجلة</label>
                <input type="text" class="form-control" @bind="journal.name" placeholder="مثال: Journal of Engineering..." />
            </div>
            <div class="form-group">
                <label class="form-label"><span class="required">*</span> الناشر</label>
                <input type="text" class="form-control" @bind="journal.publisher" list="publishers-list" placeholder="مثال: Elsevier" />
                <datalist id="publishers-list">
                    <option value="Elsevier"></option>
                    <option value="Springer"></option>
                    <option value="Wiley"></option>
                    <option value="IEEE"></option>
                    <option value="Taylor & Francis"></option>
                    <option value="SAGE"></option>
                    <option value="MDPI"></option>
                </datalist>
            </div>
            <div class="form-group">
                <label class="form-label"><span class="required">*</span> الدولة</label>
                <input type="text" class="form-control" @bind="journal.country" list="countries-list" placeholder="مثال: Iraq" />
                <datalist id="countries-list">
                    <option value="Iraq"></option>
                    <option value="USA"></option>
                    <option value="UK"></option>
                    <option value="Germany"></option>
                    <option value="Netherlands"></option>
                    <option value="Switzerland"></option>
                    <option value="China"></option>
                    <option value="India"></option>
                </datalist>
            </div>
            <div class="form-group full-width">
                <label class="form-label">رابط الموقع الإلكتروني</label>
                <input type="url" class="form-control" @bind="journal.website_url" placeholder="https://..." />
            </div>
        </div>

        <!-- القسم الثاني: التصنيف والنشر -->
        <div class="section-title" style="margin-top: 30px;"><i class="bi bi-bar-chart-line"></i> التصنيف والنشر</div>
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">الربع (Quartile)</label>
                <select class="form-control" @bind="journal.quartile">
                    <option value="">-- اختر --</option>
                    <option value="Q1">Q1</option>
                    <option value="Q2">Q2</option>
                    <option value="Q3">Q3</option>
                    <option value="Q4">Q4</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">معامل التأثير</label>
                <input type="number" step="0.01" min="0" class="form-control" @bind="journal.impact_factor" placeholder="مثال: 3.45" />
            </div>
            <div class="form-group">
                <label class="form-label">سرعة النشر</label>
                <input type="text" class="form-control" @bind="journal.publication_speed" list="speed-list" placeholder="مثال: 4-6 weeks" />
                <datalist id="speed-list">
                    <option value="2-4 weeks"></option>
                    <option value="4-6 weeks"></option>
                    <option value="1-2 months"></option>
                    <option value="2-3 months"></option>
                </datalist>
            </div>
            <div class="form-group">
                <label class="form-label">نسبة القبول</label>
                <input type="text" class="form-control" @bind="journal.acceptance_rate" placeholder="مثال: 15%" />
            </div>
        </div>

        <!-- القسم الثالث: التفاصيل الأكاديمية -->
        <div class="section-title" style="margin-top: 30px;"><i class="bi bi-journal-text"></i> التفاصيل الأكاديمية</div>
        <div class="form-grid">
            <div class="form-group full-width">
                <label class="form-label">نطاق المجلة (Scope)</label>
                <textarea class="form-control" @bind="journal.scope" placeholder="وصف مختصر للمواضيع..."></textarea>
            </div>
            <div class="form-group full-width">
                <label class="form-label">الكلمات المفتاحية</label>
                <input type="text" class="form-control" @bind="keywordsInput" placeholder="افصل بين الكلمات بفاصلة..." />
            </div>
        </div>

        <!-- أزرار الإجراءات -->
        <div class="form-actions">
            <button type="button" class="btn btn-cancel" @onclick='() => Nav.NavigateTo("/manage-journals")'>
                <i class="bi bi-x-lg"></i> إلغاء
            </button>
            <button type="button" class="btn btn-save" @onclick="SaveJournal" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm"></span> <span>جاري الحفظ...</span>
                }
                else
                {

                    <i class="bi bi-check2-circle"></i> <span>@(IsEditMode ? "حفظ التعديلات" : "حفظ المجلة")</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter][SupplyParameterFromQuery] public long? id { get; set; }
    private bool IsEditMode => id.HasValue;

    private bool isSaving = false;
    private bool showSuccess = false;
    private string errorMessage = "";
    private string keywordsInput = "";
    private string currentUserName = "المستخدم";

    private JournalModel journal = new();

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    protected override async Task OnInitializedAsync()
    {
        // جلب اسم المستخدم للترحيب
        try
        {
            var name = await JS.InvokeAsync<string>("localStorage.getItem", "fullName");
            if (!string.IsNullOrEmpty(name)) currentUserName = name;
        }
        catch { }

        if (IsEditMode) await LoadJournalDataAsync(id!.Value);
    }

    private async Task LoadJournalDataAsync(long journalId)
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?id=eq.{journalId}&select=*");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var journals = JsonSerializer.Deserialize<List<JournalModel>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (journals != null && journals.Count > 0)
                {
                    journal = journals[0];
                    if (journal.keywords != null && journal.keywords.Length > 0)
                        keywordsInput = string.Join(", ", journal.keywords);
                }
            }
        }
        catch (Exception ex) { errorMessage = $"خطأ: {ex.Message}"; }
    }

    private async Task SaveJournal()
    {
        errorMessage = "";
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(journal.name) || string.IsNullOrWhiteSpace(journal.publisher) || string.IsNullOrWhiteSpace(journal.country))
        {
            errorMessage = "الرجاء ملء الحقول الإجبارية (الاسم، الناشر، الدولة).";
            return;
        }

        isSaving = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(keywordsInput))
                journal.keywords = keywordsInput.Split(',').Select(k => k.Trim()).Where(k => !string.IsNullOrEmpty(k)).ToArray();
            else
                journal.keywords = Array.Empty<string>();

            if (!IsEditMode) journal.added_by = currentUserName;

            var json = JsonSerializer.Serialize(journal);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            HttpRequestMessage request;
            if (IsEditMode)
            {
                request = new HttpRequestMessage(HttpMethod.Patch, $"{supabaseUrl}/rest/v1/journals?id=eq.{id}");
            }
            else
            {
                request = new HttpRequestMessage(HttpMethod.Post, $"{supabaseUrl}/rest/v1/journals");
            }

            request.Headers.Add("Prefer", "return=minimal");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            request.Content = content;

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                showSuccess = true;
                await Task.Delay(1500);
                Nav.NavigateTo("/manage-journals");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                errorMessage = $"حدث خطأ: {err}";
            }
        }
        catch (Exception ex) { errorMessage = $"خطأ غير متوقع: {ex.Message}"; }
        finally { isSaving = false; }
    }

    public class JournalModel
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string country { get; set; } = "";
        public string quartile { get; set; } = "";
        public double? impact_factor { get; set; }
        public string acceptance_rate { get; set; } = "";
        public string publication_speed { get; set; } = "";
        public string scope { get; set; } = "";
        public string[]? keywords { get; set; }
        public string website_url { get; set; } = "";
        public string added_by { get; set; } = "";
    }
}