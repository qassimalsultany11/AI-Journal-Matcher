@page "/add-journal"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>إضافة مجلة جديدة | AI Journal Matcher</PageTitle>

<style>
    .add-journal-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #1E293B;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
        }

        .page-header p {
            color: #64748B;
            margin: 5px 0 0 0;
            font-size: 14px;
        }

    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 30px;
        border: 1px solid #F1F5F9;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #6366F1;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

        .form-label .required {
            color: #EF4444;
            margin-right: 3px;
        }

    .form-control {
        padding: 12px;
        border: 1.5px solid #E2E8F0;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.2s;
        font-family: inherit;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .form-actions {
        margin-top: 30px;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        padding-top: 20px;
        border-top: 1px solid #F1F5F9;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        border: none;
        transition: all 0.2s;
    }

    .btn-cancel {
        background: #F1F5F9;
        color: #475569;
    }

        .btn-cancel:hover {
            background: #E2E8F0;
        }

    .btn-save {
        background: #6366F1;
        color: white;
    }

        .btn-save:hover {
            background: #4F46E5;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .btn-save:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .alert {
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 600;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-error {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
    }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        border: 1px solid #BBF7D0;
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="add-journal-container">

    <div class="page-header">
        <h2>➕ إضافة مجلة جديدة</h2>
        <p>أدخل بيانات المجلة الأكاديمية لإضافتها إلى قاعدة البيانات</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
        </div>
    }

    @if (showSuccess)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> تم إضافة المجلة بنجاح! جاري تحويلك...
        </div>
    }

    <div class="form-card">

        <!-- القسم الأول: المعلومات الأساسية -->
        <div class="section-title">
            <i class="bi bi-info-circle"></i> المعلومات الأساسية
        </div>

        <div class="form-grid">
            <div class="form-group full-width">
                <label class="form-label"><span class="required">*</span> اسم المجلة</label>
                <input type="text" class="form-control" @bind="journal.name" placeholder="مثال: Journal of Engineering and Sustainable Development" />
            </div>

            <div class="form-group">
                <label class="form-label"><span class="required">*</span> الناشر (Publisher)</label>
                <input type="text" class="form-control" @bind="journal.publisher" placeholder="مثال: Elsevier" />
            </div>

            <div class="form-group">
                <label class="form-label"><span class="required">*</span> الدولة</label>
                <input type="text" class="form-control" @bind="journal.country" placeholder="مثال: Iraq" />
            </div>

            <div class="form-group full-width">
                <label class="form-label">رابط الموقع الإلكتروني (Website URL)</label>
                <input type="url" class="form-control" @bind="journal.website_url" placeholder="https://..." />
            </div>
        </div>

        <!-- القسم الثاني: التصنيف والنشر -->
        <div class="section-title" style="margin-top: 30px;">
            <i class="bi bi-bar-chart"></i> التصنيف والنشر
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">الربع (Quartile)</label>
                <select class="form-control" @bind="journal.quartile">
                    <option value="">-- اختر --</option>
                    <option value="Q1">Q1 (الربع الأول)</option>
                    <option value="Q2">Q2 (الربع الثاني)</option>
                    <option value="Q3">Q3 (الربع الثالث)</option>
                    <option value="Q4">Q4 (الربع الرابع)</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">معامل التأثير (Impact Factor)</label>
                <input type="number" step="0.01" class="form-control" @bind="journal.impact_factor" placeholder="مثال: 3.45" />
            </div>

            <div class="form-group">
                <label class="form-label">سرعة النشر (Publication Speed)</label>
                <input type="text" class="form-control" @bind="journal.publication_speed" placeholder="مثال: 4-6 weeks" />
            </div>

            <div class="form-group">
                <label class="form-label">نسبة القبول (Acceptance Rate)</label>
                <input type="text" class="form-control" @bind="journal.acceptance_rate" placeholder="مثال: 15%" />
            </div>
        </div>

        <!-- القسم الثالث: التفاصيل الأكاديمية -->
        <div class="section-title" style="margin-top: 30px;">
            <i class="bi bi-journal-text"></i> التفاصيل الأكاديمية
        </div>

        <div class="form-grid">
            <div class="form-group full-width">
                <label class="form-label">نطاق المجلة (Scope)</label>
                <textarea class="form-control" @bind="journal.scope" placeholder="وصف مختصر للمواضيع التي تغطيها المجلة..."></textarea>
            </div>

            <div class="form-group full-width">
                <label class="form-label">الكلمات المفتاحية (Keywords)</label>
                <input type="text" class="form-control" @bind="keywordsInput" placeholder="افصل بين الكلمات بفاصلة (مثال: Engineering, AI, Sustainable Development)" />
                <small style="color: #94A3B8; margin-top: 5px;">سيتم حفظها كمصفوفة في قاعدة البيانات.</small>
            </div>
        </div>

        <!-- أزرار الإجراءات -->
        <div class="form-actions">
            <button class="btn btn-cancel" @onclick='() => Nav.NavigateTo("/manage-journals")'>
                <i class="bi bi-x-lg"></i> إلغاء
            </button>
            <button class="btn btn-save" @onclick="SaveJournal" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>جاري الحفظ...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>حفظ المجلة</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private bool isSaving = false;
    private bool showSuccess = false;
    private string errorMessage = "";
    private string keywordsInput = "";

    // نموذج المجلة
    private JournalModel journal = new();

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    private async Task SaveJournal()
    {
        errorMessage = "";
        showSuccess = false;

        // التحقق من الحقول الإجبارية
        if (string.IsNullOrWhiteSpace(journal.name) ||
            string.IsNullOrWhiteSpace(journal.publisher) ||
            string.IsNullOrWhiteSpace(journal.country))
        {
            errorMessage = "الرجاء ملء الحقول الإجبارية (الاسم، الناشر، الدولة).";
            return;
        }

        isSaving = true;

        try
        {
            // تحويل النص المدخل للكلمات المفتاحية إلى مصفوفة (Array)
            if (!string.IsNullOrWhiteSpace(keywordsInput))
            {
                journal.keywords = keywordsInput.Split(',')
                    .Select(k => k.Trim())
                    .Where(k => !string.IsNullOrEmpty(k))
                    .ToArray();
            }
            else
            {
                journal.keywords = Array.Empty<string>();
            }

            // إضافة اسم المستخدم الذي أضاف المجلة (يمكنك تعديله لاحقاً ليجلب من الجلسة)
            journal.added_by = "قاسم موسى";

            var json = JsonSerializer.Serialize(journal);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            // إرسال البيانات إلى Supabase
            var request = new HttpRequestMessage(HttpMethod.Post, $"{supabaseUrl}/rest/v1/journals");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            request.Headers.Add("Prefer", "return=minimal");
            request.Content = content;

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                showSuccess = true;
                // الانتظار ثانية ونصف ثم العودة لصفحة الإدارة
                await Task.Delay(1500);
                Nav.NavigateTo("/manage-journals");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                errorMessage = $"حدث خطأ أثناء الحفظ: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ غير متوقع: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // كلاس يمثل بنية جدول journals في Supabase
    public class JournalModel
    {
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string country { get; set; } = "";
        public string quartile { get; set; } = "";
        public double? impact_factor { get; set; }
        public string acceptance_rate { get; set; } = "";
        public string publication_speed { get; set; } = "";
        public string scope { get; set; } = "";
        public string[]? keywords { get; set; }
        public string website_url { get; set; } = "";
        public string added_by { get; set; } = "";
    }
}