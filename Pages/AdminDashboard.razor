@page "/admin"
@using System.Text.Json
@using System.Text
@using ClosedXML.Excel
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>لوحة تحكم المطور | AI Journal Matcher</PageTitle>

<style>
    .progress-container {
        margin-top: 25px;
        background: #F8FAFC;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #E2E8F0;
        position: relative;
        overflow: hidden;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
        font-weight: bold;
        color: #1E293B;
    }

    .progress-bar-bg {
        width: 100%;
        height: 12px;
        background: #E2E8F0;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #10B981, #34D399, #10B981);
        background-size: 200% 100%;
        border-radius: 10px;
        transition: width 0.3s ease;
        animation: gradientMove 2s linear infinite;
    }

    @@keyframes gradientMove {
        0% {
            background-position: 100% 0;
        }

        100% {
            background-position: -100% 0;
        }
    }

    .journal-ticker {
        margin-top: 15px;
        font-size: 13px;
        color: #64748B;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #FFFFFF;
        padding: 10px 15px;
        border-radius: 8px;
        border: 1px dashed #CBD5E1;
    }

        .journal-ticker i {
            color: #10B981;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    .journal-name-text {
        font-weight: bold;
        color: #1E293B;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .limit-input-group {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        background: #F8FAFC;
        padding: 15px;
        border-radius: 10px;
        border: 1px solid #E2E8F0;
    }

    .limit-input {
        width: 120px;
        padding: 10px;
        border: 2px solid #CBD5E1;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
        text-align: center;
        color: #1E293B;
    }

        .limit-input:focus {
            outline: none;
            border-color: #6366F1;
        }

    .extend-dropdown {
        position: relative;
        display: inline-block;
    }

    .extend-menu {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        z-index: 1;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #E2E8F0;
        top: 100%;
        right: 0;
    }

    .extend-dropdown:hover .extend-menu {
        display: block;
    }

    .extend-menu button {
        color: black;
        padding: 10px 16px;
        text-decoration: none;
        display: block;
        width: 100%;
        text-align: right;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
    }

        .extend-menu button:hover {
            background-color: #F1F5F9;
        }

    .start-btn {
        background: #10B981;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

        .start-btn:hover {
            background: #059669;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(16, 185, 129, 0.4);
        }

        .start-btn:disabled {
            background: #CBD5E1;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    /* ستايلات الإحصائيات الجديدة */
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .stat-info h4 {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        color: #1E293B;
    }

    .stat-info p {
        margin: 0;
        font-size: 13px;
        color: #64748B;
        font-weight: 600;
    }

    .chart-container {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #E2E8F0;
        height: 350px;
        position: relative;
    }
</style>

<!-- شاشة تحميل -->
@if (!isAuthorized)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column;">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"><span class="visually-hidden">جاري التحميل...</span></div>
        <p style="margin-top: 15px; color: #64748B; font-weight: bold;">جاري التحقق من الصلاحيات...</p>
    </div>
}
else
{
    <div style="padding: 30px; direction: rtl;">
        <!-- الهيدر -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <div>
                <h1 style="color: #1E293B; font-weight: 800; margin: 0;">لوحة تحكم المطور 🛡️</h1>
                <p style="margin: 5px 0 0 0; color: #64748B; font-size: 14px;">إدارة كاملة للنظام والصلاحيات والإعدادات</p>
            </div>
            <span style="color: #64748B; font-size: 14px; background: #F1F5F9; padding: 8px 15px; border-radius: 8px;">مرحباً بك، @currentUserName</span>
        </div>

        <!-- التابات -->
        <div style="display: flex; gap: 10px; margin-bottom: 25px; border-bottom: 2px solid #E2E8F0; padding-bottom: 10px; overflow-x: auto;">
            <button style="background: @(activeTab == "pending" ? "#6366F1" : "transparent"); color: @(activeTab == "pending" ? "white" : "#64748B"); border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap;" @onclick='() => activeTab = "pending"'>
                <i class="bi bi-person-plus"></i> طلبات الانضمام (@pendingAdmins.Count)
            </button>
            <button style="background: @(activeTab == "users" ? "#6366F1" : "transparent"); color: @(activeTab == "users" ? "white" : "#64748B"); border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap;" @onclick='() => activeTab = "users"'>
                <i class="bi bi-people"></i> إدارة الصلاحيات
            </button>
            <button style="background: @(activeTab == "import" ? "#6366F1" : "transparent"); color: @(activeTab == "import" ? "white" : "#64748B"); border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap;" @onclick='() => activeTab = "import"'>
                <i class="bi bi-file-earmark-excel"></i> استيراد مجلات Scopus
            </button>
            <!-- التاب الجديد للإحصائيات -->
            <button style="background: @(activeTab == "stats" ? "#6366F1" : "transparent"); color: @(activeTab == "stats" ? "white" : "#64748B"); border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap;" @onclick="LoadStatsTab">
                <i class="bi bi-graph-up-arrow"></i> إحصائيات المطابقة
            </button>

            @if (currentUserRole == "developer")
            {
                <button style="background: @(activeTab == "settings" ? "#6366F1" : "transparent"); color: @(activeTab == "settings" ? "white" : "#64748B"); border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap;" @onclick='() => activeTab = "settings"'>
                    <i class="bi bi-gear-fill"></i> إعدادات الواتساب
                </button>
            }
        </div>

        <!-- التاب 1: طلبات الانضمام -->
        @if (activeTab == "pending")
        {
            <div style="background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #E2E8F0;">
                <h2 style="font-size: 18px; color: #1E293B; margin-bottom: 20px; border-right: 4px solid #6366F1; padding-right: 10px;">طلبات الانضمام الجديدة</h2>
                @if (pendingAdmins.Count == 0)
                {
                    <div style="text-align: center; padding: 50px 20px;">
                        <i class="bi bi-inbox" style="font-size: 50px; color: #CBD5E1;"></i>
                        <p style="color: #64748B; margin-top: 15px; font-weight: 600;">لا توجد طلبات معلقة حالياً.</p>
                    </div>
                }
                else
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #E2E8F0; text-align: right;">
                                <th style="padding: 12px; color: #64748B; font-size: 13px;">الاسم الكامل</th>
                                <th style="padding: 12px; color: #64748B; font-size: 13px;">البريد الإلكتروني</th>
                                <th style="padding: 12px; color: #64748B; font-size: 13px;">الجامعة</th>
                                <th style="padding: 12px; color: #64748B; font-size: 13px;">الصلاحية المطلوبة</th>
                                <th style="padding: 12px; color: #64748B; font-size: 13px;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in pendingAdmins)
                            {
                                <tr style="border-bottom: 1px solid #F1F5F9;">
                                    <td style="padding: 15px; font-weight: 600; color: #1E293B;">@u.full_name</td>
                                    <td style="padding: 15px; color: #334155;">@u.email</td>
                                    <td style="padding: 15px; color: #64748B;">@u.university</td>
                                    <td style="padding: 15px;">
                                        <span style="background: @(u.role == "admin" ? "#FEF3C7" : "#EEF2FF"); color: @(u.role == "admin" ? "#D97706" : "#6366F1"); padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;">
                                            @(u.role == "admin" ? "مدير نظام" : "باحث")
                                        </span>
                                    </td>
                                    <td style="padding: 15px; display: flex; gap: 8px;">
                                        <button style="background: #10B981; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 12px;" @onclick="() => ApproveAdmin(u.id, u.role)">موافقة ✓</button>
                                        <button style="background: #EF4444; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 12px;" @onclick="() => RejectAdmin(u.id)">رفض ✗</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        <!-- التاب 2: إدارة المستخدمين -->
        @if (activeTab == "users")
        {
            <div style="background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #E2E8F0;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;">
                    <h2 style="font-size: 18px; color: #1E293B; margin: 0; border-right: 4px solid #6366F1; padding-right: 10px;">إدارة جميع الحسابات</h2>
                    <div style="position: relative;">
                        <i class="bi bi-search" style="position: absolute; left: 12px; top: 12px; color: #94A3B8;"></i>
                        <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="ابحث بالاسم أو البريد..." style="padding: 10px 15px 10px 40px; border: 1px solid #CBD5E1; border-radius: 8px; width: 300px; font-size: 14px;" />
                    </div>
                </div>
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #E2E8F0; text-align: right;">
                            <th style="padding: 12px; color: #64748B; font-size: 13px;">الاسم</th>
                            <th style="padding: 12px; color: #64748B; font-size: 13px;">البريد</th>
                            <th style="padding: 12px; color: #64748B; font-size: 13px;">الصلاحية</th>
                            <th style="padding: 12px; color: #64748B; font-size: 13px;">الحالة</th>
                            <th style="padding: 12px; color: #64748B; font-size: 13px;">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in FilteredUsers())
                        {
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 15px; font-weight: 600; color: #1E293B;">@u.full_name</td>
                                <td style="padding: 15px; color: #334155;">@u.email</td>
                                <td style="padding: 15px;">
                                    <span style="background: @(u.role == "developer" ? "#F3E8FF" : (u.role == "admin" ? "#EEF2FF" : "#F1F5F9")); color: @(u.role == "developer" ? "#9333EA" : (u.role == "admin" ? "#6366F1" : "#475569")); padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;">
                                        @(u.role == "developer" ? "مطور نظام" : (u.role == "admin" ? "مدير نظام" : "باحث"))
                                    </span>
                                </td>
                                <td style="padding: 15px;">
                                    @if (u.is_suspended)
                                    {
                                        <span style="background: #F3F4F6; color: #6B7280; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; display: inline-flex; align-items: center; gap: 5px;"><i class="bi bi-lock-fill"></i> موقوف</span>
                                    }
                                    else if (u.is_rejected)
                                    {
                                        <span style="background: #FEF2F2; color: #DC2626; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; display: inline-flex; align-items: center; gap: 5px;"><i class="bi bi-x-circle-fill"></i> مرفوض</span>
                                    }
                                    else if (u.is_approved)
                                    {
                                        <span style="background: #DCFCE7; color: #166534; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; display: inline-flex; align-items: center; gap: 5px;"><i class="bi bi-check-circle-fill"></i> مؤكد</span>
                                    }
                                    else
                                    {
                                        <span style="background: #FEF3C7; color: #D97706; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; display: inline-flex; align-items: center; gap: 5px;"><i class="bi bi-hourglass-split"></i> قيد الانتظار</span>
                                    }
                                </td>
                                <td style="padding: 15px;">
                                    @if (u.id == currentUserId)
                                    {
                                        <span style="color: #94A3B8; font-size: 12px;">(أنت) لا يمكنك تعديل حسابك</span>
                                    }
                                    else if (u.role == "developer")
                                    {
                                        <span style="color: #94A3B8; font-size: 12px;">لا يمكن تعديل حساب المطور</span>
                                    }
                                    else if (u.is_suspended)
                                    {
                                        <div style="display: flex; gap: 8px;">
                                            <button style="background: #10B981; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;" @onclick="() => ToggleSuspend(u.id, false)">تفعيل الحساب</button>
                                        </div>
                                    }
                                    else if (u.is_rejected)
                                    {
                                        <div style="display: flex; gap: 8px;">
                                            <button style="background: #10B981; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;" @onclick="() => ApproveAdmin(u.id, u.role)">تفعيل</button>
                                        </div>
                                    }
                                    else if (u.is_approved)
                                    {
                                        <div style="display: flex; gap: 8px; align-items: center;">
                                            <button style="background: #6366F1; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;" @onclick='() => ChangeRole(u.id, "admin")'>ترقية إلى مدير</button>
                                            <button style="background: #EF4444; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;" @onclick="() => ToggleSuspend(u.id, true)">إيقاف الحساب</button>
                                            <div class="extend-dropdown">
                                                <button style="background: #F59E0B; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;">تمديد الصلاحية <i class="bi bi-caret-down-fill"></i></button>
                                                <div class="extend-menu">
                                                    <button @onclick="() => ExtendValidity(u.id, 1)">شهر واحد</button>
                                                    <button @onclick="() => ExtendValidity(u.id, 2)">شهرين</button>
                                                    <button @onclick="() => ExtendValidity(u.id, 3)">3 أشهر</button>
                                                    <button @onclick="() => ExtendValidity(u.id, 6)">6 أشهر</button>
                                                    <button @onclick="() => ExtendValidity(u.id, 12)">سنة</button>
                                                    <button @onclick="() => ExtendValidity(u.id, 24)">سنتين</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display: flex; gap: 8px;">
                                            <button style="background: #10B981; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;" @onclick="() => ApproveAdmin(u.id, u.role)">موافقة</button>
                                            <button style="background: #EF4444; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;" @onclick="() => RejectAdmin(u.id)">رفض</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- التاب 3: استيراد سكوبس -->
        @if (activeTab == "import")
        {
            <div style="background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #E2E8F0;">
                <div style="border-right: 4px solid #10B981; padding-right: 10px; margin-bottom: 25px;">
                    <h2 style="font-size: 18px; color: #1E293B; margin: 0;">استيراد مجلات Scopus</h2>
                    <p style="color: #64748B; margin-top: 5px; font-size: 13px;">قم برفع ملف الإكسل، وحدد عدد المجلات، ثم ابدأ المزامنة يدوياً.</p>
                </div>

                @if (string.IsNullOrEmpty(currentFileName) && !isImporting)
                {
                    <div style="border: 2px dashed #10B981; border-radius: 16px; padding: 50px 20px; text-align: center; background: #F0FDF4;">
                        <div style="background: white; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);">
                            <i class="bi bi-file-earmark-excel" style="font-size: 40px; color: #10B981;"></i>
                        </div>
                        <h3 style="color: #1E293B; font-weight: 700; margin-bottom: 10px;">اسحب وأفلت ملف الإكسل هنا</h3>
                        <div style="position: relative; display: inline-block;">
                            <button style="background: #10B981; color: white; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px;">
                                <i class="bi bi-folder2-open"></i> اختر ملفاً من جهازك
                            </button>
                            <InputFile OnChange="HandleFileSelected" accept=".xlsx, .xls" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(currentFileName) && !isImporting)
                {
                    <div style="background: #F8FAFC; border-radius: 12px; padding: 20px; border: 1px solid #E2E8F0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                            <h3 style="margin: 0; font-size: 16px; color: #1E293B;"><i class="bi bi-file-earmark-check" style="color: #10B981;"></i> تم تحميل الملف: @currentFileName</h3>
                            <button style="background: #EF4444; color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px;" @onclick="ResetImport">إلغاء</button>
                        </div>

                        <div class="limit-input-group">
                            <label style="font-weight: bold; color: #1E293B;">عدد المجلات المطلوب إدخالها من هذا الملف:</label>
                            <input type="number" class="limit-input" @bind="maxJournalsToImport" min="1" max="100000" />
                            <span style="color: #64748B; font-size: 13px;">(الحد الأقصى: @totalRowsInFile مجلة)</span>
                        </div>

                        <h4 style="font-size: 14px; color: #334155; margin-bottom: 10px;">معاينة أول 5 مجلات:</h4>
                        <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden;">
                            <thead>
                                <tr style="background: #F1F5F9; text-align: right;">
                                    <th style="padding: 10px; font-size: 12px; color: #64748B;">اسم المجلة</th>
                                    <th style="padding: 10px; font-size: 12px; color: #64748B;">الناشر</th>
                                    <th style="padding: 10px; font-size: 12px; color: #64748B;">الربع</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in previewJournals)
                                {
                                    <tr style="border-bottom: 1px solid #F1F5F9;">
                                        <td style="padding: 10px; font-size: 13px;">@j.Name</td>
                                        <td style="padding: 10px; font-size: 13px;">@j.Publisher</td>
                                        <td style="padding: 10px; font-size: 13px;">@j.Quartile</td>
