    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (!await VerifyAdminBeforeAction()) { importMessage = "غير مصرح لك بهذا الإجراء."; return; }

        importMessage = "";
        var file = e.File;
        currentFileName = file.Name;
        previewJournals.Clear();
        allParsedJournals.Clear();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 62914560);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheet(1);

            int colName = -1, colPublisher = -1, colCountry = -1, colQuartile = -1, colImpact = -1, colUrl = -1, colScope = -1;
            var headerRow = worksheet.Row(1);
            foreach (var cell in headerRow.CellsUsed())
            {
                var header = cell.GetString().Trim().ToLower();
                if (header.Contains("source title") || header == "title") colName = cell.Address.ColumnNumber;
                else if (header == "publisher") colPublisher = cell.Address.ColumnNumber;
                else if (header == "country") colCountry = cell.Address.ColumnNumber;
                else if (header.Contains("quartile")) colQuartile = cell.Address.ColumnNumber;
                else if (header.Contains("citescore") || header.Contains("impact factor")) colImpact = cell.Address.ColumnNumber;
                else if (header == "link" || header == "url" || header.Contains("website")) colUrl = cell.Address.ColumnNumber;
                else if (header.Contains("coverage") || header.Contains("subject area")) colScope = cell.Address.ColumnNumber;
            }

            if (colName == -1) { importMessage = "خطأ: لم يتم العثور على عمود اسم المجلة (Source Title)."; currentFileName = ""; return; }

            totalRowsInFile = worksheet.RowsUsed().Count() - 1;

            foreach (var row in worksheet.RowsUsed().Skip(1).Take(5))
            {
                var journalName = row.Cell(colName).GetString().Trim();
                if (string.IsNullOrWhiteSpace(journalName)) continue;

                previewJournals.Add(new PreviewJournal
                {
                    Name = journalName,
                    Publisher = colPublisher != -1 ? row.Cell(colPublisher).GetString().Trim() : "N/A",
                    Quartile = colQuartile != -1 ? row.Cell(colQuartile).GetString().Trim().Split(' ')[0] : "N/A"
                });
            }

            foreach (var row in worksheet.RowsUsed().Skip(1))
            {
                var journalName = row.Cell(colName).GetString().Trim();
                if (string.IsNullOrWhiteSpace(journalName)) continue;

                var publisher = colPublisher != -1 ? row.Cell(colPublisher).GetString().Trim() : null;
                var country = colCountry != -1 ? row.Cell(colCountry).GetString().Trim() : null;
                var quartileRaw = colQuartile != -1 ? row.Cell(colQuartile).GetString().Trim() : "";
                var quartile = quartileRaw.Split(' ')[0];

                decimal? impactFactor = null;
                if (colImpact != -1) { var impactStr = row.Cell(colImpact).GetString().Trim(); if (decimal.TryParse(impactStr, out var parsedIf)) impactFactor = parsedIf; }
                var websiteUrl = colUrl != -1 ? row.Cell(colUrl).GetString().Trim() : null;
                var scope = colScope != -1 ? row.Cell(colScope).GetString().Trim() : null;

                allParsedJournals.Add(new JournalData
                {
                    Name = journalName,
                    Publisher = publisher,
                    Country = country,
                    Quartile = quartile,
                    ImpactFactor = impactFactor,
                    WebsiteUrl = websiteUrl,
                    Scope = scope
                });
            }

            importMessage = $"تم تحميل الملف بنجاح! يحتوي على {totalRowsInFile} مجلة. يرجى تحديد العدد والضغط على 'بدء المزامنة'.";
        }
        catch (Exception ex) { importMessage = $"حدث خطأ أثناء قراءة الملف: {ex.Message}"; currentFileName = ""; }
    }

    private async Task StartImport()
    {
        if (!await VerifyAdminBeforeAction()) { importMessage = "غير مصرح لك بهذا الإجراء."; return; }

        if (allParsedJournals.Count == 0) { importMessage = "لا توجد بيانات للاستيراد."; return; }

        isImporting = true;
        progressPercentage = 0;
        importMessage = "";
        importCts = new CancellationTokenSource();
        var token = importCts.Token;

        try
        {
            int rowsToProcess = maxJournalsToImport > 0 ? Math.Min(maxJournalsToImport, allParsedJournals.Count) : allParsedJournals.Count;
            int processedRows = 0;
            int count = 0;
            var journalsToInsert = new List<object>();

            foreach (var journal in allParsedJournals.Take(rowsToProcess))
            {
                if (token.IsCancellationRequested) { importMessage = "تم إيقاف العملية بناءً على طلبك."; break; }

                currentJournalName = journal.Name;

                var journalData = new
                {
                    name = journal.Name,
                    publisher = string.IsNullOrWhiteSpace(journal.Publisher) ? null : journal.Publisher,
                    country = string.IsNullOrWhiteSpace(journal.Country) ? null : journal.Country,
                    quartile = string.IsNullOrWhiteSpace(journal.Quartile) ? null : journal.Quartile,
                    impact_factor = journal.ImpactFactor,
                    website_url = string.IsNullOrWhiteSpace(journal.WebsiteUrl) ? null : journal.WebsiteUrl,
                    scope = string.IsNullOrWhiteSpace(journal.Scope) ? null : journal.Scope
                };

                journalsToInsert.Add(journalData);
                count++; processedRows++;

                if (rowsToProcess > 0) progressPercentage = (int)((processedRows * 100.0) / rowsToProcess);

                if (journalsToInsert.Count >= 100)
                {
                    await InsertJournalsBatch(journalsToInsert);
                    journalsToInsert.Clear();
                    StateHasChanged();
                    await Task.Yield();
                }
            }

            if (journalsToInsert.Count > 0 && !token.IsCancellationRequested) await InsertJournalsBatch(journalsToInsert);
            if (!token.IsCancellationRequested) { progressPercentage = 100; importMessage = $"تمت إضافة {count} مجلة بنجاح!"; }
        }
        catch (Exception ex) { importMessage = $"حدث خطأ أثناء الاستيراد: {ex.Message}"; }
        finally { isImporting = false; currentJournalName = ""; }
    }

    private void ResetImport()
    {
        currentFileName = "";
        previewJournals.Clear();
        allParsedJournals.Clear();
        totalRowsInFile = 0;
        importMessage = "";
    }

    private void CancelImport() { importCts?.Cancel(); }

    private async Task InsertJournalsBatch(List<object> batch)
    {
        var json = JsonSerializer.Serialize(batch);
        var content = new StringContent(json, Encoding.UTF8, "application/json");
        var req = new HttpRequestMessage(HttpMethod.Post, $"{supabaseUrl}/rest/v1/journals");
        req.Headers.Add("apikey", supabaseKey);
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
        req.Headers.Add("Prefer", "return=minimal");
        req.Content = content;
        var response = await Http.SendAsync(req);
        if (!response.IsSuccessStatusCode) { var err = await response.Content.ReadAsStringAsync(); throw new Exception($"فشل إدخال دفعة: {err}"); }
    }

    private async Task<bool> VerifyAdminBeforeAction()
    {
        try
        {
            var userIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (string.IsNullOrEmpty(userIdStr) || !long.TryParse(userIdStr, out var userId)) return false;

            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?id=eq.{userId}&select=role,is_approved");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            var response = await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode) return false;

            var json = await response.Content.ReadAsStringAsync();
            var users = JsonSerializer.Deserialize<List<UserData>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            return users != null && users.Count > 0 && (users[0].role == "developer" || users[0].role == "admin") && users[0].is_approved;
        }
        catch { return false; }
    }

    private async Task ApproveAdmin(long id, string currentRole)
    {
        if (!await VerifyAdminBeforeAction()) return;
        var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?id=eq.{id}&select=role");
        request.Headers.Add("apikey", supabaseKey);
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
        var response = await Http.SendAsync(request);

        var role = currentRole;
        if (response.IsSuccessStatusCode)
        {
            var json = await response.Content.ReadAsStringAsync();
            var userRole = JsonSerializer.Deserialize<List<UserData>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (userRole != null && userRole.Count > 0) role = userRole[0].role;
        }

        if (role == "admin") await UpdateUser(id, new { is_approved = true, is_rejected = false, is_suspended = false, role = "admin" });
        else await UpdateUser(id, new { is_approved = true, is_rejected = false, is_suspended = false, role = "researcher" });

        await LoadData();
    }

    private async Task RejectAdmin(long id)
    {
        if (!await VerifyAdminBeforeAction()) return;
        await UpdateUser(id, new { is_approved = false, is_rejected = true, is_suspended = false });
        await LoadData();
    }

    private async Task ChangeRole(long id, string newRole)
    {
        if (!await VerifyAdminBeforeAction()) return;
        await UpdateUser(id, new { role = newRole, is_approved = true, is_rejected = false, is_suspended = false });
        await LoadData();
    }

    private async Task ToggleSuspend(long id, bool suspend)
    {
        if (!await VerifyAdminBeforeAction()) return;
        if (suspend)
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?id=eq.{id}&select=full_name,phone");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var users = JsonSerializer.Deserialize<List<UserData>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (users != null && users.Count > 0)
                {
                    var user = users[0];
                    await SendWhatsAppSuspensionMessage(user.phone, user.full_name);
                }
            }
        }
        await UpdateUser(id, new { is_suspended = suspend });
        await LoadData();
    }

    private async Task ExtendValidity(long id, int months)
    {
        if (!await VerifyAdminBeforeAction()) return;
        DateTime newValidity = DateTime.UtcNow.AddMonths(months);
        await UpdateUser(id, new { valid_until = newValidity, is_suspended = false });
        await LoadData();
    }

    private async Task SendWhatsAppSuspensionMessage(string phoneNumber, string userName)
    {
        if (string.IsNullOrWhiteSpace(phoneNumber)) return;
        string formattedPhone = phoneNumber.Trim().Replace("+", "").Replace(" ", "");
        if (formattedPhone.StartsWith("0")) { formattedPhone = "964" + formattedPhone.Substring(1); }

        string message = $"مرحباً {userName}،\n\nنود إعلامك بأنه تم تعطيل حسابك في نظام (AI Journal Matcher) مؤقتاً.\nلإعادة تفعيل حسابك ومراجعة الأمر، يرجى التواصل مع مدير النظام:\n\n👤 السيد: قاسم موسى الزريج\n📞 واتساب: 07717212101\n\nنشكر لك تفهمك وتعاونك، ونحن هنا لخدمتك.\nإدارة النظام 🌐";
        string encodedMessage = Uri.EscapeDataString(message);

        if (string.IsNullOrEmpty(whatsappInstanceId) || string.IsNullOrEmpty(whatsappToken)) return;
        string url = $"https://api.ultramsg.com/{whatsappInstanceId}/messages/chat?token={whatsappToken}&to={formattedPhone}&body={encodedMessage}";
        try { await Http.GetAsync(url); } catch { }
    }

    private async Task UpdateUser(long id, object payload)
    {
        var json = JsonSerializer.Serialize(payload);
        var content = new StringContent(json, Encoding.UTF8, "application/json");
        var request = new HttpRequestMessage(HttpMethod.Patch, $"{supabaseUrl}/rest/v1/users?id=eq.{id}");
        request.Headers.Add("apikey", supabaseKey);
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
        request.Content = content;
        await Http.SendAsync(request);
    }

    // كلاسات مساعدة
    public class SettingData { public long id { get; set; } public string key { get; set; } = ""; public string value { get; set; } = ""; }
    public class UserData
    {
        public long id { get; set; }
        public string full_name { get; set; } = "";
        public string email { get; set; } = "";
        public string phone { get; set; } = "";
        public string role { get; set; } = "researcher";
        public string university { get; set; } = "";
        public bool is_approved { get; set; }
        public bool is_rejected { get; set; }
        public bool is_suspended { get; set; }
        public DateTime? valid_until { get; set; }
    }
    public class PreviewJournal { public string Name { get; set; } = ""; public string Publisher { get; set; } = ""; public string Quartile { get; set; } = ""; }
    public class JournalData { public string Name { get; set; } = ""; public string Publisher { get; set; } = ""; public string Country { get; set; } = ""; public string Quartile { get; set; } = ""; public decimal? ImpactFactor { get; set; } public string WebsiteUrl { get; set; } = ""; public string Scope { get; set; } = ""; }

    public class MatchSession
    {
        public long id { get; set; }
        public string user_name { get; set; } = "";
        public string abstract_text { get; set; } = "";
        public List<string> extracted_keywords { get; set; } = new();
        public List<MatchedJournalResult> matched_journals { get; set; } = new();
        public DateTime created_at { get; set; }
    }

    public class MatchedJournalResult
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public int score { get; set; }
        public string quartile { get; set; } = "";
    }
}

