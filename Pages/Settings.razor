@page "/settings"

<PageTitle>إعدادات النظام</PageTitle>

<div class="container-fluid mt-4">
    <!-- رأس الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">⚙️ إعدادات النظام</h2>
            <p class="text-muted">إدارة تفضيلات حسابك وإعدادات النظام</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveSettings">
            <i class="bi bi-check2-circle me-2"></i> حفظ التغييرات
        </button>
    </div>

    @if (showSuccessMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> تم حفظ الإعدادات بنجاح!
            <button type="button" class="btn-close" @onclick="() => showSuccessMessage = false"></button>
        </div>
    }

    <div class="row g-4">
        <!-- القائمة الجانبية للإعدادات -->
     

        <!-- محتوى الإعدادات -->
        <div class="col-md-9">
            <div class="card shadow-sm border-0 rounded-4 p-4">

                <!-- قسم الإعدادات العامة -->
                @if (activeTab == "general")
                {
                    <h5 class="fw-bold mb-4 border-bottom pb-2">الإعدادات العامة</h5>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-semibold">اسم النظام</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" @bind="systemName" placeholder="أدخل اسم النظام" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-semibold">البريد الإلكتروني للدعم</label>
                        <div class="col-sm-8">
                            <input type="email" class="form-control" @bind="supportEmail" placeholder="support@example.com" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-semibold">اللغة الافتراضية</label>
                        <div class="col-sm-8">
                            <select class="form-select" @bind="defaultLanguage">
                                <option value="ar">العربية</option>
                                <option value="en">English</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-semibold">المنطقة الزمنية</label>
                        <div class="col-sm-8">
                            <select class="form-select" @bind="timeZone">
                                <option value="baghdad">بغداد (GMT+3)</option>
                                <option value="riyadh">الرياض (GMT+3)</option>
                                <option value="cairo">القاهرة (GMT+2)</option>
                            </select>
                        </div>
                    </div>
                }

                <!-- قسم الأمان -->
                @if (activeTab == "security")
                {
                    <h5 class="fw-bold mb-4 border-bottom pb-2">الأمان والخصوصية</h5>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="twoFactor" @bind="enable2FA">
                        <label class="form-check-label fw-semibold" for="twoFactor">تفعيل المصادقة الثنائية (2FA)</label>
                        <div class="text-muted small">زيادة أمان الحساب باستخدام تطبيق المصادقة.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="loginAlerts" @bind="loginAlerts">
                        <label class="form-check-label fw-semibold" for="loginAlerts">تنبيهات تسجيل الدخول</label>
                        <div class="text-muted small">إرسال بريد إلكتروني عند تسجيل الدخول من جهاز جديد.</div>
                    </div>

                    <hr class="my-4" />
                    <h6 class="fw-bold text-danger mb-3">تغيير كلمة المرور</h6>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label">كلمة المرور الحالية</label>
                        <div class="col-sm-8">
                            <input type="password" class="form-control" placeholder="********" />
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label">كلمة المرور الجديدة</label>
                        <div class="col-sm-8">
                            <input type="password" class="form-control" placeholder="********" />
                        </div>
                    </div>
                }

                <!-- قسم الإشعارات -->
                @if (activeTab == "notifications")
                {
                    <h5 class="fw-bold mb-4 border-bottom pb-2">إعدادات الإشعارات</h5>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="emailNotif" @bind="emailNotifications">
                        <label class="form-check-label fw-semibold" for="emailNotif">إشعارات البريد الإلكتروني</label>
                        <div class="text-muted small">استلام تحديثات حول المجلات الجديدة والمطابقات.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="systemNotif" @bind="systemNotifications">
                        <label class="form-check-label fw-semibold" for="systemNotif">إشعارات النظام</label>
                        <div class="text-muted small">استلام تنبيهات حول صيانة النظام والتحديثات.</div>
                    </div>
                }

                <!-- قسم المظهر -->
                @if (activeTab == "appearance")
                {
                    <h5 class="fw-bold mb-4 border-bottom pb-2">إعدادات المظهر</h5>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">وضع العرض</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="theme" id="lightTheme" checked>
                                <label class="form-check-label" for="lightTheme">☀️ فاتح</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="theme" id="darkTheme">
                                <label class="form-check-label" for="darkTheme">🌙 داكن</label>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private string activeTab = "general";
    private bool showSuccessMessage = false;

    // متغيرات الإعدادات العامة
    private string systemName = "AI Journal Matcher";
    private string supportEmail = "support@aijournal.com";
    private string defaultLanguage = "ar";
    private string timeZone = "baghdad";

    // متغيرات الأمان
    private bool enable2FA = false;
    private bool loginAlerts = true;

    // متغيرات الإشعارات
    private bool emailNotifications = true;
    private bool systemNotifications = false;

    private void SaveSettings()
    {
        // هنا يمكنك إضافة كود حفظ الإعدادات في قاعدة البيانات (Supabase)
        showSuccessMessage = true;

        // إخفاء رسالة النجاح بعد 3 ثواني
        Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
        {
            showSuccessMessage = false;
            StateHasChanged();
        }));
    }
}