@page "/settings"

<PageTitle>إعدادات النظام | AI Journal Matcher</PageTitle>

<style>
    .settings-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #1E293B;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
        }

        .page-header p {
            color: #64748B;
            margin: 5px 0 0 0;
            font-size: 14px;
        }

    .btn-save {
        background: #6366F1;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-save:hover {
            background: #4F46E5;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        border: 1px solid #BBF7D0;
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .settings-layout {
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 30px;
    }

    /* القائمة الجانبية */
    .settings-sidebar {
        background: white;
        border-radius: 16px;
        padding: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        height: fit-content;
    }

    .tab-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 14px 16px;
        background: transparent;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        color: #64748B;
        cursor: pointer;
        transition: all 0.2s;
        text-align: right;
        margin-bottom: 5px;
    }

        .tab-btn:hover {
            background: #F8FAFC;
            color: #1E293B;
        }

        .tab-btn.active {
            background: #EEF2FF;
            color: #6366F1;
        }

        .tab-btn i {
            font-size: 18px;
        }

    /* محتوى الإعدادات */
    .settings-content {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        min-height: 500px;
    }

    .content-section h3 {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #F1F5F9;
        color: #1E293B;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1.5px solid #E2E8F0;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

    /* المفاتيح (Switches) */
    .switch-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        background: #F8FAFC;
        border-radius: 10px;
        margin-bottom: 15px;
        border: 1px solid #F1F5F9;
    }

    .switch-text h4 {
        margin: 0 0 5px 0;
        font-size: 15px;
        color: #1E293B;
    }

    .switch-text p {
        margin: 0;
        font-size: 12px;
        color: #64748B;
    }

    .toggle-switch {
        position: relative;
        width: 50px;
        height: 26px;
        appearance: none;
        background: #CBD5E1;
        border-radius: 20px;
        outline: none;
        cursor: pointer;
        transition: 0.3s;
    }

        .toggle-switch:checked {
            background: #6366F1;
        }

        .toggle-switch::before {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: white;
            top: 3px;
            right: 3px;
            transition: 0.3s;
        }

        .toggle-switch:checked::before {
            transform: translateX(-24px);
        }

    @@media (max-width: 768px) {
        .settings-layout {
            grid-template-columns: 1fr;
        }

        .settings-sidebar {
            display: flex;
            overflow-x: auto;
            gap: 10px;
            padding: 10px;
        }

        .tab-btn {
            white-space: nowrap;
            width: auto;
        }
    }
</style>

<div class="settings-container">

    <!-- رأس الصفحة -->
    <div class="page-header">
        <div>
            <h2>⚙️ إعدادات النظام</h2>
            <p>إدارة تفضيلات حسابك وإعدادات النظام</p>
        </div>
        <button class="btn-save" @onclick="SaveSettings">
            <i class="bi bi-check2-circle"></i> حفظ التغييرات
        </button>
    </div>

    <!-- رسالة النجاح -->
    @if (showSuccessMessage)
    {
        <div class="alert-success">
            <i class="bi bi-check-circle-fill"></i> تم حفظ الإعدادات بنجاح!
        </div>
    }

    <!-- تخطيط الإعدادات -->
    <div class="settings-layout">

        <!-- القائمة الجانبية (Tabs) -->
        <div class="settings-sidebar">
            <button class="tab-btn @(activeTab == "general" ? "active" : "")" @onclick='() => activeTab = "general"'>
                <i class="bi bi-gear-fill"></i> الإعدادات العامة
            </button>
            <button class="tab-btn @(activeTab == "security" ? "active" : "")" @onclick='() => activeTab = "security"'>
                <i class="bi bi-shield-lock-fill"></i> الأمان والخصوصية
            </button>
            <button class="tab-btn @(activeTab == "notifications" ? "active" : "")" @onclick='() => activeTab = "notifications"'>
                <i class="bi bi-bell-fill"></i> الإشعارات
            </button>
            <button class="tab-btn @(activeTab == "appearance" ? "active" : "")" @onclick='() => activeTab = "appearance"'>
                <i class="bi bi-palette-fill"></i> المظهر
            </button>
        </div>

        <!-- محتوى الإعدادات -->
        <div class="settings-content">

            <!-- قسم الإعدادات العامة -->
            @if (activeTab == "general")
            {
                <div class="content-section">
                    <h3>الإعدادات العامة</h3>

                    <div class="form-group">
                        <label class="form-label">اسم النظام</label>
                        <input type="text" class="form-control" @bind="systemName" placeholder="أدخل اسم النظام" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">البريد الإلكتروني للدعم</label>
                        <input type="email" class="form-control" @bind="supportEmail" placeholder="support@example.com" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">اللغة الافتراضية</label>
                        <select class="form-control" @bind="defaultLanguage">
                            <option value="ar">العربية</option>
                            <option value="en">English</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">المنطقة الزمنية</label>
                        <select class="form-control" @bind="timeZone">
                            <option value="baghdad">بغداد (GMT+3)</option>
                            <option value="riyadh">الرياض (GMT+3)</option>
                            <option value="cairo">القاهرة (GMT+2)</option>
                        </select>
                    </div>
                </div>
            }

            <!-- قسم الأمان -->
            @if (activeTab == "security")
            {
                <div class="content-section">
                    <h3>الأمان والخصوصية</h3>

                    <div class="switch-group">
                        <div class="switch-text">
                            <h4>المصادقة الثنائية (2FA)</h4>
                            <p>زيادة أمان الحساب باستخدام تطبيق المصادقة.</p>
                        </div>
                        <input type="checkbox" class="toggle-switch" @bind="enable2FA">
                    </div>

                    <div class="switch-group">
                        <div class="switch-text">
                            <h4>تنبيهات تسجيل الدخول</h4>
                            <p>إرسال بريد إلكتروني عند تسجيل الدخول من جهاز جديد.</p>
                        </div>
                        <input type="checkbox" class="toggle-switch" @bind="loginAlerts">
                    </div>

                    <hr style="border: 0; border-top: 1px solid #F1F5F9; margin: 30px 0;" />

                    <h3 style="color: #DC2626; font-size: 16px;">تغيير كلمة المرور</h3>
                    <div class="form-group">
                        <label class="form-label">كلمة المرور الحالية</label>
                        <input type="password" class="form-control" placeholder="********" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">كلمة المرور الجديدة</label>
                        <input type="password" class="form-control" placeholder="********" />
                    </div>
                </div>
            }

            <!-- قسم الإشعارات -->
            @if (activeTab == "notifications")
            {
                <div class="content-section">
                    <h3>إعدادات الإشعارات</h3>

                    <div class="switch-group">
                        <div class="switch-text">
                            <h4>إشعارات البريد الإلكتروني</h4>
                            <p>استلام تحديثات حول المجلات الجديدة والمطابقات.</p>
                        </div>
                        <input type="checkbox" class="toggle-switch" @bind="emailNotifications">
                    </div>

                    <div class="switch-group">
                        <div class="switch-text">
                            <h4>إشعارات النظام</h4>
                            <p>استلام تنبيهات حول صيانة النظام والتحديثات.</p>
                        </div>
                        <input type="checkbox" class="toggle-switch" @bind="systemNotifications">
                    </div>
                </div>
            }

            <!-- قسم المظهر -->
            @if (activeTab == "appearance")
            {
                <div class="content-section">
                    <h3>إعدادات المظهر</h3>

                    <div class="form-group">
                        <label class="form-label">وضع العرض</label>
                        <div style="display: flex; gap: 20px; margin-top: 10px;">
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="radio" name="theme" checked />
                                ☀️ فاتح
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="radio" name="theme" />
                                🌙 داكن
                            </label>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    private string activeTab = "general";
    private bool showSuccessMessage = false;

    // متغيرات الإعدادات العامة
    private string systemName = "AI Journal Matcher";
    private string supportEmail = "support@aijournal.com";
    private string defaultLanguage = "ar";
    private string timeZone = "baghdad";

    // متغيرات الأمان
    private bool enable2FA = false;
    private bool loginAlerts = true;

    // متغيرات الإشعارات
    private bool emailNotifications = true;
    private bool systemNotifications = false;

    private void SaveSettings()
    {
        showSuccessMessage = true;

        // إخفاء رسالة النجاح بعد 3 ثواني
        Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
        {
            showSuccessMessage = false;
            StateHasChanged();
        }));
    }
}