@page "/ResearcherTools"
@using System.Linq
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject HttpClient Http

<div class="container-fluid mt-4" dir="rtl">
    <div class="row">
        <div class="col-12">

            <!-- الترويسة -->
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary animate__animated animate__fadeInDown">
                    <i class="bi bi-mortarboard-fill"></i> مختبر الباحث الأكاديمي
                </h2>
                <p class="text-muted">أدوات فعلية تعتمد على قاعدة بيانات Scopus الحقيقية.</p>
            </div>

            <!-- التبويبات -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill shadow-sm flex-nowrap overflow-auto">
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "home" ? "active" : "")" @onclick='() => SwitchTab("home")'><i class="bi bi-house-door"></i> الرئيسية</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "explorer" ? "active" : "")" @onclick='() => SwitchTab("explorer")'><i class="bi bi-journal-check"></i> مكتبة المجلات</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "matcher" ? "active" : "")" @onclick='() => SwitchTab("matcher")'><i class="bi bi-bullseye"></i> مطابق المجلات</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "calculator" ? "active" : "")" @onclick='() => SwitchTab("calculator")'><i class="bi bi-calculator"></i> حاسبة h-index</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "tracker" ? "active" : "")" @onclick='() => SwitchTab("tracker")'><i class="bi bi-kanban"></i> متابعة الأبحاث</button></li>
            </ul>

            <!-- شاشة تحميل البيانات -->
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <p class="mt-3 text-muted fw-bold">جاري تحميل قاعدة بيانات المجلات...</p>
                </div>
            }
            else
            {
                <div class="tab-content">

                    <!-- ================= 1. الرئيسية ================= -->
                    @if (activeTab == "home")
                    {
                        <div class="row g-4 animate__animated animate__fadeIn">
                            <div class="col-md-6">
                                <div class="card bg-primary text-white shadow border-0 rounded-4 h-100 p-4 position-relative overflow-hidden">
                                    <h5>إجمالي المجلات المتاحة</h5>
                                    <h2 class="fw-bold display-4">@allJournals.Count</h2>
                                    <p class="mb-0 opacity-75">مجلة علمية محكمة ومصنفة</p>
                                    <i class="bi bi-journal-bookmark fs-1 opacity-25 position-absolute bottom-0 end-0 m-3" style="font-size: 5rem !important;"></i>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-success text-white shadow border-0 rounded-4 h-100 p-4 position-relative overflow-hidden">
                                    <h5>أبحاث تتابعها</h5>
                                    <h2 class="fw-bold display-4">@researchList.Count</h2>
                                    <p class="mb-0 opacity-75">مسجلة في متتبع الأبحاث</p>
                                    <i class="bi bi-kanban fs-1 opacity-25 position-absolute bottom-0 end-0 m-3" style="font-size: 5rem !important;"></i>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <div class="card shadow-sm border-0 rounded-4 p-4">
                                    <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary"></i> كيف تستفيد من هذه الأدوات؟</h5>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item"><strong>مكتبة المجلات:</strong> ابحث عن آلاف المجلات المصنفة (Q1-Q4) واعرف معامل التأثير الخاص بها.</li>
                                        <li class="list-group-item"><strong>مطابق المجلات:</strong> الصق مستخلص بحثك، وسيقوم النظام بمطابقته مع الكلمات المفتاحية للمجلات ليقترح لك الأفضل.</li>
                                        <li class="list-group-item"><strong>متابعة الأبحاث:</strong> سجل أبحاثك الحالية وتابع نسبة إنجازها (يُحفظ في متصفحك).</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ================= 2. مكتبة المجلات ================= -->
                    @if (activeTab == "explorer")
                    {
                        <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <h5 class="fw-bold text-info mb-0"><i class="bi bi-journal-check"></i> مكتبة المجلات العلمية</h5>
                                <span class="badge bg-primary rounded-pill px-3 py-2">@FilteredJournals.Count() نتيجة</span>
                            </div>

                            <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                                <button class="btn btn-sm @(selectedQuartile == "All" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => selectedQuartile = "All"'>الكل</button>
                                <button class="btn btn-sm @(selectedQuartile == "Q1" ? "btn-success" : "btn-outline-success")" @onclick='() => selectedQuartile = "Q1"'>Q1</button>
                                <button class="btn btn-sm @(selectedQuartile == "Q2" ? "btn-info" : "btn-outline-info")" @onclick='() => selectedQuartile = "Q2"'>Q2</button>
                                <button class="btn btn-sm @(selectedQuartile == "Q3" ? "btn-warning" : "btn-outline-warning")" @onclick='() => selectedQuartile = "Q3"'>Q3</button>
                                <button class="btn btn-sm @(selectedQuartile == "Q4" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => selectedQuartile = "Q4"'>Q4</button>
                                <input class="form-control form-control-sm ms-auto" style="max-width:300px" placeholder="ابحث باسم المجلة، الناشر..." @bind="searchQuery" @bind:event="oninput" />
                            </div>

                            <div class="table-responsive" style="max-height:500px; overflow-y:auto;">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>اسم المجلة</th>
                                            <th>الناشر</th>
                                            <th>الربع</th>
                                            <th>معامل التأثير (IF)</th>
                                            <th>الموقع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!FilteredJournals.Any())
                                        {
                                            <tr><td colspan="5" class="text-center text-muted py-4">لا توجد نتائج مطابقة للبحث.</td></tr>
                                        }
                                        @foreach (var j in FilteredJournals)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@j.name</td>
                                                <td class="small text-muted">@(j.publisher ?? "غير محدد")</td>
                                                <td><span class="badge bg-@GetQuartileColor(j.quartile)">@j.quartile</span></td>
                                                <td class="fw-bold">@j.impact_factor</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(j.website_url))
                                                    {
                                                        <a href="@j.website_url" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-globe"></i> زيارة</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- ================= 3. مطابق المجلات ================= -->
                    @if (activeTab == "matcher")
                    {
                        <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-bullseye"></i> مطابق المجلات الذكي (بناءً على الكلمات المفتاحية)</h5>
                            <p class="text-muted">الصق عنوان البحث أو مستخلصه (باللغة الإنجليزية)، وسيقوم النظام بمطابقته مع كلمات المجلات المفتاحية ليقترح لك الأفضل.</p>

                            <div class="form-group mb-3">
                                <textarea class="form-control" rows="4" @bind="matcherText" placeholder="مثال: This study investigates the effects of dietary protein on broiler chicken growth and feed efficiency..."></textarea>
                            </div>

                            <div class="d-flex gap-2 mb-4">
                                <button class="btn btn-primary px-4 fw-bold" @onclick="RunSmartMatch" disabled="@isMatching">
                                    @if (isMatching)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="bi bi-search"></i> تحليل ومطابقة
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ClearMatcher">مسح</button>
                            </div>

                            @if (matchResults != null)
                            {
                                if (!matchResults.Any())
                                {
                                    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> لم يتم العثور على مجلات مطابقة. تأكد من كتابة النص باللغة الإنجليزية أو أضف كلمات مفتاحية أوضح.</div>
                                }
                                else
                                {
                                    <h6 class="fw-bold mb-3">أفضل المجلات المقترحة لبحثك:</h6>
                                    <div class="row g-3">
                                        @foreach (var m in matchResults)
                                        {
                                            <div class="col-md-6">
                                                <div class="card border-0 shadow-sm p-3 h-100" style="border-right:5px solid @(m.Score >= 70 ? "#10B981" : m.Score >= 40 ? "#F59E0B" : "#94A3B8") !important;">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <h6 class="fw-bold text-primary mb-1">@m.Journal.name</h6>
                                                        <span class="badge bg-@GetQuartileColor(m.Journal.quartile)">@m.Journal.quartile</span>
                                                    </div>
                                                    <div class="small text-muted mb-2">@m.Journal.publisher</div>
                                                    <div class="progress mb-2" style="height:8px">
                                                        <div class="progress-bar @(m.Score >= 70 ? "bg-success" : m.Score >= 40 ? "bg-warning" : "bg-secondary")" style="width:@m.Score%"></div>
                                                    </div>
                                                    <div class="d-flex justify-content-between small">
                                                        <span class="text-muted">IF: @m.Journal.impact_factor</span>
                                                        <span class="fw-bold">نسبة التوافق: @m.Score%</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }

                    <!-- ================= 4. حاسبة h-index ================= -->
                    @if (activeTab == "calculator")
                    {
                        <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                            <h5 class="fw-bold text-success mb-3"><i class="bi bi-calculator"></i> حاسبة h-index التقريبية</h5>
                            <p class="text-muted">أدخل بياناتك لحساب مؤشر h-index التقريبي وتصنيفك الأكاديمي.</p>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">عدد المقالات المنشورة</label>
                                    <input type="number" class="form-control" @bind="calcArticles" min="0" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">إجمالي الاستشهادات</label>
                                    <input type="number" class="form-control" @bind="calcCitations" min="0" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">أعلى استشهادات لمقال واحد</label>
                                    <input type="number" class="form-control" @bind="calcTopCitation" min="0" />
                                </div>
                            </div>

                            <button class="btn btn-success mt-3 fw-bold px-4" @onclick="CalculateHIndex"><i class="bi bi-gear-fill"></i> احسب المؤشر</button>

                            @if (lastHIndex.HasValue)
                            {
                                <div class="row g-3 mt-4 animate__animated animate__zoomIn">
                                    <div class="col-md-4">
                                        <div class="card border-0 bg-success text-white text-center p-4 rounded-4 h-100">
                                            <div class="small opacity-75 mb-1">h-index التقريبي</div>
                                            <div class="display-5 fw-bold">@lastHIndex.Value.ToString("F1")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card border-0 bg-primary text-white text-center p-4 rounded-4 h-100">
                                            <div class="small opacity-75 mb-1">مستوى الباحث</div>
                                            <div class="fs-3 fw-bold mt-2">@researcherLevel</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card border-0 bg-info text-white text-center p-4 rounded-4 h-100">
                                            <div class="small opacity-75 mb-1">التصنيف المتوقع (Q)</div>
                                            <div class="display-5 fw-bold">@predictedQuartile</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- ================= 5. متابعة الأبحاث ================= -->
                    @if (activeTab == "tracker")
                    {
                        <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                            <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-kanban"></i> متابعة الأبحاث (يُحفظ في متصفحك)</h5>
                            <div class="row g-2 mb-4 p-3 bg-light rounded-3">
                                <div class="col-md-4"><input class="form-control" placeholder="عنوان البحث" @bind="newResearch.Title" /></div>
                                <div class="col-md-3">
                                    <select class="form-select" @bind="newResearch.Status">
                                        <option>فكرة</option>
                                        <option>مسودة</option>
                                        <option>قيد المراجعة</option>
                                        <option>مقبول</option>
                                        <option>منشور</option>
                                    </select>
                                </div>
                                <div class="col-md-3"><input type="date" class="form-control" @bind="newResearch.Deadline" /></div>
                                <div class="col-md-2"><button class="btn btn-primary w-100 fw-bold" @onclick="AddResearch"><i class="bi bi-plus-lg"></i> إضافة</button></div>
                            </div>

                            @if (!researchList.Any())
                            {
                                <div class="text-center text-muted py-4">لا توجد أبحاث مسجلة حالياً. ابدأ بإضافة بحثك الأول.</div>
                            }
                            else
                            {
                                @foreach (var r in researchList.OrderByDescending(x => x.CreatedAt))
                                {
                                    <div class="card border-0 shadow-sm mb-3 p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <h6 class="fw-bold mb-0">@r.Title</h6>
                                                <span class="badge bg-@GetStatusColor(r.Status)">@r.Status</span>
                                                @if (r.Deadline.HasValue && r.Deadline < DateTime.Today && r.Progress < 100)
                                                {
                                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> متأخر</span>
                                                }
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => RemoveResearch(r)'><i class="bi bi-trash"></i></button>
                                        </div>
                                        <div class="progress mb-2" style="height:10px;">
                                            <div class="progress-bar @(r.Progress == 100 ? "bg-success" : "bg-primary")" style="width:@r.Progress%">@r.Progress%</div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted"><i class="bi bi-calendar"></i> الموعد: @(r.Deadline?.ToString("yyyy-MM-dd") ?? "غير محدد")</small>
                                            @if (r.Progress < 100)
                                            {
                                                <button class="btn btn-sm btn-light border" @onclick='() => AdvanceProgress(r)'><i class="bi bi-arrow-up-circle"></i> تحديث التقدم +10%</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }

                </div>
            }
        </div>
    </div>
</div>

@code {
    private string activeTab = "home";
    private bool isLoading = true;
    private bool isMatching = false;

    // بيانات المجلات من Supabase
    private List<Journal> allJournals = new();
    private string searchQuery = "";
    private string selectedQuartile = "All";

    // متغيرات المطابقة الذكية
    private string matcherText = "";
    private List<SmartMatchResult>? matchResults;

    // متغيرات الحاسبة
    private int calcArticles;
    private int calcCitations;
    private int calcTopCitation;
    private double? lastHIndex;
    private string predictedQuartile = "-";
    private string researcherLevel = "-";

    // متغيرات متتبع الأبحاث (محفوظة في localStorage)
    private List<ResearchItem> researchList = new();
    private ResearchItem newResearch = new() { Status = "فكرة", Progress = 0 };

    // إعدادات Supabase
    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    // كلمات الإيقاف لتحسين المطابقة
    private static readonly HashSet<string> StopWords = new(StringComparer.OrdinalIgnoreCase)
    {
        "the", "a", "an", "and", "or", "of", "in", "on", "at", "to", "for",
        "with", "by", "from", "as", "is", "are", "was", "were", "be", "been",
        "this", "that", "these", "those", "it", "its", "their", "our",
        "we", "us", "you", "your", "they", "them", "he", "she", "his", "her",
        "which", "who", "whom", "whose", "what", "when", "where", "why", "how",
        "can", "could", "would", "should", "may", "might", "must", "shall", "will",
        "have", "has", "had", "do", "does", "did", "not", "no", "but", "if",
        "then", "than", "so", "such", "also", "more", "most", "some", "any",
        "all", "each", "every", "both", "few", "many", "much", "other", "another",
        "into", "onto", "upon", "about", "over", "under", "between", "through"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadJournalsFromSupabase();
        await LoadLocalData();
        isLoading = false;
    }

    private async Task LoadJournalsFromSupabase()
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=*&limit=2000");
            req.Headers.Add("apikey", supabaseKey);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                allJournals = JsonSerializer.Deserialize<List<Journal>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading journals: {ex.Message}");
        }
    }

    private async Task LoadLocalData()
    {
        try
        {
            var r = await JS.InvokeAsync<string>("localStorage.getItem", "rt_research");
            if (!string.IsNullOrEmpty(r)) researchList = JsonSerializer.Deserialize<List<ResearchItem>>(r) ?? new();

            var h = await JS.InvokeAsync<string>("localStorage.getItem", "rt_hindex");
            if (double.TryParse(h, out var hv)) lastHIndex = hv;
        }
        catch { }
    }

    // --- مكتبة المجلات ---
    private IEnumerable<Journal> FilteredJournals
    {
        get
        {
            return allJournals.Where(j =>
                (selectedQuartile == "All" || j.quartile == selectedQuartile) &&
                (string.IsNullOrWhiteSpace(searchQuery) ||
                 (j.name != null && j.name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                 (j.publisher != null && j.publisher.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
            ).Take(100); // عرض 100 نتيجة كحد أقصى للسرعة
        }
    }

    private string GetQuartileColor(string q) => q switch
    {
        "Q1" => "success",
        "Q2" => "info",
        "Q3" => "warning",
        _ => "secondary"
    };

    // --- المطابقة الذكية ---
    private async Task RunSmartMatch()
    {
        if (string.IsNullOrWhiteSpace(matcherText)) return;

        isMatching = true;
        await Task.Delay(500); // تأثير بصري للتحميل

        var words = Regex.Matches(matcherText.ToLowerInvariant(), @"\b[a-z][a-z\-]+\b")
            .Cast<Match>().Select(m => m.Value).Where(w => w.Length >= 3).Where(w => !StopWords.Contains(w)).ToList();

        var keywords = words.GroupBy(w => w).OrderByDescending(g => g.Count()).Select(g => g.Key).Take(15).ToList();

        matchResults = allJournals.Select(j =>
        {
            int score = 0;
            int maxScore = 0;

            if (j.keywords != null && j.keywords.Length > 0)
            {
                foreach (var kw in j.keywords)
                {
                    maxScore += 10;
                    if (keywords.Any(k => k.Contains(kw.ToLower()) || kw.ToLower().Contains(k))) score += 10;
                }
            }

            if (!string.IsNullOrWhiteSpace(j.scope))
            {
                maxScore += 5;
                var scopeLower = j.scope.ToLower();
                if (keywords.Any(k => scopeLower.Contains(k))) score += 5;
            }

            int percentage = maxScore > 0 ? (int)Math.Round((double)score / maxScore * 100) : 0;

            if (percentage > 0)
            {
                if (j.quartile == "Q1") percentage += 10;
                else if (j.quartile == "Q2") percentage += 5;
            }

            return new SmartMatchResult { Journal = j, Score = Math.Min(100, percentage) };
        })
        .Where(m => m.Score > 20)
        .OrderByDescending(m => m.Score)
        .ThenByDescending(m => m.Journal.impact_factor)
        .Take(6)
        .ToList();

        isMatching = false;
    }

    // دالة مسح المطابقة
    private void ClearMatcher()
    {
        matcherText = "";
        matchResults = null;
    }

    // --- الحاسبة ---
    private async Task CalculateHIndex()
    {
        if (calcArticles <= 0) { lastHIndex = 0; return; }
        double avg = (double)calcCitations / calcArticles;
        double top = calcTopCitation > 0 ? calcTopCitation : avg;
        lastHIndex = Math.Min(calcArticles, Math.Sqrt(avg * top));

        predictedQuartile = avg >= 15 ? "Q1" : avg >= 8 ? "Q2" : avg >= 3 ? "Q3" : "Q4";
        researcherLevel = lastHIndex >= 15 ? "باحث متميز" : lastHIndex >= 8 ? "باحث نشط" : lastHIndex >= 3 ? "باحث مبتدئ" : "طالب";

        await JS.InvokeVoidAsync("localStorage.setItem", "rt_hindex", lastHIndex.Value.ToString("F2"));
    }

    // --- متتبع الأبحاث ---
    private async Task AddResearch()
    {
        if (string.IsNullOrWhiteSpace(newResearch.Title)) return;
        newResearch.CreatedAt = DateTime.Now;
        researchList.Add(newResearch);
        newResearch = new() { Status = "فكرة", Progress = 0 };
        await SaveResearch();
    }

    private async Task AdvanceProgress(ResearchItem r)
    {
        r.Progress = Math.Min(100, r.Progress + 10);
        if (r.Progress == 100) r.Status = "مكتمل";
        await SaveResearch();
    }

    private async Task RemoveResearch(ResearchItem r)
    {
        researchList.Remove(r);
        await SaveResearch();
    }

    private async Task SaveResearch() => await JS.InvokeVoidAsync("localStorage.setItem", "rt_research", JsonSerializer.Serialize(researchList));

    private string GetStatusColor(string s) => s switch
    {
        "منشور" => "success",
        "مقبول" => "primary",
        "قيد المراجعة" => "warning",
        "مسودة" => "info",
        "مكتمل" => "success",
        _ => "secondary"
    };

    private void SwitchTab(string tab) => activeTab = tab;

    // --- الكلاسات ---
    public class Journal
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string quartile { get; set; } = "";
        public double? impact_factor { get; set; }
        public string scope { get; set; } = "";
        public string website_url { get; set; } = "";
        public string[]? keywords { get; set; }
    }

    public class SmartMatchResult
    {
        public Journal Journal { get; set; } = new();
        public int Score { get; set; }
    }

    public class ResearchItem
    {
        public string Title { get; set; } = "";
        public string Status { get; set; } = "فكرة";
        public int Progress { get; set; }
        public DateTime? Deadline { get; set; }
        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }
}