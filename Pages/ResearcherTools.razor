@page "/ResearcherTools"
@using System.Linq
@inject IJSRuntime JS

<div class="container-fluid mt-4" dir="rtl">
    <div class="row">
        <div class="col-12">
            <!-- الترويسة الرئيسية -->
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary animate__animated animate__fadeInDown">
                    <i class="bi bi-mortarboard-fill"></i> البوابة الذكية لدعم الباحث الأكاديمي
                </h2>
                <p class="text-muted">منصة متكاملة لإدارة الأبحاث، تقييم المجلات العلمية المحكمة، وتخطيط مسارك الأكاديمي بكفاءة عالية.</p>
            </div>

            <!-- شريط التنقل بين الأدوات -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill shadow-sm flex-nowrap overflow-auto">
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "home" ? "active" : "")" @onclick='() => SwitchTab("home")'><i class="bi bi-house-door"></i> الرئيسية</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "calculator" ? "active" : "")" @onclick='() => SwitchTab("calculator")'><i class="bi bi-calculator"></i> حاسبة التأثير</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "explorer" ? "active" : "")" @onclick='() => SwitchTab("explorer")'><i class="bi bi-journal-check"></i> دليل المجلات Q1-Q4</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "matcher" ? "active" : "")" @onclick='() => SwitchTab("matcher")'><i class="bi bi-bullseye"></i> مطابق المجلات</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "stats" ? "active" : "")" @onclick='() => SwitchTab("stats")'><i class="bi bi-bar-chart"></i> إحصائيات المنصة</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "guidelines" ? "active" : "")" @onclick='() => SwitchTab("guidelines")'><i class="bi bi-shield-check"></i> تفادي المجلات الوهمية</button></li>
                <li class="nav-item"><button class="nav-link w-100 @(activeTab == "tracker" ? "active" : "")" @onclick='() => SwitchTab("tracker")'><i class="bi bi-kanban"></i> متابعة إنجاز الأبحاث</button></li>
            </ul>

            <!-- محتوى التبويبات -->
            <div class="tab-content">

                <!-- 1. الرئيسية / لوحة القيادة -->
                @if (activeTab == "home")
                {
                    <div class="row g-4 animate__animated animate__fadeIn">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white shadow border-0 rounded-4 h-100 p-3 position-relative overflow-hidden">
                                <h6>إجمالي المجلات المتاحة</h6>
                                <h3 class="fw-bold">@allJournals.Count</h3>
                                <i class="bi bi-journal-bookmark fs-1 opacity-25 position-absolute bottom-0 end-0 m-3"></i>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white shadow border-0 rounded-4 h-100 p-3 position-relative overflow-hidden">
                                <h6>مجلات التصنيف الأول (Q1)</h6>
                                <h3 class="fw-bold">@allJournals.Count(j => j.Quartile == "Q1")</h3>
                                <i class="bi bi-trophy fs-1 opacity-25 position-absolute bottom-0 end-0 m-3"></i>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-dark shadow border-0 rounded-4 h-100 p-3 position-relative overflow-hidden">
                                <h6>متوسط معامل التأثير</h6>
                                <h3 class="fw-bold">@(allJournals.Any() ? allJournals.Average(j => j.ImpactFactor).ToString("F2") : "0.00")</h3>
                                <i class="bi bi-graph-up-arrow fs-1 opacity-25 position-absolute bottom-0 end-0 m-3"></i>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white shadow border-0 rounded-4 h-100 p-3 position-relative overflow-hidden">
                                <h6>التخصصات الأكاديمية</h6>
                                <h3 class="fw-bold">@allJournals.Select(j => j.Field).Distinct().Count()</h3>
                                <i class="bi bi-collection fs-1 opacity-25 position-absolute bottom-0 end-0 m-3"></i>
                            </div>
                        </div>
                        <div class="col-12 mt-4">
                            <div class="card shadow-sm border-0 rounded-4 p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-lightbulb text-primary"></i> دليل استخدام المنصة</h5>
                                <p class="text-muted mb-0">تم إعداد هذه المنصة لدعم الباحثين في مختلف التخصصات العلمية والإنسانية. يمكنك استكشاف المجلات الرصينة، حساب مؤشرات الأداء، مقارنة دور النشر، والتأكد من موثوقية المجلات قبل الشروع في إرسال نتاجك العلمي.</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- 2. حاسبة التأثير -->
                @if (activeTab == "calculator")
                {
                    <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                        <h5 class="fw-bold text-success mb-3"><i class="bi bi-calculator"></i> حاسبة معامل التأثير والمؤشرات</h5>
                        <p class="text-muted">قم بإدخال بيانات الاستشهادات والمقالات لحساب معامل التأثير التقريبي بدقة وسرعة.</p>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">إجمالي الاستشهادات (Citations)</label>
                                <input type="number" class="form-control form-control-lg" @bind="citations" placeholder="مثال: 250" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">إجمالي المقالات المنشورة (Articles)</label>
                                <input type="number" class="form-control form-control-lg" @bind="articles" placeholder="مثال: 40" />
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-success btn-lg w-100 shadow-sm" @onclick="CalculateImpactFactor">
                                    <i class="bi bi-gear-fill"></i> احسب المؤشر
                                </button>
                            </div>
                        </div>
                        @if (impactFactor.HasValue)
                        {
                            <div class="alert alert-success mt-4 text-center shadow-sm animate__animated animate__zoomIn">
                                <h4 class="mb-0">معامل التأثير المقدر: <strong class="fs-2">@impactFactor.Value.ToString("F2")</strong></h4>
                            </div>
                        }
                    </div>
                }

                <!-- 3. مستكشف المجلات -->
                @if (activeTab == "explorer")
                {
                    <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                        <h5 class="fw-bold text-info mb-3"><i class="bi bi-journal-check"></i> دليل ومستكشف المجلات (Q1 - Q4)</h5>
                        <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                            <button class="btn @(selectedQuartile == "All" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByQuartile("All")'>الكل</button>
                            <button class="btn @(selectedQuartile == "Q1" ? "btn-success text-white" : "btn-outline-success")" @onclick='() => FilterByQuartile("Q1")'>Q1</button>
                            <button class="btn @(selectedQuartile == "Q2" ? "btn-info text-white" : "btn-outline-info")" @onclick='() => FilterByQuartile("Q2")'>Q2</button>
                            <button class="btn @(selectedQuartile == "Q3" ? "btn-warning text-dark" : "btn-outline-warning")" @onclick='() => FilterByQuartile("Q3")'>Q3</button>
                            <button class="btn @(selectedQuartile == "Q4" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => FilterByQuartile("Q4")'>Q4</button>
                            <input type="text" class="form-control w-25 ms-auto" @bind="searchQuery" @bind:event="oninput" placeholder="ابحث باسم المجلة أو التخصص..." />
                        </div>
                        <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                            <table class="table table-hover align-middle">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>اسم المجلة</th>
                                        <th>التخصص العام</th>
                                        <th>دار النشر</th>
                                        <th>الربع</th>
                                        <th>معامل التأثير</th>
                                        <th>قاعدة البيانات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!FilteredJournalsList.Any())
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">لا توجد نتائج مطابقة للبحث.</td></tr>
                                    }
                                    @foreach (var j in FilteredJournalsList)
                                    {
                                        <tr>
                                            <td class="fw-bold">@j.Title</td>
                                            <td><span class="badge bg-light text-dark border">@j.Field</span></td>
                                            <td>@j.Publisher</td>
                                            <td><span class="badge bg-@GetQuartileColor(j.Quartile)">@j.Quartile</span></td>
                                            <td>@j.ImpactFactor</td>
                                            <td>@j.Database</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- 4. مطابق المجلات -->
                @if (activeTab == "matcher")
                {
                    <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-bullseye"></i> مطابق المجلة المقترحة لعنوان البحث</h5>
                        <p class="text-muted">اكتب الكلمات الرئيسية أو مجال بحثك وسنقوم بترشيح المجلات الأنسب لك.</p>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control form-control-lg" @bind="keywordInput" placeholder="مثال: علوم، بيئة، حاسبات، اقتصاد..." />
                            <button class="btn btn-primary px-4" @onclick="AnalyzeKeywords"><i class="bi bi-search"></i> بحث وتطابق</button>
                        </div>
                        @if (recommendedJournals != null && recommendedJournals.Any())
                        {
                            <h6 class="fw-bold mt-4">المجلات المتوافقة مع اهتمامك:</h6>
                            <div class="row g-3">
                                @foreach (var j in recommendedJournals)
                                {
                                    <div class="col-md-4">
                                        <div class="card border-0 shadow-sm h-100 p-3 bg-light">
                                            <h6 class="fw-bold text-primary">@j.Title</h6>
                                            <p class="small text-muted mb-1">التخصص: @j.Field</p>
                                            <div class="mt-2">
                                                <span class="badge bg-@GetQuartileColor(j.Quartile)">@j.Quartile</span>
                                                <span class="badge bg-secondary">Impact: @j.ImpactFactor</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- 5. الإحصائيات -->
                @if (activeTab == "stats")
                {
                    <div class="row g-4 animate__animated animate__fadeIn">
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                                <h5 class="fw-bold text-primary mb-3">توزيع المجلات حسب الأرباع الأكاديمية</h5>
                                <div style="position: relative; height: 300px;">
                                    <canvas id="quartileChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                                <h5 class="fw-bold text-success mb-3">أبرز دور النشر العالمية المعتمدة</h5>
                                <div style="position: relative; height: 300px;">
                                    <canvas id="publishersChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- 6. تفادي المجلات الوهمية -->
                @if (activeTab == "guidelines")
                {
                    <div class="row g-4 animate__animated animate__fadeIn">
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 rounded-4 h-100 p-4 border-start border-success border-4">
                                <h5 class="fw-bold text-success mb-3"><i class="bi bi-shield-fill-check"></i> معايير اختيار المجلات الرصينة</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">التأكد من إدراج المجلة في مستوعبات Scopus أو Clarivate (ISI).</li>
                                    <li class="list-group-item">فحص هيئة التحرير والتأكد من وجود أسماء أكاديمية حقيقية ومعروفة.</li>
                                    <li class="list-group-item">شفافية أجور النشر ووجود سياسة واضحة لمراجعة الأقران (Peer Review).</li>
                                    <li class="list-group-item">التأكد من عدم وجود المجلة في قوائم المجلات الوهمية والمفترسة (Beall's List سابقاً).</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 rounded-4 h-100 p-4 border-start border-danger border-4">
                                <h5 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i> علامات تدل على المجلة الوهمية</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">السرعة المبالغة في قبول ونشر الأبحاث (خلال أيام معدودة!).</li>
                                    <li class="list-group-item">إرسال رسائل دعوة متكررة وغير مبررة للنشر البريدي الإلكتروني.</li>
                                    <li class="list-group-item">استخدام معامل تأثير وهمي غير معتمد (مثل Fake Impact Factor).</li>
                                    <li class="list-group-item">عدم وضوح عنوان دار النشر أو التواصل عبر بريد مجاني (Gmail/Yahoo).</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <!-- 7. متتبع الأبحاث -->
                @if (activeTab == "tracker")
                {
                    <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeIn">
                        <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-kanban"></i> لوحة متابعة حالة الأبحاث والأطروحات</h5>
                        <p class="text-muted">سجل أبحاثك الحالية وتابع مراحل إنجازها ونشرها.</p>
                        <div class="row g-2 mb-3">
                            <div class="col-md-5">
                                <input type="text" class="form-control" @bind="newResearchTitle" placeholder="عنوان البحث أو الدراسة" />
                            </div>
                            <div class="col-md-4">
                                <select class="form-select" @bind="newResearchStatus">
                                    <option value="مسودة وتحليل">مسودة وتحليل</option>
                                    <option value="قيد المراجعة في المجلة">قيد المراجعة في المجلة</option>
                                    <option value="مقبول للنشر">مقبول للنشر</option>
                                    <option value="منشور رسمياً">منشور رسمياً</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-primary w-100" @onclick="AddResearch"><i class="bi bi-plus-circle"></i> إضافة بحث جديد</button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead>
                                    <tr><th>العنوان</th><th>الحالة الحالية</th><th>إجراء</th></tr>
                                </thead>
                                <tbody>
                                    @if (!researchList.Any())
                                    {
                                        <tr><td colspan="3" class="text-center text-muted">لا توجد أبحاث مسجلة حتى الآن.</td></tr>
                                    }
                                    @foreach (var r in researchList)
                                    {
                                        <tr>
                                            <td>@r.Title</td>
                                            <td><span class="badge bg-@GetStatusColor(r.Status)">@r.Status</span></td>
                                            <td><button class="btn btn-sm btn-outline-danger" @onclick='() => RemoveResearch(r)'><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private string activeTab = "home";
    private List<JournalModel> allJournals = new();
    private string searchQuery = "";

    // خاص بحاسبة التأثير
    private double? citations;
    private double? articles;
    private double? impactFactor;

    // مستكشف المجلات
    private string selectedQuartile = "All";

    private IEnumerable<JournalModel> FilteredJournalsList => allJournals
        .Where(j => (selectedQuartile == "All" || j.Quartile == selectedQuartile) &&
                    (string.IsNullOrWhiteSpace(searchQuery) || j.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || j.Field.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    // مطابق المجلات
    private string keywordInput = "";
    private List<JournalModel>? recommendedJournals;

    // متتبع الأبحاث
    private string newResearchTitle = "";
    private string newResearchStatus = "مسودة وتحليل";
    private List<ResearchItem> researchList = new();

    protected override async Task OnInitializedAsync()
    {
        // بيانات نموذجية عامة تشمل مختلف التخصصات العلمية والإنسانية
        allJournals = new List<JournalModel>
        {
            new JournalModel { Id = 1, Title = "Nature Biotechnology", Field = "العلوم الحيوية والتقنية", Publisher = "Springer Nature", Quartile = "Q1", ImpactFactor = 45.2, Database = "Scopus / ISI" },
            new JournalModel { Id = 2, Title = "Journal of Animal Science and Biotechnology", Field = "العلوم الزراعية والإنتاج الحيواني", Publisher = "BioMed Central", Quartile = "Q1", ImpactFactor = 4.1, Database = "Scopus" },
            new JournalModel { Id = 3, Title = "Computers and Electronics in Agriculture", Field = "الزراعة والتقنيات الذكية", Publisher = "Elsevier", Quartile = "Q1", ImpactFactor = 8.3, Database = "Scopus / ISI" },
            new JournalModel { Id = 4, Title = "International Journal of Agricultural Sustainability", Field = "الاستدامة الزراعية", Publisher = "Taylor & Francis", Quartile = "Q1", ImpactFactor = 5.0, Database = "Scopus" },
            new JournalModel { Id = 5, Title = "Livestock Science", Field = "إنتاج الحيوان", Publisher = "Elsevier", Quartile = "Q2", ImpactFactor = 2.3, Database = "Scopus" },
            new JournalModel { Id = 6, Title = "Journal of Agricultural and Food Chemistry", Field = "الكيمياء والعلوم الغذائية", Publisher = "ACS Publications", Quartile = "Q1", ImpactFactor = 6.1, Database = "ISI" },
            new JournalModel { Id = 7, Title = "Scientific Reports", Field = "علوم متعددة التخصصات", Publisher = "Springer Nature", Quartile = "Q1", ImpactFactor = 4.6, Database = "Scopus / ISI" },
            new JournalModel { Id = 8, Title = "Egyptian Journal of Animal Production", Field = "الإنتاج الحيواني", Publisher = "جامعة عكاظ / محكمة", Quartile = "Q3", ImpactFactor = 1.1, Database = "Scopus" }
        };

        await Task.CompletedTask;
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "stats")
        {
            _ = InvokeAsync(async () =>
            {
                await Task.Delay(100);
                await InitializeCharts();
            });
        }
    }

    private async Task InitializeCharts()
    {
        var quartileData = new int[] {
            allJournals.Count(j => j.Quartile == "Q1"),
            allJournals.Count(j => j.Quartile == "Q2"),
            allJournals.Count(j => j.Quartile == "Q3"),
            allJournals.Count(j => j.Quartile == "Q4")
        };

        var publishersGrouped = allJournals
            .GroupBy(j => j.Publisher)
            .Select(g => new { Name = g.Key, Count = g.Count() })
            .OrderByDescending(g => g.Count)
            .Take(5)
            .ToList();

        var pubNames = publishersGrouped.Select(p => p.Name).ToArray();
        var pubCounts = publishersGrouped.Select(p => p.Count).ToArray();

        await JS.InvokeVoidAsync("renderCharts", quartileData, pubNames, pubCounts);
    }

    private void CalculateImpactFactor()
    {
        if (citations.HasValue && articles.HasValue && articles.Value > 0)
        {
            impactFactor = citations.Value / articles.Value;
        }
        else
        {
            impactFactor = 0;
        }
    }

    private void FilterByQuartile(string quartile)
    {
        selectedQuartile = quartile;
    }

    private void AnalyzeKeywords()
    {
        if (string.IsNullOrWhiteSpace(keywordInput))
        {
            recommendedJournals = new List<JournalModel>();
            return;
        }
        var term = keywordInput.Trim().ToLower();
        recommendedJournals = allJournals.Where(j => j.Title.ToLower().Contains(term) || j.Field.ToLower().Contains(term)).ToList();

        if (!recommendedJournals.Any())
        {
            recommendedJournals = allJournals.OrderByDescending(j => j.ImpactFactor).Take(3).ToList();
        }
    }

    private void AddResearch()
    {
        if (!string.IsNullOrWhiteSpace(newResearchTitle))
        {
            researchList.Add(new ResearchItem { Title = newResearchTitle, Status = newResearchStatus });
            newResearchTitle = "";
        }
    }

    private void RemoveResearch(ResearchItem item)
    {
        researchList.Remove(item);
    }

    private string GetQuartileColor(string quartile) => quartile switch
    {
        "Q1" => "success",
        "Q2" => "info",
        "Q3" => "warning",
        "Q4" => "secondary",
        _ => "light"
    };

    private string GetStatusColor(string status) => status switch
    {
        "منشور رسمياً" => "success",
        "مقبول للنشر" => "primary",
        "قيد المراجعة في المجلة" => "warning",
        _ => "secondary"
    };

    public class JournalModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Field { get; set; } = string.Empty;
        public string Publisher { get; set; } = string.Empty;
        public string Quartile { get; set; } = string.Empty;
        public double ImpactFactor { get; set; }
        public string Database { get; set; } = string.Empty;
    }

    public class ResearchItem
    {
        public string Title { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}