@page "/"
@inject HttpClient Http
@implements IDisposable

<PageTitle>لوحة التحكم | AI Journal Matcher</PageTitle>

<!-- الشريط العلوي الخاص بلوحة التحكم -->
<!-- الشريط العلوي الخاص بلوحة التحكم (صف واحد) -->
<div class="home-top-navbar">
    <!-- الجزء الأيمن: الترحيب -->
    <div class="welcome-section">
        <h3 class="welcome-title">مرحباً بعودتك، قاسم موسى رزيج! 👋</h3>
        <div class="welcome-subtitle">نظرة عامة على المجلات الأكاديمية السحابية وإحصائيات النظام</div>
    </div>

    <!-- الجزء الأيسر: المستخدم، الوقت، التحديث -->
    <div class="navbar-actions">
        <!-- المستخدم -->
        <div class="user-info-navbar">
            <div class="user-avatar-nav">Q</div>
            <span class="user-name-nav">Researcher</span>
        </div>

        <!-- الوقت -->
        <div class="date-time-box">
            <div class="date-text">
                <i class="bi bi-calendar3"></i> @currentDate
            </div>
            <div class="time-text">@currentTime</div>
        </div>

        <!-- زر التحديث -->
        <button class="btn-refresh" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> تحديث
        </button>
    </div>
</div>

@if (isLoading)
{
    <div style="text-align: center; padding: 80px 0;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        <p style="margin-top: 20px; color: #64748B; font-weight: 600; font-size: 16px;">جاري تحميل البيانات من السحابة...</p>
    </div>
}
else
{
    <!-- بطاقات الإحصائيات (KPI) -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px;">
        <!-- إجمالي المجلات -->
        <div class="card stat-card" style="padding: 25px;">
            <div>
                <div style="font-size: 13px; color: #64748B; font-weight: 600;">إجمالي المجلات</div>
                <div style="font-size: 32px; font-weight: 800; color: #1E293B; margin-top: 6px;">@journalsCount</div>
            </div>
            <div class="stat-icon" style="background: #EEF2FF; color: #6366F1; width: 60px; height: 60px; font-size: 28px;">
                <i class="bi bi-journal-text"></i>
            </div>
        </div>

        <!-- الباحثون -->
        <div class="card stat-card" style="padding: 25px;">
            <div>
                <div style="font-size: 13px; color: #64748B; font-weight: 600;">الباحثون</div>
                <div style="font-size: 32px; font-weight: 800; color: #1E293B; margin-top: 6px;">@researchersCount</div>
            </div>
            <div class="stat-icon" style="background: #DCFCE7; color: #16A34A; width: 60px; height: 60px; font-size: 28px;">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>

        <!-- جلسات المطابقة -->
        <div class="card stat-card" style="padding: 25px;">
            <div>
                <div style="font-size: 13px; color: #64748B; font-weight: 600;">جلسات المطابقة</div>
                <div style="font-size: 32px; font-weight: 800; color: #1E293B; margin-top: 6px;">0</div>
            </div>
            <div class="stat-icon" style="background: #FEF3C7; color: #D97706; width: 60px; height: 60px; font-size: 28px;">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
        </div>

        <!-- دقة النظام -->
        <div class="card stat-card" style="padding: 25px;">
            <div>
                <div style="font-size: 13px; color: #64748B; font-weight: 600;">دقة النظام</div>
                <div style="font-size: 32px; font-weight: 800; color: #1E293B; margin-top: 6px;">99.2%</div>
            </div>
            <div class="stat-icon" style="background: #FCE7F3; color: #DB2777; width: 60px; height: 60px; font-size: 28px;">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>

    <!-- أحدث المجلات -->
    <div class="card" style="padding: 0; overflow: hidden; border-radius: 16px;">
        <!-- رأس الجدول -->
        <div style="padding: 24px; border-bottom: 1px solid #F1F5F9; display: flex; justify-content: space-between; align-items: center; background: #FFFFFF;">
            <div style="font-size: 18px; font-weight: bold; color: #1E293B; display: flex; align-items: center; gap: 10px;">
                <i class="bi bi-journals" style="color: #6366F1;"></i> أحدث المجلات المضافة
            </div>
            <a href="/manage-journals" style="font-size: 14px; color: #6366F1; text-decoration: none; font-weight: 700; background: #EEF2FF; padding: 8px 16px; border-radius: 8px; transition: 0.2s;">
                عرض الكل <i class="bi bi-arrow-left" style="font-size: 12px;"></i>
            </a>
        </div>

        <!-- الجدول -->
        <table class="table-custom" style="margin-bottom: 0;">
            <thead>
                <tr>
                    <th>اسم المجلة</th>
                    <th>الناشر</th>
                    <th>الدولة</th>
                    <th>الربع</th>
                    <th>معامل التأثير</th>
                </tr>
            </thead>
            <tbody>
                @if (recentJournals.Count == 0)
                {
                    <tr><td colspan="5" style="text-align: center; color: #94A3B8; padding: 40px; font-size: 15px;">لا توجد مجلات لعرضها حالياً</td></tr>
                }
                @foreach (var journal in recentJournals)
                {
                    <tr>
                        <td style="font-weight: bold; color: #1E293B; font-size: 15px;">@journal.name</td>
                        <td style="color: #475569; font-size: 14px;">@journal.publisher</td>
                        <td style="color: #475569; font-size: 14px;">@journal.country</td>
                        <td>
                            <span class="badge-quartile">
                                @journal.quartile
                            </span>
                        </td>
                        <td style="font-weight: 800; color: #0F172A; font-size: 16px;">@journal.impact_factor</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool isLoading = true;
    private int journalsCount = 0;
    private int researchersCount = 0;
    private List<Journal> recentJournals = new();

    private string currentDate = "";
    private string currentTime = "";
    private Timer? _timer;

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        UpdateTime();

        _timer = new Timer(_ =>
                {
                    InvokeAsync(() =>
                    {
                        UpdateTime();
                        StateHasChanged();
                    });
                }, null, 0, 1000);
    }

    private void UpdateTime()
    {
        var now = DateTime.Now;
        currentDate = now.ToString("yyyy-MM-dd");
        currentTime = now.ToString("hh:mm:ss tt");
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var requestJournals = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=*&limit=5&order=id.desc");
            requestJournals.Headers.Add("apikey", supabaseKey);
            requestJournals.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var responseJournals = await Http.SendAsync(requestJournals);
            if (responseJournals.IsSuccessStatusCode)
            {
                var json = await responseJournals.Content.ReadAsStringAsync();
                recentJournals = System.Text.Json.JsonSerializer.Deserialize<List<Journal>>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }

            var requestCount = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=id");
            requestCount.Headers.Add("apikey", supabaseKey);
            requestCount.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            var responseCount = await Http.SendAsync(requestCount);
            if (responseCount.IsSuccessStatusCode)
            {
                var jsonCount = await responseCount.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(jsonCount);
                journalsCount = doc.RootElement.GetArrayLength();
            }

            var requestUsers = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?select=id");
            requestUsers.Headers.Add("apikey", supabaseKey);
            requestUsers.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            var responseUsers = await Http.SendAsync(requestUsers);
            if (responseUsers.IsSuccessStatusCode)
            {
                var jsonUsers = await responseUsers.Content.ReadAsStringAsync();
                using var docUsers = System.Text.Json.JsonDocument.Parse(jsonUsers);
                researchersCount = docUsers.RootElement.GetArrayLength();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    public class Journal
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string country { get; set; } = "";
        public string quartile { get; set; } = "";
        public double impact_factor { get; set; }
    }
}