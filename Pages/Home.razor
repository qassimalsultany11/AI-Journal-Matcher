@page "/"
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>لوحة التحكم | AI Journal Matcher</PageTitle>

<style>
    .dashboard-container {
        padding: 25px;
        background: #F8FAFC;
        min-height: 100vh;
        direction: rtl;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* الهيدر */
    .header-card {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        border-radius: 16px;
        padding: 30px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
        position: relative;
        overflow: hidden;
    }

        .header-card::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
        }

    .header-info h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
    }

    .header-info p {
        margin: 5px 0 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .clock-box {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(255,255,255,0.3);
    }

    /* كروت الإحصائيات */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #F1F5F9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: var(--accent-color);
        }

    .stat-info h3 {
        margin: 0;
        color: #64748B;
        font-size: 14px;
        font-weight: 600;
    }

    .stat-info .number {
        margin: 8px 0 0 0;
        color: #1E293B;
        font-size: 32px;
        font-weight: 800;
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        background: var(--icon-bg);
        color: var(--accent-color);
    }

    /* قسم الرسوم البيانية البديلة */
    .insights-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .insight-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #F1F5F9;
    }

        .insight-card h3 {
            margin: 0 0 20px 0;
            color: #1E293B;
            font-size: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* أشرطة التقدم */
    .progress-item {
        margin-bottom: 20px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #334155;
    }

    .progress-bar-bg {
        width: 100%;
        height: 10px;
        background: #F1F5F9;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 10px;
        transition: width 1.5s ease-in-out;
    }

    /* دوائر النسب */
    .circular-progress-container {
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .circular-progress {
        position: relative;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: conic-gradient(var(--color) calc(var(--percent) * 1%), #F1F5F9 0);
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background 1.5s ease-in-out;
    }

        .circular-progress::before {
            content: '';
            position: absolute;
            width: 90px;
            height: 90px;
            background: white;
            border-radius: 50%;
        }

        .circular-progress .value {
            position: relative;
            font-size: 24px;
            font-weight: 800;
            color: #1E293B;
        }

    .circular-label {
        text-align: center;
        margin-top: 10px;
        font-weight: 700;
        color: #64748B;
        font-size: 14px;
    }

    .loading-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        flex-direction: column;
        background: #F8FAFC;
    }
</style>

@if (!isLoaded)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
        <p style="margin-top: 15px; color: #64748B; font-weight: bold;">جاري تحميل البيانات الحية...</p>
    </div>
}
else
{
    <div class="dashboard-container">
        <!-- الهيدر -->
        <div class="header-card">
            <div class="header-info">
                <h1>مرحباً بعودتك، @currentUserName! 👋</h1>
                <p>نظرة عامة شاملة على إحصائيات النظام</p>
            </div>
            <div class="clock-box">
                <i class="bi bi-clock"></i>
                <span>@currentTime</span>
            </div>
        </div>

        <!-- كروت الإحصائيات -->
        <div class="stats-grid">
            <div class="stat-card" style="--accent-color: #6366F1; --icon-bg: #EEF2FF;">
                <div class="stat-info">
                    <h3>إجمالي المجلات</h3>
                    <p class="number">@totalJournals</p>
                </div>
                <div class="stat-icon"><i class="bi bi-journals"></i></div>
            </div>

            <div class="stat-card" style="--accent-color: #10B981; --icon-bg: #ECFDF5;">
                <div class="stat-info">
                    <h3>عدد الباحثين</h3>
                    <p class="number">@totalUsers</p>
                </div>
                <div class="stat-icon"><i class="bi bi-people"></i></div>
            </div>

            <div class="stat-card" style="--accent-color: #F59E0B; --icon-bg: #FFF7ED;">
                <div class="stat-info">
                    <h3>المجلات العراقية IQ</h3>
                    <p class="number">@iraqiJournals</p>
                </div>
                <div class="stat-icon"><i class="bi bi-geo-alt"></i></div>
            </div>

            <div class="stat-card" style="--accent-color: #EC4899; --icon-bg: #FDF2F8;">
                <div class="stat-info">
                    <h3>الدول المشاركة</h3>
                    <p class="number">@totalCountries</p>
                </div>
                <div class="stat-icon"><i class="bi bi-globe"></i></div>
            </div>

            <div class="stat-card" style="--accent-color: #8B5CF6; --icon-bg: #F3E8FF;">
                <div class="stat-info">
                    <h3>عدد الجامعات</h3>
                    <p class="number">@totalUniversities</p>
                </div>
                <div class="stat-icon"><i class="bi bi-building"></i></div>
            </div>

            <div class="stat-card" style="--accent-color: #14B8A6; --icon-bg: #CCFBF1;">
                <div class="stat-info">
                    <h3>عدد التخصصات</h3>
                    <p class="number">@totalSpecializations</p>
                </div>
                <div class="stat-icon"><i class="bi bi-book"></i></div>
            </div>
        </div>

        <!-- قسم التحليلات -->
        <div class="insights-grid">
            <!-- توزيع المجلات حسب الربع -->
            <div class="insight-card">
                <h3><i class="bi bi-pie-chart-fill" style="color: #6366F1;"></i> توزيع المجلات حسب الربع (Quartile)</h3>

                @if (quartileStats.Any())
                {
                    @foreach (var q in quartileStats)
                    {
                        <div class="progress-item">
                            <div class="progress-header">
                                <span>@q.Key</span>
                                <span>@q.Value مجلة</span>
                            </div>
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" style="width: @q.Percentage%; background: @q.Color;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="text-align: center; color: #94A3B8; padding: 20px;">لا توجد بيانات كافية</p>
                }
            </div>

            <!-- التوزيع الجغرافي (دول الباحثين) -->
            <div class="insight-card">
                <h3><i class="bi bi-geo-fill" style="color: #10B981;"></i> توزيع الباحثين حسب الدولة</h3>

                <div class="circular-progress-container">
                    @if (topUserCountries.Any())
                    {
                        @foreach (var country in topUserCountries.Take(3))
                        {
                            <div>
                                <div class="circular-progress" style="--percent: @country.Percentage; --color: @country.Color;">
                                    <span class="value">@country.Percentage%</span>
                                </div>
                                <div class="circular-label">@country.Name (@country.Count)</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="text-align: center; color: #94A3B8; padding: 20px; width: 100%;">لا توجد بيانات دول مسجلة حالياً</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string currentUserName = "عزيزي المستخدم";
    private string currentTime = "";
    private bool isLoaded = false;

    // إحصائيات عامة
    private int totalJournals = 0;
    private int totalUsers = 0;
    private int iraqiJournals = 0;
    private int totalCountries = 0;
    private int totalUniversities = 0;
    private int totalSpecializations = 0;

    // بيانات الرسوم
    private List<QuartileStat> quartileStats = new();
    private List<CountryStat> topUserCountries = new();

    private System.Threading.Timer? _timer;

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    protected override async Task OnInitializedAsync()
    {
        // 1. جلب الاسم
        try
        {
            var storedName = await JS.InvokeAsync<string>("localStorage.getItem", "fullName");
            if (!string.IsNullOrEmpty(storedName)) currentUserName = storedName;
        }
        catch { }

        // 2. الساعة
        UpdateClock();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            UpdateClock();
            StateHasChanged();
        }), null, 0, 1000);

        // 3. جلب البيانات
        await LoadData();

        isLoaded = true;
    }

    private void UpdateClock()
    {
        currentTime = DateTime.Now.ToString("hh:mm:ss tt | yyyy-MM-dd");
    }

    private async Task LoadData()
    {
        try
        {
            List<JournalData> journals = new();
            List<UserData> users = new();

            // --- جلب بيانات المستخدمين (بدون طلب حقل country لأنه غير موجود) ---
            var userReq = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?select=university,specialization,role");
            userReq.Headers.Add("apikey", supabaseKey);
            userReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var userRes = await Http.SendAsync(userReq);

            if (userRes.IsSuccessStatusCode)
            {
                var json = await userRes.Content.ReadAsStringAsync();
                users = JsonSerializer.Deserialize<List<UserData>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

                totalUsers = users.Count;

                totalUniversities = users
                                    .Where(u => !string.IsNullOrWhiteSpace(u.university))
                                    .Select(u => u.university.Trim().ToLower())
                                    .Distinct()
                                    .Count();

                totalSpecializations = users
                    .Where(u => !string.IsNullOrWhiteSpace(u.specialization))
                    .Select(u => u.specialization.Trim().ToLower())
                    .Distinct()
                    .Count();
            }

            // --- جلب بيانات المجلات ---
            var journalReq = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=quartile,country,publisher");
            journalReq.Headers.Add("apikey", supabaseKey);
            journalReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var journalRes = await Http.SendAsync(journalReq);
            if (journalRes.IsSuccessStatusCode)
            {
                var json = await journalRes.Content.ReadAsStringAsync();
                journals = JsonSerializer.Deserialize<List<JournalData>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

                totalJournals = journals.Count;
                iraqiJournals = journals.Count(j => j.country != null && j.country.Contains("Iraq", StringComparison.OrdinalIgnoreCase));

                // بما أنه لا يوجد country للمستخدمين، نحسب الدول من المجلات فقط
                var journalCountries = journals.Where(j => !string.IsNullOrWhiteSpace(j.country)).Select(j => j.country.Trim());
                totalCountries = journalCountries.Distinct(StringComparer.OrdinalIgnoreCase).Count();

                var qGroups = journals
                    .Where(j => !string.IsNullOrEmpty(j.quartile))
                    .GroupBy(j => j.quartile.ToUpper())
                    .OrderBy(g => g.Key)
                    .ToList();

                int totalQ = qGroups.Sum(g => g.Count());
                string[] colors = { "#6366F1", "#10B981", "#F59E0B", "#EC4899", "#8B5CF6" };

                quartileStats = qGroups.Select((g, index) => new QuartileStat
                {
                    Key = g.Key,
                    Value = g.Count(),
                    Percentage = totalQ > 0 ? (int)((g.Count() * 100) / totalQ) : 0,
                    Color = colors[index % colors.Length]
                }).ToList();
            }

            // --- تجهيز بيانات الدول (للدائرة) ---
            // نعتمد فقط على دول المجلات لأن المستخدمين لا يملكون حقل دولة
            var allCountries = journals.Where(j => !string.IsNullOrWhiteSpace(j.country))
                .Select(j => j.country.Trim())
                .GroupBy(c => c, StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(g => g.Count())
                .Take(3)
                .ToList();

            int totalC = allCountries.Sum(g => g.Count());
            string[] cColors = { "#10B981", "#6366F1", "#F59E0B" };

            topUserCountries = allCountries.Select((g, index) => new CountryStat
            {
                Name = g.Key,
                Count = g.Count(),
                Percentage = totalC > 0 ? (int)((g.Count() * 100) / totalC) : 0,
                Color = cColors[index % cColors.Length]
            }).ToList();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    // كلاسات مساعدة
    public class UserData
    {
        public string university { get; set; } = "";
        public string specialization { get; set; } = "";
        public string role { get; set; } = "";
    }

    public class JournalData
    {
        public string quartile { get; set; } = "";
        public string country { get; set; } = "";
        public string publisher { get; set; } = "";
    }

    public class QuartileStat
    {
        public string Key { get; set; } = "";
        public int Value { get; set; }
        public int Percentage { get; set; }
        public string Color { get; set; } = "";
    }

    public class CountryStat
    {
        public string Name { get; set; } = "";
        public int Count { get; set; }
        public int Percentage { get; set; }
        public string Color { get; set; } = "";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}