@page "/researchers"
@using System.Text.Json
@inject HttpClient Http

<PageTitle>الباحثون | AI Journal Matcher</PageTitle>

<style>
    .researchers-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #1E293B;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
        }

    .search-bar {
        position: relative;
        width: 350px;
        max-width: 100%;
    }

        .search-bar input {
            width: 100%;
            padding: 12px 40px 12px 15px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.2s;
            box-sizing: border-box;
        }

            .search-bar input:focus {
                outline: none;
                border-color: #6366F1;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

        .search-bar i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
        }

    /* شبكة البطاقات */
    .researchers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
    }

    .researcher-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 25px;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #F1F5F9;
    }

        .researcher-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

    .card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
    }

    .avatar {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 24px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .user-info h3 {
        margin: 0;
        font-size: 18px;
        color: #1E293B;
    }

    .user-info .role {
        font-size: 12px;
        color: #6366F1;
        font-weight: bold;
        text-transform: capitalize;
        margin-top: 3px;
        display: inline-block;
        background: #EEF2FF;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .card-details {
        font-size: 13px;
        color: #475569;
        margin-bottom: 20px;
        line-height: 1.6;
    }

        .card-details p {
            margin: 5px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-details i {
            color: #94A3B8;
            width: 16px;
        }

    .card-links {
        margin-top: auto;
        display: flex;
        gap: 10px;
        border-top: 1px solid #F1F5F9;
        padding-top: 15px;
    }

    .link-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #F8FAFC;
        color: #64748B;
        text-decoration: none;
        transition: all 0.2s;
    }

        .link-btn:hover {
            background: #6366F1;
            color: white;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #94A3B8;
        background: white;
        border-radius: 16px;
        grid-column: 1 / -1;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e2e8f0;
        border-top-color: #6366F1;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="researchers-container">

    <div class="page-header">
        <div>
            <h2>👥 الباحثون المسجلون</h2>
            <p style="color: #64748B; margin: 5px 0 0 0; font-size: 14px;">استعراض وإدارة أعضاء المنصة الأكاديمية</p>
        </div>
        <div class="search-bar">
            <input type="text" placeholder="ابحث بالاسم، الجامعة، أو التخصص..." @bind="searchTerm" @bind:event="oninput" />
            <i class="bi bi-search"></i>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="empty-state">
            <div class="spinner"></div>
            <p>جاري تحميل بيانات الباحثين...</p>
        </div>
    }
    else if (FilteredResearchers.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-people" style="font-size: 50px; color: #CBD5E1; margin-bottom: 15px;"></i>
            <h3>لا يوجد باحثون لعرضهم</h3>
            <p>لم يتم العثور على أي نتائج مطابقة لبحثك.</p>
        </div>
    }
    else
    {
        <div class="researchers-grid">
            @foreach (var user in FilteredResearchers)
            {
                <div class="researcher-card">
                    <div class="card-header">
                        <div class="avatar">
                            @(string.IsNullOrEmpty(user.full_name) ? "?" : user.full_name[0].ToString().ToUpper())
                        </div>
                        <div class="user-info">
                            <h3>@(string.IsNullOrEmpty(user.full_name) ? user.username : user.full_name)</h3>
                            <span class="role">@user.role</span>
                        </div>
                    </div>

                    <div class="card-details">
                        @if (!string.IsNullOrEmpty(user.university))
                        {
                            <p><i class="bi bi-building"></i> @user.university</p>
                        }
                        @if (!string.IsNullOrEmpty(user.specialization))
                        {
                            <p><i class="bi bi-book"></i> @user.specialization</p>
                        }
                        <p><i class="bi bi-envelope"></i> @user.email</p>
                    </div>

                    <!-- روابط التواصل الاجتماعي والأكاديمية -->
                    <div class="card-links">
                        @if (!string.IsNullOrEmpty(user.whatsapp))
                        {
                            <a href="https://wa.me/@FormatPhone(user.whatsapp)" target="_blank" class="link-btn" title="WhatsApp">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(user.google_scholar))
                        {
                            <a href="@user.google_scholar" target="_blank" class="link-btn" title="Google Scholar">
                                <i class="bi bi-google"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(user.orcid))
                        {
                            <a href="https://orcid.org/@user.orcid" target="_blank" class="link-btn" title="ORCID">
                                <i class="bi bi-person-vcard"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(user.researchgate))
                        {
                            <a href="@user.researchgate" target="_blank" class="link-btn" title="ResearchGate">
                                <i class="bi bi-r-square"></i>
                            </a>
                        }
                        <a href="mailto:@user.email" class="link-btn" title="Email">
                            <i class="bi bi-envelope-fill"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string searchTerm = "";
    private List<UserProfile> researchers = new();

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    // فلترة الباحثين بناءً على نص البحث
    private List<UserProfile> FilteredResearchers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
                return researchers;

            var term = searchTerm.ToLower();
            return researchers.Where(r =>
                (r.full_name != null && r.full_name.ToLower().Contains(term)) ||
                (r.username != null && r.username.ToLower().Contains(term)) ||
                (r.university != null && r.university.ToLower().Contains(term)) ||
                (r.specialization != null && r.specialization.ToLower().Contains(term))
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadResearchersAsync();
    }

    private async Task LoadResearchersAsync()
    {
        isLoading = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?select=*&order=created_at.desc");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                researchers = JsonSerializer.Deserialize<List<UserProfile>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading researchers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // تنظيف رقم الهاتف ليفتح الواتساب بشكل صحيح
    private string FormatPhone(string phone)
    {
        if (string.IsNullOrEmpty(phone)) return "";
        var clean = phone.Replace("+", "").Replace(" ", "").Replace("-", "");
        if (clean.StartsWith("0")) clean = "964" + clean.Substring(1);
        return clean;
    }

    // نموذج بيانات المستخدم (يطابق جدول Supabase)
    public class UserProfile
    {
        public long id { get; set; }
        public string username { get; set; } = "";
        public string email { get; set; } = "";
        public string full_name { get; set; } = "";
        public string role { get; set; } = "";
        public string university { get; set; } = "";
        public string specialization { get; set; } = "";
        public string phone { get; set; } = "";
        public string whatsapp { get; set; } = "";
        public string orcid { get; set; } = "";
        public string google_scholar { get; set; } = "";
        public string researchgate { get; set; } = "";
        public string linkedin { get; set; } = "";
        public string bio { get; set; } = "";
    }
}