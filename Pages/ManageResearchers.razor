@page "/manage-researchers"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة الباحثين | AI Journal Matcher</PageTitle>

<style>
    .manage-container {
        padding: 25px;
        background: #F8FAFC;
        min-height: 100vh;
        direction: rtl;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* الهيدر */
    .header-card {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        border-radius: 16px;
        padding: 25px 30px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
    }

    .header-info h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
    }

    .header-info p {
        margin: 5px 0 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .header-user {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* كروت الإحصائيات */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #F1F5F9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-info h3 {
        margin: 0;
        color: #64748B;
        font-size: 13px;
        font-weight: 600;
    }

    .stat-info .number {
        margin: 5px 0 0 0;
        color: #1E293B;
        font-size: 26px;
        font-weight: 800;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    /* لوحة الفلاتر */
    .filter-panel {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #E2E8F0;
        margin-bottom: 25px;
    }

    .filter-row {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: center;
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 250px;
    }

        .search-box input {
            width: 100%;
            padding: 12px 15px 12px 40px;
            border: 1px solid #CBD5E1;
            border-radius: 8px;
            font-size: 14px;
        }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 12px;
            color: #94A3B8;
        }

    .filter-select {
        padding: 12px;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        font-size: 14px;
        min-width: 150px;
        background: white;
    }

    /* الجدول */
    .table-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #E2E8F0;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
    }

    th {
        background: #F8FAFC;
        padding: 15px;
        font-size: 13px;
        font-weight: 700;
        color: #64748B;
        border-bottom: 2px solid #E2E8F0;
    }

    td {
        padding: 15px;
        font-size: 14px;
        color: #1E293B;
        border-bottom: 1px solid #F1F5F9;
        vertical-align: middle;
    }

    tr:hover td {
        background: #F8FAFC;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #EEF2FF;
        color: #6366F1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 16px;
    }

    /* الشارات */
    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .badge-role-admin {
        background: #EEF2FF;
        color: #4338CA;
    }

    .badge-role-developer {
        background: #F3E8FF;
        color: #9333EA;
    }

    .badge-role-researcher {
        background: #F1F5F9;
        color: #475569;
    }

    .badge-status-active {
        background: #DCFCE7;
        color: #166534;
    }

    .badge-status-suspended {
        background: #FEF2F2;
        color: #DC2626;
    }

    .badge-status-pending {
        background: #FEF3C7;
        color: #D97706;
    }

    /* أزرار الإجراءات */
    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        margin-left: 5px;
    }

    .btn-view {
        background: #EFF6FF;
        color: #3B82F6;
    }

        .btn-view:hover {
            background: #3B82F6;
            color: white;
        }

    .btn-edit {
        background: #FFFBEB;
        color: #F59E0B;
    }

        .btn-edit:hover {
            background: #F59E0B;
            color: white;
        }

    .btn-delete {
        background: #FEF2F2;
        color: #EF4444;
    }

        .btn-delete:hover {
            background: #EF4444;
            color: white;
        }

    /* المودال */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 20px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        position: relative;
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #E2E8F0;
    }

    .modal-avatar {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
    }

    .modal-body p {
        margin: 10px 0;
        font-size: 14px;
        color: #475569;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .modal-body i {
        color: #6366F1;
        width: 20px;
        text-align: center;
    }

    .btn-close-modal {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #F1F5F9;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748B;
    }
</style>

<div class="manage-container">
    <!-- الهيدر -->
    <div class="header-card">
        <div class="header-info">
            <h1>👥 إدارة الباحثين</h1>
            <p>عرض، بحث، وتعديل حسابات الباحثين المسجلين في النظام</p>
        </div>
        <div class="header-user">
            <i class="bi bi-person-circle"></i> مرحباً، @currentUserName
        </div>
    </div>

    <!-- كروت الإحصائيات -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-info">
                <h3>إجمالي الباحثين</h3>
                <p class="number">@researchers.Count</p>
            </div>
            <div class="stat-icon" style="background: #EEF2FF; color: #6366F1;"><i class="bi bi-people-fill"></i></div>
        </div>
        <div class="stat-card">
            <div class="stat-info">
                <h3>عدد الجامعات</h3>
                <p class="number">@uniqueUniversities</p>
            </div>
            <div class="stat-icon" style="background: #ECFDF5; color: #10B981;"><i class="bi bi-building"></i></div>
        </div>
        <div class="stat-card">
            <div class="stat-info">
                <h3>عدد التخصصات</h3>
                <p class="number">@uniqueSpecializations</p>
            </div>
            <div class="stat-icon" style="background: #F3E8FF; color: #8B5CF6;"><i class="bi bi-book-half"></i></div>
        </div>
        <div class="stat-card">
            <div class="stat-info">
                <h3>الحسابات النشطة</h3>
                <p class="number">@activeAccountsCount</p>
            </div>
            <div class="stat-icon" style="background: #FFF7ED; color: #F59E0B;"><i class="bi bi-check-circle-fill"></i></div>
        </div>
    </div>

    <!-- لوحة الفلاتر -->
    <div class="filter-panel">
        <div class="filter-row">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="ابحث بالاسم، البريد، الجامعة، أو التخصص..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <select class="filter-select" @bind="filterRole">
                <option value="all">كل الصلاحيات</option>
                <option value="admin">مدير نظام</option>
                <option value="developer">مطور</option>
                <option value="researcher">باحث</option>
            </select>
            <select class="filter-select" @bind="filterStatus">
                <option value="all">كل الحالات</option>
                <option value="active">نشط</option>
                <option value="suspended">موقوف</option>
            </select>
            <button class="btn btn-outline-secondary" @onclick="ResetFilters" style="padding: 10px 15px; border-radius: 8px;">
                <i class="bi bi-arrow-clockwise"></i> مسح الفلاتر
            </button>
        </div>
    </div>

    <!-- الجدول -->
    <div class="table-container">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 50px;">
                <div class="spinner-border text-primary" role="status"></div>
                <p style="margin-top: 15px; color: #64748B;">جاري تحميل البيانات...</p>
            </div>
        }
        else if (!FilteredResearchers.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #94A3B8;">
                <i class="bi bi-people" style="font-size: 60px; display: block; margin-bottom: 20px; opacity: 0.5;"></i>
                <h3 style="color: #475569;">لا يوجد باحثون يطابقون بحثك</h3>
                <p>جرب تغيير كلمات البحث أو الفلاتر.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>الباحث</th>
                        <th>معلومات الاتصال</th>
                        <th>الجامعة / التخصص</th>
                        <th>الصلاحية</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in FilteredResearchers)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div class="user-avatar">@(string.IsNullOrEmpty(user.full_name) ? "?" : user.full_name[0].ToString().ToUpper())</div>
                                    <div>
                                        <div style="font-weight: 700; color: #1E293B;">
                                            @(string.IsNullOrEmpty(user.full_name) ? user.username : user.full_name)
                                            @if (IsCurrentUser(user))
                                            {
                                                <span style="color: #6366F1; font-size: 11px;">(أنت)</span>
                                            }
                                        </div>
                                        <div style="font-size: 12px; color: #64748B;">@user.email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 12px; color: #475569;">
                                    @if (!string.IsNullOrEmpty(user.phone))
                                    {
                                        <div><i class="bi bi-telephone"></i> @user.phone</div>
                                    }
                                    @if (!string.IsNullOrEmpty(user.whatsapp))
                                    {
                                        <div><i class="bi bi-whatsapp" style="color: #25D366;"></i> @user.whatsapp</div>
                                    }
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 13px;">@user.university</div>
                                <div style="font-size: 12px; color: #64748B;">@user.specialization</div>
                            </td>
                            <td>
                                <span class="badge @GetRoleBadgeClass(user.role)">@GetRoleName(user.role)</span>
                            </td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(user)">
                                    @((MarkupString)GetStatusIcon(user)) @GetStatusName(user)
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 5px;">
                                    <button class="action-btn btn-view" @onclick="() => ShowUserDetails(user)" title="عرض التفاصيل">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    @if (IsCurrentUser(user) || currentUserRole == "developer" || currentUserRole == "admin")
                                    {
                                        <button class="action-btn btn-edit" @onclick="() => EditUser(user)" title="تعديل">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (currentUserRole == "developer" || (currentUserRole == "admin" && user.role != "developer"))
                                    {
                                        <button class="action-btn btn-delete" @onclick="() => DeleteUser(user)" title="حذف">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- نافذة تفاصيل الباحث (Modal) -->
@if (selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <button class="btn-close-modal" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>

            <div class="modal-header">
                <div class="modal-avatar">
                    @(string.IsNullOrEmpty(selectedUser.full_name) ? "?" : selectedUser.full_name[0].ToString().ToUpper())
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 20px;">@(string.IsNullOrEmpty(selectedUser.full_name) ? selectedUser.username : selectedUser.full_name)</h3>
                    <span style="color: #6366F1; font-weight: bold; font-size: 13px;">@GetRoleName(selectedUser.role)</span>
                </div>
            </div>

            <div class="modal-body">
                <p><i class="bi bi-envelope-fill"></i> <a href="mailto:@selectedUser.email" style="text-decoration: none; color: #3B82F6;">@selectedUser.email</a></p>
                @if (!string.IsNullOrEmpty(selectedUser.university))
                {
                    <p><i class="bi bi-building"></i> @selectedUser.university</p>
                }
                @if (!string.IsNullOrEmpty(selectedUser.specialization))
                {
                    <p><i class="bi bi-book"></i> @selectedUser.specialization</p>
                }
                @if (!string.IsNullOrEmpty(selectedUser.bio))
                {
                    <p><i class="bi bi-file-text"></i> @selectedUser.bio</p>
                }

                @if (!string.IsNullOrEmpty(selectedUser.whatsapp))
                {
                    <p><i class="bi bi-whatsapp" style="color: #25D366;"></i> <a href="https://wa.me/@FormatPhone(selectedUser.whatsapp)" target="_blank" style="color: #25D366; font-weight: bold; text-decoration: none;">تواصل عبر واتساب</a></p>
                }
                @if (!string.IsNullOrEmpty(selectedUser.orcid))
                {
                    <p><i class="bi bi-person-vcard" style="color: #A6CE39;"></i> <a href="https://orcid.org/@selectedUser.orcid" target="_blank" style="color: #A6CE39; text-decoration: none;">ORCID Profile</a></p>
                }
                @if (!string.IsNullOrEmpty(selectedUser.google_scholar))
                {
                    <p><i class="bi bi-google" style="color: #4285F4;"></i> <a href="@selectedUser.google_scholar" target="_blank" style="color: #4285F4; text-decoration: none;">Google Scholar</a></p>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string searchTerm = "";
    private string filterRole = "all";
    private string filterStatus = "all";
    private List<UserProfile> researchers = new();

    private long currentUserId = 0;
    private string currentUserRole = "researcher";
    private string currentUserName = "";

    private UserProfile? selectedUser = null;

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    // إحصائيات
    private int uniqueUniversities => researchers.Where(r => !string.IsNullOrWhiteSpace(r.university)).Select(r => r.university.ToLower()).Distinct().Count();
    private int uniqueSpecializations => researchers.Where(r => !string.IsNullOrWhiteSpace(r.specialization)).Select(r => r.specialization.ToLower()).Distinct().Count();
    private int activeAccountsCount => researchers.Count(r => r.is_approved && !r.is_suspended);

    private bool IsCurrentUser(UserProfile user) => currentUserId > 0 && user.id == currentUserId;

    private List<UserProfile> FilteredResearchers
    {
        get
        {
            var query = researchers.AsEnumerable();

            // فلترة البحث
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLower();
                query = query.Where(r =>
                    (r.full_name?.ToLower().Contains(term) ?? false) ||
                    (r.username?.ToLower().Contains(term) ?? false) ||
                    (r.email?.ToLower().Contains(term) ?? false) ||
                    (r.university?.ToLower().Contains(term) ?? false) ||
                    (r.specialization?.ToLower().Contains(term) ?? false) ||
                    (r.phone?.Contains(term) ?? false)
                );
            }

            // فلترة الصلاحية
            if (filterRole != "all")
            {
                query = query.Where(r => r.role == filterRole);
            }

            // فلترة الحالة
            if (filterStatus == "active")
            {
                query = query.Where(r => r.is_approved && !r.is_suspended);
            }
            else if (filterStatus == "suspended")
            {
                query = query.Where(r => r.is_suspended || !r.is_approved);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadResearchersAsync();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var savedUserId = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            var savedUserRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
            var savedUserName = await JS.InvokeAsync<string>("localStorage.getItem", "fullName");

            if (long.TryParse(savedUserId, out long parsedId)) currentUserId = parsedId;
            if (!string.IsNullOrEmpty(savedUserRole)) currentUserRole = savedUserRole.ToLower();
            if (!string.IsNullOrEmpty(savedUserName)) currentUserName = savedUserName;
        }
        catch { }
    }

    private async Task LoadResearchersAsync()
    {
        isLoading = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?select=*&order=created_at.desc");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                researchers = JsonSerializer.Deserialize<List<UserProfile>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private void ResetFilters()
    {
        searchTerm = "";
        filterRole = "all";
        filterStatus = "all";
    }

    // دوال مساعدة للعرض
    private string GetRoleName(string role) => role switch
    {
        "developer" => "مطور",
        "admin" => "مدير",
        _ => "باحث"
    };

    private string GetRoleBadgeClass(string role) => role switch
    {
        "developer" => "badge-role-developer",
        "admin" => "badge-role-admin",
        _ => "badge-role-researcher"
    };

    private string GetStatusName(UserProfile u)
    {
        if (u.is_suspended) return "موقوف";
        if (!u.is_approved) return "قيد الانتظار";
        return "نشط";
    }

    private string GetStatusBadgeClass(UserProfile u)
    {
        if (u.is_suspended) return "badge-status-suspended";
        if (!u.is_approved) return "badge-status-pending";
        return "badge-status-active";
    }

    // هذه الدالة ترجع نص HTML، لذلك سنستخدم MarkupString عند العرض
    private string GetStatusIcon(UserProfile u)
    {
        if (u.is_suspended) return "<i class='bi bi-lock-fill'></i>";
        if (!u.is_approved) return "<i class='bi bi-hourglass-split'></i>";
        return "<i class='bi bi-check-circle-fill'></i>";
    }

    private void ShowUserDetails(UserProfile user) => selectedUser = user;
    private void CloseModal() => selectedUser = null;

    private void EditUser(UserProfile user)
    {
        Nav.NavigateTo($"/edit-profile?id={user.id}");
    }

    private async Task DeleteUser(UserProfile user)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف الباحث {user.full_name}؟");
        if (!confirm) return;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"{supabaseUrl}/rest/v1/users?id=eq.{user.id}");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                researchers.Remove(user);
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error deleting: {ex.Message}"); }
    }

    private string FormatPhone(string phone)
    {
        if (string.IsNullOrEmpty(phone)) return "";
        var clean = phone.Replace("+", "").Replace(" ", "").Replace("-", "");
        if (clean.StartsWith("0")) clean = "964" + clean.Substring(1);
        return clean;
    }

