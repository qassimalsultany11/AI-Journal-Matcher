@page "/forgot-password"

@attribute [AllowAnonymous]
@using System.Text.Json
@using System.Text
@using System.Security.Cryptography
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>استعادة كلمة المرور | AI Journal Matcher</PageTitle>

<style>
    .forgot-page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .forgot-card {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .forgot-header {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%);
        padding: 30px 20px;
        text-align: center;
        color: white;
    }

    .forgot-header-icon {
        width: 68px;
        height: 68px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 15px;
        font-size: 30px;
    }

    .forgot-header h2 {
        margin: 0 0 5px 0;
        font-size: 22px;
        font-weight: bold;
    }

    .forgot-header p {
        margin: 0;
        font-size: 12px;
        color: #E0E7FF;
    }

    .forgot-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
        position: relative;
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .form-control {
        width: 100%;
        height: 42px;
        padding: 0 40px;
        font-size: 13px;
        color: #2C3E50;
        background: #F8FAFC;
        border: 1.5px solid #E0E6ED;
        border-radius: 8px;
        transition: all 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366F1;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #94A3B8;
        font-size: 14px;
        pointer-events: none;
    }

    .btn-primary {
        width: 100%;
        height: 46px;
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-primary:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .alert-error {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
        padding: 10px;
        border-radius: 8px;
        font-size: 12px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        border: 1px solid #BBF7D0;
        padding: 10px;
        border-radius: 8px;
        font-size: 12px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="forgot-page-wrapper">
    <div class="forgot-card">
        <div class="forgot-header">
            <div class="forgot-header-icon">
                <i class="bi bi-key"></i>
            </div>
            <h2>استعادة كلمة المرور</h2>
            <p>أدخل بريدك الإلكتروني وكلمة المرور الجديدة</p>
        </div>

        <div class="forgot-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @errorMessage
                </div>
            }

            @if (showSuccess)
            {
                <div class="alert-success">
                    <i class="bi bi-check-circle-fill"></i>
                    تم تغيير كلمة المرور بنجاح! جاري تحويلك...
                </div>
            }

            <div class="form-group">
                <label class="form-label">البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope input-icon"></i>
                    <input type="email" class="form-control" @bind="email" placeholder="أدخل بريدك الإلكتروني" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">كلمة المرور الجديدة</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock input-icon"></i>
                    <input type="password" class="form-control" @bind="newPassword" placeholder="أدخل كلمة المرور الجديدة" />
                </div>
            </div>

            <button class="btn-primary" @onclick="HandleResetPassword" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>جاري التحديث...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>تحديث كلمة المرور</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string newPassword = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private bool showSuccess = false;

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "الرجاء ملء جميع الحقول.";
            return;
        }

        if (newPassword.Length < 6)
        {
            errorMessage = "كلمة المرور يجب أن تكون 6 أحرف على الأقل.";
            return;
        }

        isLoading = true;
        errorMessage = "";
        showSuccess = false;

        try
        {
            // 1. تشفير كلمة المرور الجديدة
            string hashedPassword = HashPassword(newPassword);

            // 2. تحديث كلمة المرور في قاعدة البيانات
            // ملاحظة: في التطبيق الحقيقي، يجب التحقق من ملكية البريد أولاً (عبر OTP)
            var payload = new { password_hash = hashedPassword };
            var content = new StringContent(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json");

            var request = new HttpRequestMessage(HttpMethod.Patch, $"{supabaseUrl}/rest/v1/users?email=eq.{Uri.EscapeDataString(email)}");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            request.Headers.Add("Prefer", "return=representation");
            request.Content = content;

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                // التحقق مما إذا تم تحديث أي صف
                if (json.Trim() != "[]")
                {
                    showSuccess = true;
                    await Task.Delay(2000);
                    Nav.NavigateTo("/login");
                }
                else
                {
                    errorMessage = "البريد الإلكتروني غير مسجل في النظام.";
                }
            }
            else
            {
                errorMessage = "حدث خطأ أثناء تحديث كلمة المرور.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // دالة التشفير (يجب أن تتطابق مع ما تستخدمه في صفحة التسجيل)
    private string HashPassword(string password)
    {
        using (var sha256 = SHA256.Create())
        {
            var hashedBytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(password));
            return Convert.ToBase64String(hashedBytes);
        }

        // ⚠️ إذا كنت تستخدم BCrypt في التسجيل، استخدم هذا السطر بدلاً من الكود أعلاه:
        // return BCrypt.Net.BCrypt.HashPassword(password);
    }
}