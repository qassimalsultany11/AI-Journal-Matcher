@page "/register"

@attribute [AllowAnonymous]
@using System.Text.Json
@using System.Text
@using System.Security.Cryptography
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>إنشاء حساب | AI Journal Matcher</PageTitle>

<style>
    .register-page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    .register-card {
        width: 100%;
        max-width: 900px; /* وسعناها عشان تصير بالعرض */
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .register-header {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%);
        padding: 20px;
        text-align: center;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
    }

    .register-header-icon {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 24px;
    }

    .register-header-text h2 {
        margin: 0;
        font-size: 20px;
        font-weight: bold;
    }

    .register-header-text p {
        margin: 0;
        font-size: 12px;
        color: #E0E7FF;
    }

    .register-body {
        padding: 25px 30px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr; /* عمودين بالعرض */
        gap: 15px 20px;
    }

    .form-group {
        position: relative;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .form-control {
        width: 100%;
        height: 42px;
        padding: 0 35px;
        font-size: 13px;
        color: #2C3E50;
        background: #F8FAFC;
        border: 1.5px solid #E0E6ED;
        border-radius: 8px;
        transition: all 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366F1;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

        /* حالة الحقل الصحيح */
        .form-control.is-valid {
            border-color: #10B981 !important;
            background-image: none;
        }

    .input-icon {
        position: absolute;
        left: 12px;
        color: #94A3B8;
        font-size: 16px;
        pointer-events: none;
    }

        .input-icon.is-valid-icon {
            color: #10B981;
        }

    .btn-toggle-pass {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        color: #94A3B8;
        cursor: pointer;
        font-size: 16px;
        padding: 5px;
    }

        .btn-toggle-pass:hover {
            color: #6366F1;
        }

    /* تصميم اختيار الصلاحية */
    .role-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .role-card {
        border: 2px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        background: #F8FAFC;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .role-card:hover {
            border-color: #CBD5E1;
            background: #F1F5F9;
        }

        .role-card.active {
            border-color: #6366F1;
            background: #EEF2FF;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
        }

        .role-card i {
            font-size: 20px;
            color: #64748B;
        }

        .role-card.active i {
            color: #6366F1;
        }

    .role-card-title {
        font-weight: 700;
        color: #1E293B;
        font-size: 13px;
    }

    .role-card-desc {
        font-size: 10px;
        color: #64748B;
        margin-top: 2px;
    }

    .btn-primary {
        width: 100%;
        height: 48px;
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        margin-top: 20px;
    }

        .btn-primary:hover {
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
            transform: translateY(-1px);
        }

        .btn-primary:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .alert-error, .alert-success {
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
    }

    .alert-error {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
    }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        border: 1px solid #BBF7D0;
    }

    .login-link-container {
        text-align: center;
        margin-top: 20px;
        font-size: 13px;
        color: #64748B;
        border-top: 1px solid #E2E8F0;
        padding-top: 15px;
    }

    .login-link {
        color: #6366F1;
        font-weight: bold;
        text-decoration: none;
    }

        .login-link:hover {
            text-decoration: underline;
        }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .role-cards {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="register-page-wrapper">
    <div class="register-card">
        <div class="register-header">
            <div class="register-header-icon"><i class="bi bi-person-plus"></i></div>
            <div class="register-header-text">
                <h2>إنشاء حساب جديد</h2>
                <p>انضم إلى منصة AI Journal Matcher</p>
            </div>
        </div>

        <div class="register-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error"><i class="bi bi-exclamation-triangle-fill"></i> @errorMessage</div>
            }

            @if (showSuccess)
            {
                <div class="alert-success"><i class="bi bi-check-circle-fill"></i> @successMessage</div>
            }

            <div class="form-grid">
                <!-- نوع الحساب (بعرض كامل) -->
                <div class="form-group full-width">
                    <label class="form-label">اختر نوع الحساب *</label>
                    <div class="role-cards">
                        <div class="role-card @(selectedRole == "researcher" ? "active" : "")" @onclick='() => selectedRole = "researcher"'>
                            <i class="bi bi-person-badge"></i>
                            <div>
                                <div class="role-card-title">باحث</div>
                                <div class="role-card-desc">تصفح النظام، ابحث عن مجلات، وقدم أبحاثك.</div>
                            </div>
                        </div>
                        <div class="role-card @(selectedRole == "admin" ? "active" : "")" @onclick='() => selectedRole = "admin"'>
                            <i class="bi bi-shield-lock"></i>
                            <div>
                                <div class="role-card-title">مدير نظام</div>
                                <div class="role-card-desc">إدارة النظام، المجلات، والتحكم بالصلاحيات. (يتطلب موافقة)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- الاسم الكامل -->
                <div class="form-group">
                    <label class="form-label">الاسم الكامل *</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person input-icon"></i>
                        <input type="text" class="form-control" @bind="fullName" placeholder="مثال: قاسم موسى" />
                    </div>
                </div>

                <!-- اسم المستخدم -->
                <div class="form-group">
                    <label class="form-label">اسم المستخدم *</label>
                    <div class="input-wrapper">
                        <i class="bi bi-at input-icon"></i>
                        <input type="text" class="form-control" @bind="username" placeholder="qasim_m" />
                    </div>
                </div>

                <!-- البريد الإلكتروني -->
                <div class="form-group">
                    <label class="form-label">البريد الإلكتروني *</label>
                    <div class="input-wrapper">
                        <i class="bi @(IsValidEmail(email) ? "bi-envelope-check-fill is-valid-icon" : "bi-envelope") input-icon"></i>
                        <input type="email" class="form-control @(IsValidEmail(email) ? "is-valid" : "")" @bind="email" @bind:event="oninput" placeholder="email@example.com" />
                    </div>
                </div>

                <!-- رقم الواتساب / الهاتف -->
                <div class="form-group">
                    <label class="form-label">رقم الهاتف / الواتساب</label>
                    <div class="input-wrapper">
                        <i class="bi bi-whatsapp input-icon"></i>
                        <input type="tel" class="form-control" value="@whatsapp" @oninput="OnPhoneInput" placeholder="+964 770 000 0000" />
                    </div>
                </div>

                <!-- الجامعة (قائمة منسدلة قابلة للكتابة) -->
                <div class="form-group">
                    <label class="form-label">الجامعة / المؤسسة</label>
                    <div class="input-wrapper">
                        <i class="bi bi-building input-icon"></i>
                        <input type="text" class="form-control" @bind="university" list="universities-list" placeholder="ابحث أو اكتب اسم الجامعة..." />
                        <datalist id="universities-list">
                            <option value="University of Baghdad"></option>
                            <option value="University of Technology"></option>
                            <option value="Al-Mustansiriyah University"></option>
                            <option value="University of Kufa"></option>
                            <option value="University of Basrah"></option>
                            <option value="University of Mosul"></option>
                            <option value="American University of Iraq"></option>
                        </datalist>
                    </div>
                </div>

                <!-- التخصص (قائمة منسدلة قابلة للكتابة) -->
                <div class="form-group">
                    <label class="form-label">التخصص</label>
                    <div class="input-wrapper">
                        <i class="bi bi-book input-icon"></i>
                        <input type="text" class="form-control" @bind="specialization" list="specializations-list" placeholder="ابحث أو اكتب التخصص..." />
                        <datalist id="specializations-list">
                            <option value="Computer Science"></option>
                            <option value="Information Technology"></option>
                            <option value="Software Engineering"></option>
                            <option value="Artificial Intelligence"></option>
                            <option value="Mathematics"></option>
                            <option value="Physics"></option>
                            <option value="Chemistry"></option>
                            <option value="Biology"></option>
                            <option value="Medicine"></option>
                            <option value="Engineering"></option>
                        </datalist>
                    </div>
                </div>

                <!-- كلمة المرور -->
                <div class="form-group">
                    <label class="form-label">كلمة المرور *</label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="@(showPassword ? "text" : "password")" class="form-control" @bind="password" @bind:event="oninput" placeholder="6 أحرف على الأقل" />
                        <button type="button" class="btn-toggle-pass" @onclick="() => showPassword = !showPassword">
                            <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <!-- تأكيد كلمة المرور -->
                <div class="form-group">
                    <label class="form-label">تأكيد كلمة المرور *</label>
                    <div class="input-wrapper">
                        <i class="bi @(IsPasswordMatch() && !string.IsNullOrEmpty(password) ? "bi-shield-check is-valid-icon" : "bi-shield-lock") input-icon"></i>
                        <input type="password" class="form-control @(IsPasswordMatch() && !string.IsNullOrEmpty(password) ? "is-valid" : "")" @bind="confirmPassword" @bind:event="oninput" placeholder="أعد كتابة كلمة المرور" />
                    </div>
                </div>

                <!-- ORCID ID -->
                <div class="form-group">
                    <label class="form-label">ORCID ID</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person-vcard input-icon"></i>
                        <input type="text" class="form-control" value="@orcid" @oninput="OnOrcidInput" maxlength="19" placeholder="0000-0000-0000-0000" />
                    </div>
                </div>
            </div>

            <button class="btn-primary" @onclick="HandleRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>جاري إنشاء الحساب...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>إنشاء الحساب</span>
                }
            </button>

            <div class="login-link-container">
                لديك حساب بالفعل؟ <a href="/login" class="login-link">تسجيل الدخول</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string fullName = "";
    private string username = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string university = "";
    private string specialization = "";
    private string whatsapp = "";
    private string orcid = "";

    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showSuccess = false;
    private string selectedRole = "researcher";

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    // دالة التحقق من تطابق كلمة المرور
    private bool IsPasswordMatch()
    {
        return password == confirmPassword;
    }

    // دالة التحقق من صحة البريد الإلكتروني
    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch { return false; }
    }

    // دالة معالجة إدخال الهاتف (أرقام فقط)
    private void OnPhoneInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        // إبقاء الأرقام وعلامة + فقط
        var filtered = new string(input.Where(c => char.IsDigit(c) || c == '+').ToArray());
        whatsapp = filtered;
    }

    // دالة معالجة إدخال ORCID (إضافة شرطات تلقائية)
    private void OnOrcidInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        // إزالة كل شيء ما عدا الأرقام
        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());

        // إضافة الشرطات كل 4 أرقام
        if (digitsOnly.Length > 4)
        {
            var parts = new List<string>();
            for (int i = 0; i < digitsOnly.Length; i += 4)
            {
                parts.Add(digitsOnly.Substring(i, Math.Min(4, digitsOnly.Length - i)));
            }
            orcid = string.Join("-", parts);
        }
        else
        {
            orcid = digitsOnly;
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = "";
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "الرجاء ملء جميع الحقول الإجبارية (*).";
            return;
        }

        if (!IsValidEmail(email))
        {
            errorMessage = "الرجاء إدخال بريد إلكتروني صحيح.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "كلمتا المرور غير متطابقتين.";
            return;
        }

        if (password.Length < 6)
        {
            errorMessage = "كلمة المرور يجب أن تكون 6 أحرف على الأقل.";
            return;
        }

        isLoading = true;

        try
        {
            // 1. فحص التكرار
            var checkRequest = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?or=(email.eq.{Uri.EscapeDataString(email)},username.eq.{Uri.EscapeDataString(username)})&select=email,username");
            checkRequest.Headers.Add("apikey", supabaseKey);
            checkRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var checkResponse = await Http.SendAsync(checkRequest);
            if (checkResponse.IsSuccessStatusCode)
            {
                var checkJson = await checkResponse.Content.ReadAsStringAsync();
                if (checkJson.Trim() != "[]")
                {
                    errorMessage = "البريد الإلكتروني أو اسم المستخدم مسجل مسبقاً. الرجاء اختيار غيره.";
                    isLoading = false;
                    return;
                }
            }

            // 2. تشفير كلمة المرور
            string hashedPassword = HashPassword(password);

            // 3. تحديد حالة الموافقة (الأدمن يحتاج موافقة، الباحث تلقائي)
            bool isApproved = selectedRole == "researcher";

            // 4. تجهيز البيانات
            var newUser = new
            {
                username = username.Trim(),
                email = email.Trim().ToLower(),
                password_hash = hashedPassword,
                full_name = fullName.Trim(),
                role = selectedRole,
                is_approved = isApproved,
                university = string.IsNullOrWhiteSpace(university) ? null : university.Trim(),
                specialization = string.IsNullOrWhiteSpace(specialization) ? null : specialization.Trim(),
                whatsapp = string.IsNullOrWhiteSpace(whatsapp) ? null : whatsapp.Trim(),
                phone = string.IsNullOrWhiteSpace(whatsapp) ? null : whatsapp.Trim(), // خزناها بالاثنين تحسباً
                orcid = string.IsNullOrWhiteSpace(orcid) ? null : orcid.Trim(),
                profile_completed = false
            };

            var json = JsonSerializer.Serialize(newUser);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            // 5. إرسال البيانات إلى Supabase
            var request = new HttpRequestMessage(HttpMethod.Post, $"{supabaseUrl}/rest/v1/users");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            request.Headers.Add("Prefer", "return=minimal");
            request.Content = content;

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                showSuccess = true;

                if (selectedRole == "admin")
                {
                    successMessage = "تم إرسال طلبك بنجاح! يرجى انتظار موافقة مدير النظام لتتمكن من الدخول.";
                    await Task.Delay(4000);
                }
                else
                {
                    successMessage = "تم إنشاء الحساب بنجاح! جاري تحويلك لتسجيل الدخول...";
                    await Task.Delay(2000);
                }

                Nav.NavigateTo("/login");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                errorMessage = $"حدث خطأ أثناء إنشاء الحساب: {err}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ غير متوقع: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string HashPassword(string password)
    {
        using (var sha256 = SHA256.Create())
        {
            var hashedBytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(password));
            return Convert.ToBase64String(hashedBytes);
        }
    }
}