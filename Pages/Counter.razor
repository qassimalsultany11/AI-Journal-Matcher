@page "/counter"

<PageTitle>لوحة التحكم</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <!-- بطاقة العداد -->
            <div class="card shadow-lg border-0 rounded-4 text-center">
                <div class="card-body p-5">

                    <h3 class="card-title text-muted mb-4">عداد النقاط</h3>

                    <!-- عرض الرقم مع تغيير اللون بناءً على القيمة -->
                    <div class="display-1 fw-bold mb-3 @(GetNumberColor())">
                        @currentCount
                    </div>

                    <!-- شريط التقدم (يتحرك مع الرقم من 0 إلى 100) -->
                    <div class="progress mb-4" style="height: 10px;">
                        <div class="progress-bar @(GetProgressBarColor()) progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             style="width: @(Math.Min(currentCount, 100))%"
                             aria-valuenow="@currentCount"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>

                    <!-- أزرار التحكم -->
                    <div class="d-flex justify-content-center gap-3">
                        <button class="btn btn-danger btn-lg rounded-circle shadow-sm" @onclick="DecrementCount" disabled="@(currentCount <= 0)">
                            <i class="fs-4">−</i>
                        </button>

                        <button class="btn btn-success btn-lg rounded-circle shadow-sm" @onclick="IncrementCount">
                            <i class="fs-4">+</i>
                        </button>
                    </div>

                    <hr class="my-4" />

                    <!-- زر إعادة التعيين -->
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetCount">
                        إعادة تعيين إلى 0
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private void DecrementCount()
    {
        if (currentCount > 0)
        {
            currentCount--;
        }
    }

    private void ResetCount()
    {
        currentCount = 0;
    }

    // دالة لتغيير لون الرقم بناءً على القيمة
    private string GetNumberColor()
    {
        if (currentCount == 0) return "text-secondary";
        if (currentCount > 0 && currentCount < 10) return "text-primary";
        if (currentCount >= 10 && currentCount < 50) return "text-warning";
        return "text-success";
    }

    // دالة لتغيير لون شريط التقدم
    private string GetProgressBarColor()
    {
        if (currentCount < 30) return "bg-info";
        if (currentCount < 70) return "bg-warning";
        return "bg-success";
    }
}