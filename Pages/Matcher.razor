@page "/matcher"
@using System.Text.Json
@using System.Text.RegularExpressions
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>المطابقة الذكية | AI Journal Matcher</PageTitle>

<style>
    /* حاوية الصفحة الرئيسية */
    .matcher-page {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 40px);
        padding: 20px;
        gap: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        box-sizing: border-box;
        background-color: #F8FAFC;
        overflow: hidden; /* يمنع التمرير في الصفحة ككل */
    }

    /* التخطيط العلوي (عمودين) - مساحة أكبر */
    .top-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        flex: 1.3; /* مساحة أكبر للجزء العلوي */
        min-height: 380px; /* حد أدنى أكبر */
    }

    /* الكارت الأساسي */
    .card {
        background: white;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .card-header {
        padding: 15px 20px;
        border-bottom: 1px solid #E2E8F0;
        background: #F8FAFC;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

        .card-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            color: #1E293B;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* --- القسم الأيمن: الإدخال --- */
    .input-section {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow: hidden;
    }

    .textarea-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-bottom: 15px;
        min-height: 120px;
    }

        .textarea-wrapper textarea {
            flex: 1;
            width: 100%;
            padding: 15px;
            border: 2px solid #E2E8F0;
            border-radius: 12px;
            resize: none;
            font-family: inherit;
            font-size: 14px;
            line-height: 1.6;
            color: #1E293B;
            background: #F8FAFC;
            transition: all 0.2s;
        }

            .textarea-wrapper textarea:focus {
                outline: none;
                border-color: #6366F1;
                background: white;
                box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
            }

    .word-count {
        position: absolute;
        bottom: 10px;
        left: 12px;
        font-size: 12px;
        color: #64748B;
        background: rgba(255,255,255,0.9);
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: bold;
    }

    /* أدوات الإدخال السفلية - ثابتة 100% */
    .input-bottom-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex-shrink: 0; /* يمنع الاختفاء */
    }

    .keywords-container {
        height: 40px;
        overflow-y: auto;
        padding: 6px;
        background: #F8FAFC;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-content: flex-start;
    }

        .keywords-container::-webkit-scrollbar {
            width: 4px;
        }

        .keywords-container::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }

    .keyword-tag {
        background: #EEF2FF;
        color: #6366F1;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .example-chips {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .chip-btn {
        background: white;
        color: #475569;
        border: 1px solid #E2E8F0;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .chip-btn:hover {
            background: #F1F5F9;
            color: #1E293B;
            border-color: #CBD5E1;
        }

    .action-bar {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex: 1;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(99, 102, 241, 0.4);
        }

        .btn-primary:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

    .btn-clear {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 15px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-clear:hover {
            background: #FEE2E2;
        }

    /* --- القسم الأيسر: التفاصيل --- */
    .details-section {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow: hidden;
    }

    .empty-details {
        text-align: center;
        color: #94A3B8;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

        .empty-details i {
            font-size: 40px;
            color: #CBD5E1;
        }

    .details-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
        background: #F8FAFC;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        flex-shrink: 0;
    }

        .details-top-bar h4 {
            margin: 0 0 5px 0;
            font-size: 18px;
            color: #1E293B;
            line-height: 1.3;
            font-weight: 800;
        }

        .details-top-bar p {
            margin: 0;
            font-size: 13px;
            color: #64748B;
        }

    .badge-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
    }

    .score-badge-top {
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 14px;
        color: white;
    }

    .acceptance-badge {
        font-size: 12px;
        color: #64748B;
        font-weight: 700;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 10px;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .detail-box {
        background: white;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #E2E8F0;
        text-align: center;
    }

        .detail-box label {
            display: block;
            font-size: 11px;
            color: #64748B;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .detail-box span {
            font-size: 14px;
            font-weight: 800;
            color: #1E293B;
        }

    .detail-scope-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        margin-bottom: 15px;
    }

    .detail-scope {
        font-size: 13px;
        color: #475569;
        line-height: 1.6;
        background: #F8FAFC;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid #E2E8F0;
        overflow-y: auto;
        flex: 1;
    }

        .detail-scope::-webkit-scrollbar {
            width: 6px;
        }

        .detail-scope::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 6px;
        }

    /* زر الزيارة - سيظهر دائماً إذا كانت المجلة مختارة */
    .visit-btn-container {
        flex-shrink: 0;
        margin-top: auto;
    }

        .visit-btn-container a {
            width: 100%;
            text-decoration: none;
            background: #6366F1;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            font-weight: bold;
            font-size: 14px;
            transition: all 0.2s;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
        }

            .visit-btn-container a:hover {
                background: #4F46E5;
                box-shadow: 0 6px 15px rgba(99, 102, 241, 0.4);
            }

    /* --- الجزء السفلي: الجدول --- */
    .bottom-row {
        flex: 1; /* مساحة أقل من الجزء العلوي */
        display: flex;
        min-height: 200px;
    }

    .table-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .table-scroll {
        flex: 1;
        overflow-y: auto;
        position: relative;
    }

        .table-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 8px;
        }

            .table-scroll::-webkit-scrollbar-thumb:hover {
                background: #94A3B8;
            }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
    }

    th {
        background: #F8FAFC;
        padding: 14px 15px;
        font-size: 13px;
        font-weight: 800;
        color: #64748B;
        border-bottom: 2px solid #E2E8F0;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    td {
        padding: 12px 15px;
        font-size: 13.5px;
        border-bottom: 1px solid #F1F5F9;
        cursor: pointer;
        transition: background 0.2s;
        color: #1E293B;
    }

    tr:hover td {
        background: #F8FAFC;
    }

    tr.selected td {
        background: #EEF2FF;
        border-right: 4px solid #6366F1;
    }

    .score-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 800;
        font-size: 12px;
        display: inline-block;
        color: white;
    }

    /* استجابة الشاشات الصغيرة */
    @@media (max-width: 1100px) {
        .matcher-page {
            height: auto;
            overflow: auto;
        }

        .top-row {
            grid-template-columns: 1fr;
            min-height: 400px;
        }

        .bottom-row {
            height: 500px;
            flex: none;
        }

        .details-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="matcher-page">

    <!-- الجزء العلوي: الإدخال + التفاصيل -->
    <div class="top-row">

        <!-- الإدخال -->
        <div class="card">
            <div class="card-header">
                <h3>📝 إدخال المستخلص (Abstract)</h3>
                <span style="font-size: 12px; color: #64748B; font-weight: bold;">@statusMessage</span>
            </div>
            <div class="input-section">

                <div class="textarea-wrapper">
                    <textarea placeholder="الصق مستخلص البحث هنا..." @bind="abstractText" @bind:event="oninput"></textarea>
                    <div class="word-count">@WordCount words</div>
                </div>

                <!-- أدوات الإدخال السفلية (ثابتة) -->
                <div class="input-bottom-actions">
                    @if (extractedKeywords.Count > 0)
                    {
                        <div class="keywords-container">
                            @foreach (var kw in extractedKeywords)
                            {
                                <span class="keyword-tag">@kw</span>
                            }
                        </div>
                    }

                    <div class="example-chips">
                        <button class="chip-btn" @onclick="() => SetExample(PoultryExample)">🐔 Poultry</button>
                        <button class="chip-btn" @onclick="() => SetExample(DairyExample)">🥛 Dairy</button>
                        <button class="chip-btn" @onclick="() => SetExample(SoilExample)">🌱 Soil</button>
                        <button class="chip-btn" @onclick="() => SetExample(BiotechExample)">🧬 Biotech</button>
                    </div>

                    <div class="action-bar">
                        <button class="btn-clear" @onclick="ClearAll">مسح</button>
                        <button class="btn-primary" @onclick="RunMatch" disabled="@isMatching">
                            @if (isMatching)
                            {
                                <span>⏳ جاري...</span>
                            }
                            else
                            {

                                <span>🚀 تحليل</span>
                            }
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- التفاصيل -->
        <div class="card">
            <div class="card-header">
                <h3>📊 تفاصيل المجلة</h3>
            </div>

            <div class="details-section">
                @if (selectedJournal == null)
                {
                    <div class="empty-details">
                        <i class="bi bi-journal-text"></i>
                        <h4 style="color: #475569; font-size: 16px;">لم يتم اختيار مجلة</h4>
                        <p style="font-size: 13px;">انقر على أي مجلة في الجدول لعرض تفاصيلها.</p>
                    </div>
                }
                else
                {
                    <div class="details-top-bar">
                        <div>
                            <h4>@selectedJournal.name</h4>
                            <p>@selectedJournal.publisher</p>
                        </div>
                        <div class="badge-group">
                            <div class="score-badge-top" style="background: @GetScoreColor(selectedJournal.MatchScore);">
                                التطابق: @selectedJournal.MatchScore%
                            </div>
                            <div class="acceptance-badge">القبول: @selectedJournal.acceptance_rate</div>
                        </div>
                    </div>

                    <div class="details-grid">
                        <div class="detail-box"><label>الربع</label><span>@selectedJournal.quartile</span></div>
                        <div class="detail-box"><label>التأثير</label><span>@selectedJournal.impact_factor</span></div>
                        <div class="detail-box"><label>الدولة</label><span>@selectedJournal.country</span></div>
                        <div class="detail-box"><label>سرعة النشر</label><span>@selectedJournal.publication_speed</span></div>
                    </div>

                    <div class="detail-scope-wrapper">
                        <label style="display:block; font-size: 11px; color: #94A3B8; font-weight: 800; margin-bottom: 6px;">نطاق المجلة (Scope):</label>
                        <div class="detail-scope">
                            @selectedJournal.scope
                        </div>
                    </div>

                    <!-- زر الزيارة (موجود وثابت) -->
                    <div class="visit-btn-container">
                        @if (!string.IsNullOrEmpty(selectedJournal.website_url))
                        {
                            <a href="@selectedJournal.website_url" target="_blank">
                                <i class="bi bi-globe"></i> زيارة موقع المجلة
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- الجزء السفلي: الجدول -->
    <div class="bottom-row">
        <div class="card table-container">
            <div class="card-header">
                <h3>🏆 المجلات المقترحة</h3>
                <span style="font-size: 12px; color: #64748B; font-weight: bold;">@matchedResults.Count نتيجة</span>
            </div>

            <div class="table-scroll">
                @if (matchedResults.Count == 0)
                {
                    <div class="empty-details" style="margin-top: 40px;">
                        <i class="bi bi-search"></i>
                        <h4 style="color: #475569; font-size: 15px;">لا توجد نتائج حالياً</h4>
                        <p style="font-size: 13px;">قم بإدخال النص والضغط على "تحليل" لتظهر النتائج هنا.</p>
                    </div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>اسم المجلة</th>
                                <th>الناشر</th>
                                <th>الدولة</th>
                                <th>الربع</th>
                                <th>التأثير</th>
                                <th style="text-align: center;">التطابق</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var journal in matchedResults)
                            {
                                <tr class="@(selectedJournal == journal ? "selected" : "")" @onclick="() => SelectJournal(journal)">
                                    <td style="font-weight: 700;">@journal.name</td>
                                    <td style="color: #64748B;">@journal.publisher</td>
                                    <td style="color: #64748B;">@journal.country</td>
                                    <td><span style="background: #F1F5F9; padding: 3px 8px; border-radius: 6px; font-size: 12px; font-weight: 800; color: #475569;">@journal.quartile</span></td>
                                    <td style="font-weight: 800; color: #1E293B;">@journal.impact_factor</td>
                                    <td style="text-align: center;">
                                        <span class="score-badge" style="background: @GetScoreColor(journal.MatchScore);">@journal.MatchScore%</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string abstractText = "";
    private bool isMatching = false;
    private string statusMessage = "جاهز";

    private List<string> extractedKeywords = new();
    private List<MatchedJournal> matchedResults = new();
    private MatchedJournal? selectedJournal;

    private List<Journal> allJournals = new();

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    private static readonly HashSet<string> StopWords = new(StringComparer.OrdinalIgnoreCase)
    {
        "the", "a", "an", "and", "or", "of", "in", "on", "at", "to", "for",
        "with", "by", "from", "as", "is", "are", "was", "were", "be", "been",
        "this", "that", "these", "those", "it", "its", "their", "our",
        "we", "us", "you", "your", "they", "them", "he", "she", "his", "her",
        "which", "who", "whom", "whose", "what", "when", "where", "why", "how",
        "can", "could", "would", "should", "may", "might", "must", "shall", "will",
        "have", "has", "had", "do", "does", "did", "not", "no", "but", "if",
        "then", "than", "so", "such", "also", "more", "most", "some", "any",
        "all", "each", "every", "both", "few", "many", "much", "other", "another",
        "into", "onto", "upon", "about", "over", "under", "between", "through",
        "using", "used", "use", "based", "show", "shows", "shown", "study",
        "studies", "result", "results", "data", "however", "therefore"
    };

    private const string PoultryExample = "This study investigates the effects of different dietary protein levels on broiler chicken growth performance, feed efficiency, and carcass characteristics. A total of 240 one-day-old chicks were randomly assigned to four treatments. Results showed that increasing protein levels significantly improved body weight gain and feed conversion ratio.";
    private const string DairyExample = "The objective of this research was to evaluate the impact of heat stress on dairy cow milk production and reproductive performance. Data were collected from 150 Holstein cows during summer months. Milk yield decreased significantly when temperature-humidity index exceeded 72. Nutritional interventions were tested.";
    private const string SoilExample = "This research focuses on soil fertility management and the role of beneficial microorganisms in enhancing crop yields. We analyzed soil samples from agricultural fields and evaluated microbial diversity using next-generation sequencing. Results indicate that organic amendments significantly increase soil organic carbon and microbial biomass.";
    private const string BiotechExample = "This study explores the application of CRISPR-Cas9 gene editing technology in improving drought tolerance in wheat crops. We targeted specific transcription factors and evaluated the physiological responses of edited plants under water-deficit conditions. The results demonstrate enhanced water use efficiency and improved yield stability.";

    protected override async Task OnInitializedAsync()
    {
        await LoadJournalsAsync();
    }

    private async Task LoadJournalsAsync()
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=*");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                allJournals = JsonSerializer.Deserialize<List<Journal>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                statusMessage = $"تم تحميل {allJournals.Count} مجلة";
            }
        }
        catch (Exception ex) { statusMessage = $"خطأ: {ex.Message}"; }
    }

    private int WordCount => string.IsNullOrWhiteSpace(abstractText) ? 0 : abstractText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;

    private void SetExample(string text)
    {
        abstractText = text;
        ClearResults();
    }

    private void ClearAll()
    {
        abstractText = "";
        ClearResults();
        statusMessage = "تم المسح. جاهز.";
    }

    private void ClearResults()
    {
        extractedKeywords.Clear();
        matchedResults.Clear();
        selectedJournal = null;
    }

    private void SelectJournal(MatchedJournal journal)
    {
        selectedJournal = journal;
    }

    private string GetScoreColor(int score)
    {
        if (score >= 70) return "#10B981";
        if (score >= 40) return "#F59E0B";
        return "#EF4444";
    }

    private void RunMatch()
    {
        if (string.IsNullOrWhiteSpace(abstractText)) { statusMessage = "الرجاء لصق مستخلص البحث أولاً."; return; }
        if (allJournals.Count == 0) { statusMessage = "لا توجد مجلات محملة."; return; }

        isMatching = true;
        statusMessage = "جاري تحليل النص...";

        extractedKeywords = ExtractKeywords(abstractText);
        matchedResults = ComputeMatches(extractedKeywords, abstractText);

        if (matchedResults.Count > 0) selectedJournal = matchedResults.First();

        statusMessage = $"تم العثور على {matchedResults.Count} مجلة.";
        isMatching = false;
    }

    private List<string> ExtractKeywords(string text)
    {
        var words = Regex.Matches(text.ToLowerInvariant(), @"\b[a-z][a-z\-]+\b")
            .Cast<Match>().Select(m => m.Value).Where(w => w.Length >= 3).Where(w => !StopWords.Contains(w)).ToList();

        var counts = words.GroupBy(w => w).ToDictionary(g => g.Key, g => g.Count());
        return counts.OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key).Take(20).Select(kv => kv.Key).ToList();
    }

    private List<MatchedJournal> ComputeMatches(List<string> keywords, string abstractText)
    {
        var text = abstractText.ToLowerInvariant();
        var results = new List<MatchedJournal>();

        foreach (var journal in allJournals)
        {
            int score = 0;
            int maxScore = 0;

            if (journal.keywords != null && journal.keywords.Length > 0)
            {
                foreach (var jk in journal.keywords)
                {
                    maxScore += 10;
                    if (keywords.Any(k => k.Contains(jk.ToLowerInvariant()) || jk.ToLowerInvariant().Contains(k))) score += 10;
                }
            }

            if (!string.IsNullOrWhiteSpace(journal.scope))
            {
                maxScore += 15;
                var scopeWords = journal.scope.ToLowerInvariant().Split(new[] { ' ', ',', '&' }, StringSplitOptions.RemoveEmptyEntries);
                if (scopeWords.Any(sw => text.Contains(sw) && sw.Length >= 4)) score += 15;
            }

            if (!string.IsNullOrWhiteSpace(journal.name))
            {
                maxScore += 5;
                var nameWords = journal.name.ToLowerInvariant().Split(new[] { ' ', '&' }, StringSplitOptions.RemoveEmptyEntries);
                if (nameWords.Any(nw => text.Contains(nw) && nw.Length >= 4)) score += 5;
            }

            maxScore += 5;
            if (journal.quartile == "Q1") score += 5; else if (journal.quartile == "Q2") score += 3;

            int percentage = maxScore > 0 ? (int)Math.Round((double)score / maxScore * 100) : 0;

            if (percentage > 0)
            {
                results.Add(new MatchedJournal
                {
                    id = journal.id,
                    name = journal.name,
                    publisher = journal.publisher,
                    country = journal.country,
                    quartile = journal.quartile,
                    impact_factor = journal.impact_factor,
                    scope = journal.scope,
                    website_url = journal.website_url,
                    acceptance_rate = journal.acceptance_rate,
                    publication_speed = journal.publication_speed,
                    keywords = journal.keywords,
                    MatchScore = percentage
                });
            }
        }

        return results.OrderByDescending(r => r.MatchScore).ThenByDescending(r => r.impact_factor).ToList();
    }

    public class Journal
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string country { get; set; } = "";
        public string quartile { get; set; } = "";
        public double? impact_factor { get; set; }
        public string scope { get; set; } = "";
        public string website_url { get; set; } = "";
        public string acceptance_rate { get; set; } = "";
        public string publication_speed { get; set; } = "";
        public string[]? keywords { get; set; }
    }

    public class MatchedJournal : Journal
    {
        public int MatchScore { get; set; }
    }
}