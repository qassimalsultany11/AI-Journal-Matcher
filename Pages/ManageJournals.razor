@page "/manage-journals"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة المجلات | AI Journal Matcher</PageTitle>

<style>
    .manage-container {
        padding: 25px;
        background: #F8FAFC;
        min-height: 100vh;
        direction: rtl;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* الهيدر */
    .header-card {
        background: linear-gradient(135deg, #0EA5E9 0%, #6366F1 100%); /* ألوان مختلفة عن صفحة الباحثين */
        border-radius: 16px;
        padding: 25px 30px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(14, 165, 233, 0.3);
    }

    .header-info h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
    }

    .header-info p {
        margin: 5px 0 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .header-user {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* كروت الإحصائيات */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #F1F5F9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-info h3 {
        margin: 0;
        color: #64748B;
        font-size: 13px;
        font-weight: 600;
    }

    .stat-info .number {
        margin: 5px 0 0 0;
        color: #1E293B;
        font-size: 26px;
        font-weight: 800;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    /* لوحة الفلاتر */
    .filter-panel {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #E2E8F0;
        margin-bottom: 25px;
    }

    .filter-row {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: center;
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 250px;
    }

        .search-box input {
            width: 100%;
            padding: 12px 15px 12px 40px;
            border: 1px solid #CBD5E1;
            border-radius: 8px;
            font-size: 14px;
        }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 12px;
            color: #94A3B8;
        }

    .filter-select {
        padding: 12px;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        font-size: 14px;
        min-width: 150px;
        background: white;
    }

    .btn-filter-toggle {
        padding: 12px 20px;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        background: white;
        color: #475569;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-filter-toggle.active {
            background: #6366F1;
            color: white;
            border-color: #6366F1;
        }

    /* الفلاتر النشطة (Chips) */
    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #F1F5F9;
    }

    .filter-chip {
        background: #EEF2FF;
        color: #4338CA;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .filter-chip button {
            background: #C7D2FE;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #4338CA;
            font-size: 10px;
        }

    /* الجدول */
    .table-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #E2E8F0;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
    }

    th {
        background: #F8FAFC;
        padding: 15px;
        font-size: 13px;
        font-weight: 700;
        color: #64748B;
        border-bottom: 2px solid #E2E8F0;
        white-space: nowrap;
    }

    td {
        padding: 15px;
        font-size: 14px;
        color: #1E293B;
        border-bottom: 1px solid #F1F5F9;
        vertical-align: middle;
    }

    tr:hover td {
        background: #F8FAFC;
    }

    /* الشارات */
    .badge-q {
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
    }

    .q1 {
        background: #DCFCE7;
        color: #166534;
    }

    .q2 {
        background: #DBEAFE;
        color: #1E40AF;
    }

    .q3 {
        background: #FEF3C7;
        color: #92400E;
    }

    .q4 {
        background: #FEE2E2;
        color: #991B1B;
    }

    /* أزرار الإجراءات */
    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        margin-left: 5px;
        text-decoration: none;
    }

    .btn-visit {
        background: #ECFDF5;
        color: #10B981;
    }

        .btn-visit:hover {
            background: #10B981;
            color: white;
        }

    .btn-edit {
        background: #EFF6FF;
        color: #3B82F6;
    }

        .btn-edit:hover:not(:disabled) {
            background: #3B82F6;
            color: white;
        }

    .btn-delete {
        background: #FEF2F2;
        color: #EF4444;
    }

        .btn-delete:hover:not(:disabled) {
            background: #EF4444;
            color: white;
        }

    .action-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    /* المودال */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 20px;
        width: 90%;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 25px;
    }

    .btn-cancel, .btn-confirm {
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        flex: 1;
    }

    .btn-cancel {
        background: #F1F5F9;
        color: #475569;
    }

    .btn-confirm {
        background: #EF4444;
        color: white;
    }
</style>

<div class="manage-container">
    <!-- الهيدر -->
    <div class="header-card">
        <div class="header-info">
            <h1>📚 إدارة المجلات</h1>
            <p>عرض، فلترة، تعديل، وحذف المجلات الأكاديمية</p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="/add-journal" style="background: white; color: #6366F1; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-plus-circle"></i> إضافة مجلة
            </a>
            <div class="header-user">
                <i class="bi bi-person-circle"></i> @currentUserName
            </div>
        </div>
    </div>

    <!-- كروت الإحصائيات -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-info">
                <h3>إجمالي المجلات</h3>
                <p class="number">@journals.Count</p>
            </div>
            <div class="stat-icon" style="background: #EEF2FF; color: #6366F1;"><i class="bi bi-journals"></i></div>
        </div>
        <div class="stat-card">
            <div class="stat-info">
                <h3>مجلات Q1</h3>
                <p class="number">@journals.Count(j => j.quartile?.ToUpper() == "Q1")</p>
            </div>
            <div class="stat-icon" style="background: #DCFCE7; color: #10B981;"><i class="bi bi-trophy"></i></div>
        </div>
        <div class="stat-card">
            <div class="stat-info">
                <h3>متوسط معامل التأثير</h3>
                <p class="number">@averageImpact.ToString("0.00")</p>
            </div>
            <div class="stat-icon" style="background: #FFF7ED; color: #F59E0B;"><i class="bi bi-graph-up-arrow"></i></div>
        </div>
        <div class="stat-card">
            <div class="stat-info">
                <h3>عدد الناشرين</h3>
                <p class="number">@uniquePublishers</p>
            </div>
            <div class="stat-icon" style="background: #F3E8FF; color: #8B5CF6;"><i class="bi bi-building"></i></div>
        </div>
    </div>

    <!-- لوحة الفلاتر -->
    <div class="filter-panel">
        <div class="filter-row">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="ابحث بالاسم، الناشر، أو الدولة..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <button class="btn-filter-toggle @(showFilters ? "active" : "")" @onclick="() => showFilters = !showFilters">
                <i class="bi bi-sliders2"></i> فلاتر متقدمة
                @if (ActiveFiltersCount > 0)
                {
                    <span style="background: #EF4444; color: white; border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">@ActiveFiltersCount</span>
                }
            </button>
        </div>

        @if (showFilters)
        {
            <div style="margin-top: 15px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                <div>
                    <label style="font-size: 12px; font-weight: bold; color: #64748B;">الناشر</label>
                    <input type="text" class="filter-select" style="width: 100%;" @bind="filterPublisher" @bind:event="oninput" />
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: bold; color: #64748B;">الدولة</label>
                    <select class="filter-select" style="width: 100%;" @bind="filterCountry">
                        <option value="">كل الدول</option>
                        @foreach (var c in AvailableCountries)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: bold; color: #64748B;">الربع</label>
                    <select class="filter-select" style="width: 100%;" @bind="filterQuartile">
                        <option value="">الكل</option>
                        <option value="Q1">Q1</option>
                        <option value="Q2">Q2</option>
                        <option value="Q3">Q3</option>
                        <option value="Q4">Q4</option>
                    </select>
                </div>
            </div>
        }

        @if (ActiveFiltersCount > 0)
        {
            <div class="active-filters">
                @if (!string.IsNullOrWhiteSpace(filterPublisher))
                {
                    <div class="filter-chip">الناشر: @filterPublisher <button @onclick="() => filterPublisher = string.Empty"><i class="bi bi-x"></i></button></div>
                }
                @if (!string.IsNullOrWhiteSpace(filterCountry))
                {
                    <div class="filter-chip">الدولة: @filterCountry <button @onclick="() => filterCountry = string.Empty"><i class="bi bi-x"></i></button></div>
                }
                @if (!string.IsNullOrWhiteSpace(filterQuartile))
                {
                    <div class="filter-chip">الربع: @filterQuartile <button @onclick="() => filterQuartile = string.Empty"><i class="bi bi-x"></i></button></div>
                }
                <button style="background: transparent; border: 1px solid #FECACA; color: #DC2626; padding: 5px 12px; border-radius: 20px; cursor: pointer; font-size: 12px;" @onclick="ClearAllFilters">مسح الكل</button>
            </div>
        }
    </div>

    <!-- الجدول -->
    <div class="table-container">
        @if (isLoading)
        {
            <div style="text-align: center; padding: 50px;"><div class="spinner-border text-primary"></div><p>جاري التحميل...</p></div>
        }
        else if (!FilteredJournals.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: #94A3B8;">
                <i class="bi bi-journal-x" style="font-size: 60px; opacity: 0.5; display: block; margin-bottom: 20px;"></i>
                <h3 style="color: #475569;">لا توجد مجلات لعرضها</h3>
                <p>جرب تغيير الفلاتر أو البحث.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>اسم المجلة</th>
                        <th>الناشر</th>
                        <th>الدولة</th>
                        <th>الربع</th>
                        <th>معامل التأثير</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var journal in FilteredJournals)
                    {
                        <tr>
                            <td style="font-weight: 700; max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@journal.name">@journal.name</td>
                            <td style="color: #64748B;">@journal.publisher</td>
                            <td style="color: #64748B;">@journal.country</td>
                            <td>
                                <span class="badge-q @GetQuartileClass(journal.quartile)">@journal.quartile</span>
                            </td>
                            <td style="font-weight: 800; color: #0F172A;">@journal.impact_factor</td>
                            <td>
                                <div style="display: flex; gap: 5px;">
                                    @if (!string.IsNullOrEmpty(journal.website_url))
                                    {
                                        <a href="@journal.website_url" target="_blank" class="action-btn btn-visit" title="زيارة الموقع"><i class="bi bi-globe"></i></a>
                                    }
                                    else
                                    {
                                        <button class="action-btn btn-visit" disabled><i class="bi bi-globe"></i></button>
                                    }
                                    <button class="action-btn btn-edit" @onclick="() => EditJournal(journal.id)" title="تعديل" disabled="@(!CanUserEdit(journal))"><i class="bi bi-pencil-square"></i></button>
                                    <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(journal)" title="حذف" disabled="@(!CanUserEdit(journal))"><i class="bi bi-trash-fill"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- مودال الحذف -->
@if (journalToDelete != null)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <i class="bi bi-exclamation-triangle-fill" style="color: #EF4444; font-size: 48px; margin-bottom: 15px; display: block;"></i>
            <h3 style="margin: 0 0 10px 0;">تأكيد الحذف</h3>
            <p style="color: #64748B; font-size: 14px; margin-bottom: 20px;">هل أنت متأكد من حذف مجلة <strong>@journalToDelete.name</strong>؟</p>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => journalToDelete = null">إلغاء</button>
                <button class="btn-confirm" @onclick="DeleteJournal">نعم، احذف</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showFilters = false;

    private string searchTerm = "";
    private string filterPublisher = "";
    private string filterCountry = "";
    private string filterQuartile = "";
    private string sortBy = "id-desc";

    private List<Journal> journals = new();
    private Journal? journalToDelete = null;
    private List<string> AvailableCountries = new();

    private string currentUserName = "المستخدم";
    private string currentUsername = "";
    private string currentUserRole = "researcher";

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    // إحصائيات
    private double averageImpact => journals.Where(j => j.impact_factor.HasValue).Any() ? journals.Where(j => j.impact_factor.HasValue).Average(j => j.impact_factor!.Value) : 0;
    private int uniquePublishers => journals.Where(j => !string.IsNullOrWhiteSpace(j.publisher)).Select(j => j.publisher.ToLower()).Distinct().Count();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadJournalsAsync();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var savedUsername = await JS.InvokeAsync<string>("localStorage.getItem", "username");
            var savedUserRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
            var savedFullName = await JS.InvokeAsync<string>("localStorage.getItem", "fullName");

            if (!string.IsNullOrEmpty(savedUsername)) currentUsername = savedUsername.Trim().ToLower();
            if (!string.IsNullOrEmpty(savedUserRole)) currentUserRole = savedUserRole.ToLower();
            if (!string.IsNullOrEmpty(savedFullName)) currentUserName = savedFullName;
        }
        catch { }
    }

    private bool CanUserEdit(Journal journal)
    {
        if (currentUserRole == "admin" || currentUserRole == "developer") return true;
        if (string.IsNullOrWhiteSpace(journal.added_by)) return false;
        return journal.added_by.Trim().ToLower() == currentUsername;
    }

    private int ActiveFiltersCount
    {
        get
        {
            int count = 0;
            if (!string.IsNullOrWhiteSpace(filterPublisher)) count++;
            if (!string.IsNullOrWhiteSpace(filterCountry)) count++;
            if (!string.IsNullOrWhiteSpace(filterQuartile)) count++;
            return count;
        }
    }

    private List<Journal> FilteredJournals
    {
        get
        {
            var query = journals.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(j => (j.name?.ToLower().Contains(term) ?? false) || (j.publisher?.ToLower().Contains(term) ?? false) || (j.country?.ToLower().Contains(term) ?? false));
            }
            if (!string.IsNullOrWhiteSpace(filterPublisher)) { var p = filterPublisher.Trim().ToLower(); query = query.Where(j => j.publisher?.ToLower().Contains(p) ?? false); }
            if (!string.IsNullOrWhiteSpace(filterCountry)) { var c = filterCountry.Trim().ToLower(); query = query.Where(j => j.country?.ToLower().Contains(c) ?? false); }
            if (!string.IsNullOrWhiteSpace(filterQuartile)) query = query.Where(j => string.Equals(j.quartile, filterQuartile, StringComparison.OrdinalIgnoreCase));

            return query.OrderByDescending(j => j.id).ToList();
        }
    }

    private async Task LoadJournalsAsync()
    {
        isLoading = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=*&order=id.desc");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                journals = JsonSerializer.Deserialize<List<Journal>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                AvailableCountries = journals.Select(j => j.country).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList();
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private string GetQuartileClass(string? quartile) => quartile?.ToUpper() switch
    {
        "Q1" => "q1",
        "Q2" => "q2",
        "Q3" => "q3",
        "Q4" => "q4",
        _ => "q4"
    };

    private void ClearAllFilters()
    {
        filterPublisher = "";
        filterCountry = "";
        filterQuartile = "";
    }

    private void EditJournal(long id) => Nav.NavigateTo($"/add-journal?id={id}");

    private void ConfirmDelete(Journal journal) => journalToDelete = journal;

    private async Task DeleteJournal()
    {
        if (journalToDelete == null) return;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"{supabaseUrl}/rest/v1/journals?id=eq.{journalToDelete.id}");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) { journals.Remove(journalToDelete); journalToDelete = null; }
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    public class Journal
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string country { get; set; } = "";
        public string quartile { get; set; } = "";
        public double? impact_factor { get; set; }
        public string website_url { get; set; } = "";
        public string added_by { get; set; } = "";
    }
}