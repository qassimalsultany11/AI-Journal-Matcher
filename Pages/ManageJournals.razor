@page "/manage-journals"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>إدارة المجلات | AI Journal Matcher</PageTitle>

<style>
    /* ألوان وتصميم عصري */
    :root {
        --primary: #6366F1;
        --primary-hover: #4F46E5;
        --bg-color: #F8FAFC;
        --text-main: #1E293B;
        --text-muted: #64748B;
        --border-color: #E2E8F0;
    }

    .manage-container {
        max-width: 100%;
        margin: 0 auto;
        padding: 25px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
        background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
        padding: 20px;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

        .page-header h2 {
            font-size: 28px;
            font-weight: 800;
            margin: 0;
            background: linear-gradient(90deg, #4F46E5, #9333EA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .btn-add {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
            color: white;
        }

    /* ===== لوحة البحث والفلاتر ===== */
    .search-panel {
        background: white;
        padding: 24px;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        margin-bottom: 20px;
    }

    .search-main-row {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-bar {
        position: relative;
        flex: 1;
        min-width: 300px;
    }

        .search-bar input {
            width: 100%;
            padding: 14px 45px 14px 45px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s ease;
            box-sizing: border-box;
            background: var(--bg-color);
        }

            .search-bar input:focus {
                outline: none;
                border-color: var(--primary);
                background: white;
                box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
            }

        .search-bar .icon-search {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 18px;
            pointer-events: none;
        }

        .search-bar .clear-btn {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: #E2E8F0;
            border: none;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            cursor: pointer;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: all 0.2s;
        }

            .search-bar .clear-btn:hover {
                background: #CBD5E1;
                color: #1E293B;
            }

    .btn-filters-toggle {
        background: white;
        border: 2px solid var(--border-color);
        color: var(--text-muted);
        padding: 14px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

        .btn-filters-toggle:hover, .btn-filters-toggle.active {
            border-color: var(--primary);
            color: var(--primary);
            background: #EEF2FF;
        }

    .filters-count {
        background: #EF4444;
        color: white;
        font-size: 12px;
        font-weight: bold;
        min-width: 22px;
        height: 22px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 6px;
    }

    /* لوحة الفلاتر */
    .filters-panel {
        margin-top: 20px;
        padding: 20px;
        background: #F8FAFC;
        border-radius: 12px;
        border: 1px dashed #CBD5E1;
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .filter-group label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .filter-group label i {
                color: var(--primary);
                font-size: 14px;
            }

        .filter-group input,
        .filter-group select {
            padding: 10px 14px;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            font-size: 14px;
            background: white;
            transition: all 0.2s;
            color: var(--text-main);
            font-family: inherit;
        }

            .filter-group input:focus,
            .filter-group select:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

    .range-inputs {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .range-inputs input {
            flex: 1;
            min-width: 0;
        }

        .range-inputs span {
            color: #94A3B8;
            font-size: 14px;
        }

    /* شرائح الفلاتر النشطة */
    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border-color);
        align-items: center;
    }

    .active-filters-label {
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 700;
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #EEF2FF;
        color: #4338CA;
        border: 1px solid #C7D2FE;
        padding: 6px 8px 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

        .filter-chip button {
            background: #C7D2FE;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4338CA;
            font-size: 10px;
        }

            .filter-chip button:hover {
                background: #A5B4FC;
            }

    .btn-clear-all {
        background: transparent;
        border: 1.5px solid #FECACA;
        color: #DC2626;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        margin-right: auto;
    }

        .btn-clear-all:hover {
            background: #FEF2F2;
        }

    /* شريط النتائج والترتيب */
    .results-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background: white;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
        font-size: 14px;
        color: var(--text-muted);
        font-weight: 600;
    }

    .results-count {
        color: var(--primary);
        font-weight: 800;
        font-size: 16px;
    }

    .sort-select {
        padding: 8px 14px;
        border: 2px solid var(--border-color);
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text-muted);
        background: var(--bg-color);
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .sort-select:focus {
            outline: none;
            border-color: var(--primary);
        }

    /* الجدول */
    .table-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
    }

    th {
        background: #F1F5F9;
        padding: 18px 16px;
        font-size: 13px;
        font-weight: 800;
        color: #475569;
        border-bottom: 2px solid var(--border-color);
        white-space: nowrap;
    }

    td {
        padding: 16px;
        font-size: 14.5px;
        color: var(--text-main);
        border-bottom: 1px solid var(--border-color);
        transition: background 0.2s;
    }

    tr:last-child td {
        border-bottom: none;
    }

    tr:hover td {
        background: #F8FAFC;
    }

    .highlight {
        background: #FEF08A;
        padding: 2px 4px;
        border-radius: 4px;
        font-weight: bold;
        color: #854D0E;
    }

    .badge-q {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
        display: inline-block;
        letter-spacing: 0.5px;
    }

    .q1 {
        background: #DCFCE7;
        color: #166534;
    }

    .q2 {
        background: #DBEAFE;
        color: #1E40AF;
    }

    .q3 {
        background: #FEF3C7;
        color: #92400E;
    }

    .q4 {
        background: #FEE2E2;
        color: #991B1B;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

    .btn-action {
        background: white;
        border: 1px solid var(--border-color);
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: all 0.2s;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    /* تنسيق زر الموقع */
    .btn-visit {
        color: #10B981; /* لون أخضر */
    }

        .btn-visit:hover {
            background: #ECFDF5;
            border-color: #6EE7B7;
            transform: scale(1.05);
        }

    /* تنسيق زر التعديل */
    .btn-edit {
        color: #3B82F6;
    }

        .btn-edit:hover:not(:disabled) {
            background: #EFF6FF;
            border-color: #93C5FD;
            transform: scale(1.05);
        }

        /* عندما يكون الزر معطلاً (لمستخدم آخر) */
        .btn-edit:disabled {
            color: #CBD5E1;
            cursor: not-allowed;
            background: #F8FAFC;
        }

    .btn-delete {
        color: #EF4444;
    }

        .btn-delete:hover {
            background: #FEF2F2;
            border-color: #FCA5A5;
            transform: scale(1.05);
        }

    /* المودال */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        animation: fadeIn 0.2s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 20px;
        width: 90%;
        max-width: 420px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        animation: scaleIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0.9);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-content h3 {
        margin: 0 0 10px 0;
        font-size: 22px;
        color: var(--text-main);
    }

    .modal-content p {
        color: var(--text-muted);
        margin-bottom: 25px;
        font-size: 15px;
        line-height: 1.5;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn-cancel, .btn-confirm {
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.2s;
        flex: 1;
    }

    .btn-cancel {
        background: #F1F5F9;
        color: #475569;
    }

        .btn-cancel:hover {
            background: #E2E8F0;
        }

    .btn-confirm {
        background: #EF4444;
        color: white;
    }

        .btn-confirm:hover {
            background: #DC2626;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #E2E8F0;
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 50px auto;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 768px) {
        .search-main-row {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-filters-toggle {
            justify-content: center;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .results-info {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }
    }
</style>

<div class="manage-container">

    <div class="page-header">
        <div>
            <h2>📚 إدارة المجلات</h2>
            <p style="color: var(--text-muted); margin: 5px 0 0 0; font-size: 15px;">عرض، فلترة، تعديل، وحذف المجلات الأكاديمية</p>
        </div>
        <a href="/add-journal" class="btn-add">
            <i class="bi bi-plus-circle"></i> إضافة مجلة جديدة
        </a>
    </div>

    <!-- لوحة البحث المتقدم -->
    <div class="search-panel">
        <div class="search-main-row">
            <div class="search-bar">
                <i class="bi bi-search icon-search"></i>
                <input type="text" placeholder="ابحث بالاسم، الناشر، الدولة، أو الربع..." @bind="searchTerm" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button class="clear-btn" @onclick="() => searchTerm = string.Empty" title="مسح">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <button class="btn-filters-toggle @(showFilters ? "active" : "")" @onclick="() => showFilters = !showFilters">
                <i class="bi bi-sliders2"></i>
                <span>فلاتر متقدمة</span>
                @if (ActiveFiltersCount > 0)
                {
                    <span class="filters-count">@ActiveFiltersCount</span>
                }
            </button>
        </div>

        <!-- لوحة الفلاتر -->
        @if (showFilters)
        {
            <div class="filters-panel">
                <div class="filters-grid">
                    <div class="filter-group">
                        <label><i class="bi bi-building"></i> الناشر</label>
                        <input type="text" placeholder="مثال: Elsevier..." @bind="filterPublisher" @bind:event="oninput" />
                    </div>

                    <div class="filter-group">
                        <label><i class="bi bi-globe-americas"></i> الدولة</label>
                        <select @bind="filterCountry">
                            <option value="">كل الدول</option>
                            @foreach (var country in AvailableCountries)
                            {
                                <option value="@country">@country</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label><i class="bi bi-bar-chart-steps"></i> الربع (Quartile)</label>
                        <select @bind="filterQuartile">
                            <option value="">الكل</option>
                            <option value="Q1">Q1</option>
                            <option value="Q2">Q2</option>
                            <option value="Q3">Q3</option>
                            <option value="Q4">Q4</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label><i class="bi bi-graph-up-arrow"></i> معامل التأثير</label>
                        <div class="range-inputs">
                            <input type="number" step="0.1" min="0" placeholder="من" @bind="filterImpactMin" />
                            <span>—</span>
                            <input type="number" step="0.1" min="0" placeholder="إلى" @bind="filterImpactMax" />
                        </div>
                    </div>
                </div>

                @if (ActiveFiltersCount > 0)
                {
                    <div class="active-filters">
                        <span class="active-filters-label">الفلاتر النشطة:</span>

                        @if (!string.IsNullOrWhiteSpace(filterPublisher))
                        {
                            <span class="filter-chip">
                                الناشر: @filterPublisher
                                <button @onclick="() => filterPublisher = string.Empty"><i class="bi bi-x"></i></button>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(filterCountry))
                        {
                            <span class="filter-chip">
                                الدولة: @filterCountry
                                <button @onclick="() => filterCountry = string.Empty"><i class="bi bi-x"></i></button>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(filterQuartile))
                        {
                            <span class="filter-chip">
                                الربع: @filterQuartile
                                <button @onclick="() => filterQuartile = string.Empty"><i class="bi bi-x"></i></button>
                            </span>
                        }

                        @if (filterImpactMin.HasValue || filterImpactMax.HasValue)
                        {
                            <span class="filter-chip">
                                معامل التأثير: @(filterImpactMin?.ToString("0.##") ?? "0") — @(filterImpactMax?.ToString("0.##") ?? "∞")
                                <button @onclick="ClearImpactFilter"><i class="bi bi-x"></i></button>
                            </span>
                        }

                        <button class="btn-clear-all" @onclick="ClearAllFilters">
                            <i class="bi bi-trash3"></i> مسح الكل
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <!-- شريط النتائج والترتيب -->
    <div class="results-info">
        <div>
            إجمالي المجلات: <span class="results-count">@FilteredJournals.Count</span>
            @if (FilteredJournals.Count != journals.Count)
            {
                <span style="color: #94A3B8; font-weight: normal; font-size: 13px;"> من أصل @journals.Count</span>
            }
        </div>
        <select class="sort-select" @bind="sortBy" @bind:event="onchange">
            <option value="id-desc">الأحدث أولاً</option>
            <option value="id-asc">الأقدم أولاً</option>
            <option value="name-asc">الاسم (أ - ي)</option>
            <option value="name-desc">الاسم (ي - أ)</option>
            <option value="impact-desc">معامل التأثير (الأعلى)</option>
            <option value="impact-asc">معامل التأثير (الأدنى)</option>
        </select>
    </div>

    <!-- الجدول -->
    <div class="table-container">
        @if (isLoading)
        {
            <div class="spinner"></div>
        }
        else if (FilteredJournals.Count == 0)
        {
            <div style="text-align: center; padding: 60px 20px; color: #94A3B8;">
                <i class="bi bi-journal-x" style="font-size: 60px; display: block; margin-bottom: 20px; opacity: 0.5;"></i>
                <h3 style="color: #475569; margin-bottom: 10px;">لا توجد مجلات لعرضها</h3>
                <p>جرب تغيير كلمات البحث أو إزالة الفلاتر</p>
                @if (ActiveFiltersCount > 0 || !string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button class="btn-clear-all" style="margin-top: 15px; padding: 10px 20px;" @onclick="ResetEverything">
                        <i class="bi bi-arrow-counterclockwise"></i> مسح جميع الفلاتر
                    </button>
                }
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>اسم المجلة</th>
                        <th>الناشر</th>
                        <th>الدولة</th>
                        <th>الربع</th>
                        <th>معامل التأثير</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var journal in FilteredJournals)
                    {
                        <tr>
                            <td style="font-weight: bold; max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@journal.name">
                                @((MarkupString)Highlight(journal.name))
                            </td>
                            <td style="color: var(--text-muted);">@((MarkupString)Highlight(journal.publisher))</td>
                            <td style="color: var(--text-muted);">@((MarkupString)Highlight(journal.country))</td>
                            <td>
                                @{
                                    var qClass = journal.quartile?.ToUpper() switch
                                    {
                                        "Q1" => "q1",
                                        "Q2" => "q2",
                                        "Q3" => "q3",
                                        "Q4" => "q4",
                                        _ => "q4"
                                    };
                                }
                                <span class="badge-q @qClass">@journal.quartile</span>
                            </td>
                            <td style="font-weight: 800; color: #0F172A;">@journal.impact_factor</td>
                            <td>
                                <div class="actions">
                                    <!-- 1. زر زيارة الموقع -->
                                    @if (!string.IsNullOrEmpty(journal.website_url))
                                    {
                                        <a href="@journal.website_url" target="_blank" class="btn-action btn-visit" title="زيارة الموقع">
                                            <i class="bi bi-globe"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn-action btn-visit" disabled title="لا يوجد رابط" style="opacity: 0.3; cursor: not-allowed;">
                                            <i class="bi bi-globe"></i>
                                        </button>
                                    }

                                    <!-- 2. زر التعديل (متاح فقط إذا كان المستخدم هو من أضاف المجلة أو كان أدمن) -->
                                    <button class="btn-action btn-edit"
                                            title="@(CanUserEdit(journal) ? "تعديل" : "لا تملك صلاحية التعديل")"
                                            @onclick="() => EditJournal(journal.id)"
                                            disabled="@(!CanUserEdit(journal))">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- 3. زر الحذف (متاح فقط للأدمن أو صاحب المجلة) -->
                                    <button class="btn-action btn-delete"
                                            @onclick="() => ConfirmDelete(journal)"
                                            title="حذف"
                                            disabled="@(!CanUserEdit(journal))"
                                            style="@(!CanUserEdit(journal) ? "opacity: 0.3; cursor: not-allowed;" : "")">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- نافذة تأكيد الحذف -->
@if (journalToDelete != null)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <i class="bi bi-exclamation-triangle-fill" style="color: #EF4444; font-size: 48px; margin-bottom: 15px; display: block;"></i>
            <h3>تأكيد الحذف</h3>
            <p>هل أنت متأكد من حذف مجلة <strong style="color: var(--text-main);">@journalToDelete.name</strong>؟<br />لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => journalToDelete = null">إلغاء</button>
                <button class="btn-confirm" @onclick="DeleteJournal">نعم، احذف</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showFilters = false;

    private string searchTerm = "";
    private string filterPublisher = "";
    private string filterCountry = "";
    private string filterQuartile = "";
    private double? filterImpactMin = null;
    private double? filterImpactMax = null;
    private string sortBy = "id-desc";

    private List<Journal> journals = new();
    private Journal? journalToDelete = null;

    private List<string> AvailableCountries = new();

    // بيانات المستخدم الحالي
    private string currentUsername = "";
    private string currentUserRole = "researcher";

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    protected override async Task OnInitializedAsync()
    {
        // 1. قراءة بيانات المستخدم من الـ LocalStorage
        await LoadCurrentUser();

        // 2. تحميل المجلات
        await LoadJournalsAsync();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            // نفترض أنك تحفظ اسم المستخدم في LocalStorage عند تسجيل الدخول باسم "username"
            var savedUsername = await JS.InvokeAsync<string>("localStorage.getItem", "username");
            var savedUserRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");

            if (!string.IsNullOrEmpty(savedUsername))
            {
                currentUsername = savedUsername.Trim().ToLower();
            }
            if (!string.IsNullOrEmpty(savedUserRole))
            {
                currentUserRole = savedUserRole.ToLower();
            }
        }
        catch
        {
            // في حال عدم وجود بيانات
        }
    }

    // دالة التحقق من صلاحية التعديل
    private bool CanUserEdit(Journal journal)
    {
        // إذا كان المستخدم مشرف (admin) يسمح له بتعديل الكل
        if (currentUserRole == "admin") return true;

        // إذا كان حقل added_by فارغ، نسمح بالعرض فقط
        if (string.IsNullOrWhiteSpace(journal.added_by)) return false;

        // نقارن اسم المستخدم الحالي مع اسم المستخدم الذي أضاف المجلة
        return journal.added_by.Trim().ToLower() == currentUsername;
    }

    private int ActiveFiltersCount
    {
        get
        {
            int count = 0;
            if (!string.IsNullOrWhiteSpace(filterPublisher)) count++;
            if (!string.IsNullOrWhiteSpace(filterCountry)) count++;
            if (!string.IsNullOrWhiteSpace(filterQuartile)) count++;
            if (filterImpactMin.HasValue || filterImpactMax.HasValue) count++;
            return count;
        }
    }

    private List<Journal> FilteredJournals
    {
        get
        {
            var query = journals.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(j =>
                    (j.name?.ToLower().Contains(term) ?? false) ||
                    (j.publisher?.ToLower().Contains(term) ?? false) ||
                    (j.country?.ToLower().Contains(term) ?? false) ||
                    (j.quartile?.ToLower().Contains(term) ?? false)
                );
            }

            if (!string.IsNullOrWhiteSpace(filterPublisher))
            {
                var p = filterPublisher.Trim().ToLower();
                query = query.Where(j => j.publisher?.ToLower().Contains(p) ?? false);
            }

            if (!string.IsNullOrWhiteSpace(filterCountry))
            {
                var c = filterCountry.Trim().ToLower();
                query = query.Where(j => j.country?.ToLower().Contains(c) ?? false);
            }

            if (!string.IsNullOrWhiteSpace(filterQuartile))
            {
                query = query.Where(j => string.Equals(j.quartile, filterQuartile, StringComparison.OrdinalIgnoreCase));
            }

            if (filterImpactMin.HasValue)
                query = query.Where(j => j.impact_factor.HasValue && j.impact_factor.Value >= filterImpactMin.Value);
            if (filterImpactMax.HasValue)
                query = query.Where(j => j.impact_factor.HasValue && j.impact_factor.Value <= filterImpactMax.Value);

            query = sortBy switch
            {
                "id-asc" => query.OrderBy(j => j.id),
                "id-desc" => query.OrderByDescending(j => j.id),
                "name-asc" => query.OrderBy(j => j.name),
                "name-desc" => query.OrderByDescending(j => j.name),
                "impact-asc" => query.OrderBy(j => j.impact_factor ?? double.MinValue),
                "impact-desc" => query.OrderByDescending(j => j.impact_factor ?? double.MinValue),
                _ => query.OrderByDescending(j => j.id)
            };

            return query.ToList();
        }
    }

    private async Task LoadJournalsAsync()
    {
        isLoading = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/journals?select=*&order=id.desc");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                journals = JsonSerializer.Deserialize<List<Journal>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

                AvailableCountries = journals
                    .Select(j => j.country)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading journals: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditJournal(long id)
    {
        Nav.NavigateTo($"/add-journal?id={id}");
    }

    private void ClearImpactFilter()
    {
        filterImpactMin = null;
        filterImpactMax = null;
    }

    private void ClearAllFilters()
    {
        filterPublisher = "";
        filterCountry = "";
        filterQuartile = "";
        filterImpactMin = null;
        filterImpactMax = null;
    }

    private void ResetEverything()
    {
        searchTerm = "";
        ClearAllFilters();
    }

    private string Highlight(string? text)
    {
        if (string.IsNullOrEmpty(text)) return text ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm)) return System.Net.WebUtility.HtmlEncode(text);

        var term = searchTerm.Trim();
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var encodedTerm = System.Net.WebUtility.HtmlEncode(term);

        var index = encoded.IndexOf(encodedTerm, StringComparison.OrdinalIgnoreCase);
        if (index < 0) return encoded;

        return encoded.Substring(0, index) +
               "<span class=\"highlight\">" +
               encoded.Substring(index, encodedTerm.Length) +
               "</span>" +
               encoded.Substring(index + encodedTerm.Length);
    }

    private void ConfirmDelete(Journal journal)
    {
        journalToDelete = journal;
    }

    private async Task DeleteJournal()
    {
        if (journalToDelete == null) return;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"{supabaseUrl}/rest/v1/journals?id=eq.{journalToDelete.id}");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                journals.Remove(journalToDelete);
                AvailableCountries = journals
                    .Select(j => j.country)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();

                journalToDelete = null;
            }
            else
            {
                Console.WriteLine($"فشل الحذف: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting: {ex.Message}");
        }
    }

    public class Journal
    {
        public long id { get; set; }
        public string name { get; set; } = "";
        public string publisher { get; set; } = "";
        public string country { get; set; } = "";
        public string quartile { get; set; } = "";
        public double? impact_factor { get; set; }
        public string website_url { get; set; } = "";
        public string added_by { get; set; } = ""; // الحقل الخاص بمن أضاف المجلة
    }
}