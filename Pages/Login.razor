@page "/login"

@attribute [AllowAnonymous]
@using System.Text.Json
@using System.Text
@using System.Security.Cryptography
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@using AIJOURNALMATCHERWEB.Services

<PageTitle>تسجيل الدخول | AI Journal Matcher</PageTitle>

<style>
    /* نفس تنسيقاتك الجميلة */
    .login-page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-header {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%);
        padding: 30px 20px;
        text-align: center;
        color: white;
        position: relative;
    }

    .login-header-icon {
        width: 68px;
        height: 68px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 15px;
        font-size: 30px;
    }

    .login-header h2 {
        margin: 0 0 5px 0;
        font-size: 22px;
        font-weight: bold;
    }

    .login-header p {
        margin: 0;
        font-size: 12px;
        color: #E0E7FF;
    }

    .login-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
        position: relative;
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .form-control {
        width: 100%;
        height: 42px;
        padding: 0 40px;
        font-size: 13px;
        color: #2C3E50;
        background: #F8FAFC;
        border: 1.5px solid #E0E6ED;
        border-radius: 8px;
        transition: all 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366F1;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #94A3B8;
        font-size: 14px;
        pointer-events: none;
    }

    .btn-toggle-pass {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        color: #94A3B8;
        cursor: pointer;
        font-size: 14px;
        padding: 5px;
    }

        .btn-toggle-pass:hover {
            color: #6366F1;
        }

    .options-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        font-size: 12px;
    }

    .forgot-link {
        color: #6366F1;
        text-decoration: none;
        font-weight: 600;
    }

        .forgot-link:hover {
            text-decoration: underline;
        }

    .btn-primary {
        width: 100%;
        height: 46px;
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-primary:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .alert-error {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
        padding: 10px;
        border-radius: 8px;
        font-size: 12px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .register-link-container {
        text-align: center;
        margin-top: 20px;
        font-size: 13px;
        color: #64748B;
        border-top: 1px solid #E2E8F0;
        padding-top: 20px;
    }

    .register-link {
        color: #6366F1;
        font-weight: bold;
        text-decoration: none;
    }

        .register-link:hover {
            text-decoration: underline;
        }
</style>

<div class="login-page-wrapper">
    <div class="login-card">
        <div class="login-header">
            <div class="login-header-icon"><i class="bi bi-person"></i></div>
            <h2>مرحباً بعودتك</h2>
            <p>تسجيل الدخول إلى AI Journal Matcher</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @errorMessage
                </div>
            }

            <div class="form-group">
                <label class="form-label">البريد الإلكتروني أو اسم المستخدم</label>
                <div class="input-wrapper">
                    <i class="bi bi-person input-icon"></i>
                    <input type="text" class="form-control" @bind="email" placeholder="أدخل بريدك الإلكتروني" @onkeydown="HandleKeyDown" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock input-icon"></i>
                    <input type="@(showPassword ? "text" : "password")" class="form-control" @bind="password" placeholder="أدخل كلمة المرور" @onkeydown="HandleKeyDown" />
                    <button type="button" class="btn-toggle-pass" @onclick="() => showPassword = !showPassword">
                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>

            <div class="options-row">
                <a href="/forgot-password" class="forgot-link">هل نسيت كلمة المرور؟</a>
            </div>

            <button class="btn-primary" @onclick="HandleLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>جاري تسجيل الدخول...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>تسجيل الدخول</span>
                }
            </button>

            <div class="register-link-container">
                ليس لديك حساب؟ <a href="/register" class="register-link">إنشاء حساب جديد</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;

    [Inject]
    private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private string supabaseUrl = "https://dayowfmmqtoyewjgnptf.supabase.co";
    private string supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRheW93Zm1tcXRveWV3amducHRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwMTI4MTcsImV4cCI6MjEwNjU4ODgxN30.IcR-HI9AZOdsWyg93PURcm3riWzqzd7r0v69P0pzNTc";

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            // 1. البحث عن المستخدم
            var request = new HttpRequestMessage(HttpMethod.Get, $"{supabaseUrl}/rest/v1/users?or=(email.eq.{Uri.EscapeDataString(email)},username.eq.{Uri.EscapeDataString(email)})&select=*");
            request.Headers.Add("apikey", supabaseKey);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var users = JsonSerializer.Deserialize<List<UserProfile>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (users != null && users.Count > 0)
                {
                    var user = users[0];

                    // 2. التحقق من كلمة المرور أولاً (حماية أمنية)
                    bool isPasswordValid = VerifyPassword(password, user.password_hash);

                    if (isPasswordValid)
                    {
                        // 3. التحقق من الإيقاف (إذا كان الحساب موقوف يدوياً)
                        if (user.is_suspended)
                        {
                            errorMessage = "عذراً، تم إيقاف حسابك من قبل إدارة النظام. يرجى التواصل مع الدعم.";
                            isLoading = false;
                            return;
                        }

                        // 4. التحقق من حالة الموافقة
                        if (user.role == "admin" && user.is_approved == false)
                        {
                            errorMessage = "حسابك كمدير نظام قيد المراجعة من قبل الإدارة. يرجى الانتظار حتى يتم تفعيل حسابك.";
                            isLoading = false;
                            return;
                        }

                        if (user.is_approved == false && user.role != "admin")
                        {
                            errorMessage = "حسابك موقوف حالياً. يرجى التواصل مع إدارة النظام.";
                            isLoading = false;
                            return;
                        }

                        // 5. التحقق من تاريخ انتهاء الصلاحية (valid_until) - التحديث الجديد
                        if (user.valid_until.HasValue && user.valid_until.Value.ToUniversalTime() < DateTime.UtcNow)
                        {
                            // إذا انتهت الصلاحية، نوقف الحساب تلقائياً
                            await UpdateUserStatus(user.id, false);
                            errorMessage = "عذراً، انتهت صلاحية حسابك. يرجى التواصل مع الإدارة لتمديد الصلاحية.";
                            isLoading = false;
                            return;
                        }

                        // ملاحظة: تم إلغاء شرط "آخر دخول 60 يوم" لأننا نعتمد الآن على valid_until

                        // 6. تحديث تاريخ آخر دخول (last_login)
                        await UpdateLastLogin(user.id);

                        // 7. حفظ البيانات في LocalStorage
                        await JS.InvokeVoidAsync("localStorage.setItem", "authToken", "logged_in");
                        await JS.InvokeVoidAsync("localStorage.setItem", "username", user.username);
                        await JS.InvokeVoidAsync("localStorage.setItem", "userRole", user.role ?? "researcher");
                        await JS.InvokeVoidAsync("localStorage.setItem", "userId", user.id.ToString());
                        await JS.InvokeVoidAsync("localStorage.setItem", "fullName", user.full_name ?? user.username);

                        // 8. إبلاغ النظام
                        if (AuthProvider is CustomAuthenticationStateProvider customProvider)
                        {
                            customProvider.MarkUserAsAuthenticated(user.email);
                        }

                        // 9. تحويله للوحة التحكم
                        Nav.NavigateTo("/");
                    }
                    else
                    {
                        errorMessage = "كلمة المرور غير صحيحة.";
                    }
                }
                else
                {
                    errorMessage = "البريد الإلكتروني أو اسم المستخدم غير مسجل.";
                }
            }
            else
            {
                errorMessage = "حدث خطأ أثناء الاتصال بقاعدة البيانات.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // دالة لتحديث تاريخ آخر دخول
    private async Task UpdateLastLogin(long userId)
    {
        var payload = new { last_login = DateTime.UtcNow };
        var json = JsonSerializer.Serialize(payload);
        var content = new StringContent(json, Encoding.UTF8, "application/json");
        var request = new HttpRequestMessage(HttpMethod.Patch, $"{supabaseUrl}/rest/v1/users?id=eq.{userId}");
        request.Headers.Add("apikey", supabaseKey);
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
        request.Content = content;
        await Http.SendAsync(request);
    }

    // دالة لتحديث حالة المستخدم (تفعيل/تعطيل)
    private async Task UpdateUserStatus(long userId, bool isApproved)
    {
        var payload = new { is_approved = isApproved };
        var json = JsonSerializer.Serialize(payload);
        var content = new StringContent(json, Encoding.UTF8, "application/json");
        var request = new HttpRequestMessage(HttpMethod.Patch, $"{supabaseUrl}/rest/v1/users?id=eq.{userId}");
        request.Headers.Add("apikey", supabaseKey);
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", supabaseKey);
        request.Content = content;
        await Http.SendAsync(request);
    }

    // دالة للتحقق من كلمة المرور
    private bool VerifyPassword(string enteredPassword, string storedHash)
    {
        using (var sha256 = SHA256.Create())
        {
            var hashedBytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(enteredPassword));
            var hashString = Convert.ToBase64String(hashedBytes);
            return hashString == storedHash;
        }
    }

    public class UserProfile
    {
        public long id { get; set; }
        public string username { get; set; } = "";
        public string email { get; set; } = "";
        public string password_hash { get; set; } = "";
        public string full_name { get; set; } = "";
        public string role { get; set; } = "researcher";
        public bool is_approved { get; set; }
        public bool is_suspended { get; set; }
        public DateTime? last_login { get; set; }
        public DateTime? valid_until { get; set; } // <--- الحقل الجديد
    }
}